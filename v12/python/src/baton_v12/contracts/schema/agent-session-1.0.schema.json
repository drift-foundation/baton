    "sessionRecord": {
      "type": "object",
      "properties": {
        "session_family": {
          "$ref": "#/$defs/sessionFamily"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "document": {
          "const": "session"
        },
