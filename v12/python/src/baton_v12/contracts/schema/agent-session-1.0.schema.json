    "contentBlock": {
      "type": "object",
      "description": "Version 1.0 normalizes text and resource links only. Image, audio and embedded resource bytes are counted and dropped, never inlined.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "$ref": "#/$defs/boundedText"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "resource_link"
            },
            "uri": {
              "type": "string",
              "minLength": 3,
              "maxLength": 2048,
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^?#]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "type",
            "uri",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "dropped"
            },
            "dropped_type": {
              "enum": [
                "image",
                "audio",
                "resource",
                "unknown"
              ]
            },
            "byte_count": {
              "$ref": "#/$defs/nonNegativeInt"
            }
          },
          "required": [
            "type",
            "dropped_type",
            "byte_count"
          ],
          "additionalProperties": false
        }
      ]
    },
    "toolCallView": {
      "type": "object",
      "properties": {
        "tool_call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "title": {
          "$ref": "#/$defs/boundedText"
        },
        "kind": {
          "$ref": "#/$defs/toolKind"
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "failed"
          ]
        }
      },
      "required": [
        "tool_call_id",
        "status"
      ],
      "additionalProperties": false,
      "description": "The portable view of one provider tool call. W543 correction 2026-08-23: `kind` is optional advisory evidence copied verbatim when the provider supplies one of the pinned ACP 1.3 ToolKind values, and OMITTED when it does not. Baton never infers one. It may support presentation and it decides no permission, policy, tool authority, turn outcome or disposition."
    },
    "toolKind": {
      "description": "The pinned ACP 1.3 ToolKind vocabulary, verbatim. A value outside it refuses rather than silently widening the frozen contract; a later ACP vocabulary needs explicit version/certification work.",
      "enum": [
        "read",
        "edit",
        "delete",
        "move",
        "search",
        "execute",
        "think",
        "fetch",
        "switch_mode",
        "other"
      ]
    },
    "normalizedEvent": {
      "type": "object",
      "properties": {
        "session_family": {
          "$ref": "#/$defs/sessionFamily"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "document": {
          "const": "event"
        },
        "agent_session_ref": {
          "$ref": "#/$defs/agentSessionRef"
        },
        "source_seq": {
          "$ref": "#/$defs/positiveInt"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "turn_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/opaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/eventKind"
        },
        "source_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "description": "The provider's own update or item kind, retained verbatim as diagnostics so an unmapped kind is counted rather than guessed at."
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "tool_call": {
          "oneOf": [
            {
              "$ref": "#/$defs/toolCallView"
            },
            {
              "type": "null"
            }
          ]
        },
        "byte_count": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "redacted": {
          "const": true
        },
        "adapter_diagnostics": {
          "$ref": "#/$defs/namespacedDiagnostics"
        },
        "document_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "session_family",
        "version",
        "document",
        "agent_session_ref",
        "source_seq",
        "observed_at",
        "turn_id",
        "kind",
        "source_kind",
        "content",
        "tool_call",
        "byte_count",
        "redacted",
        "adapter_diagnostics",
        "document_digest"
      ],
      "additionalProperties": false,
      "description": "The frame the relay sealed. Lateness and the manager's observation sequence are properties of an OBSERVATION rather than of the frame, so they are reported beside the document and never folded into its bytes: a retransmitted frame is the same frame, and sealing an observation into it would make an ordinary retransmission look like a spliced stream."
    },
