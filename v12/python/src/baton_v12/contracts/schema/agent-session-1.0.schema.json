          "$ref": "#/$defs/agentSessionRef"
        },
        "posture": {
          "$ref": "#/$defs/posture"
        },
        "profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "work_ref": {
          "$ref": "#/$defs/workRef"
        },
        "assignment_ref": {
          "description": "Exactly null for a consent session, which exists before any claim, and exactly an assignment for an execution session. The conditionals below enforce that; the cross-field rule that this assignment's work_ref equals the session's work_ref is a required SEMANTIC check because JSON Schema cannot express it.",
          "oneOf": [
            {
              "$ref": "#/$defs/assignmentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "negotiated_wire_version": {
          "oneOf": [
            {
              "$ref": "#/$defs/positiveInt"
            },
            {
              "type": "null"
            }
          ]
        },
        "advertised_client_capabilities": {
          "oneOf": [
            {
              "$ref": "#/$defs/clientCapabilities"
            },
            {
              "type": "null"
            }
          ]
        },
        "negotiated_session_capabilities": {
          "const": [
            "session.cancel",
            "session.fresh",
            "session.mode-pin",
            "session.permission-refusal",
            "session.prompt",
            "session.update-normalization"
          ]
        },
        "pinned_policy": {
          "$ref": "#/$defs/posturePolicyPinned"
        },
        "observed_policy": {
          "oneOf": [
            {
              "$ref": "#/$defs/posturePolicyObserved"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/sessionState"
        },
        "state_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stateObservation"
          }
        },
        "cancellation": {
          "oneOf": [
            {
              "$ref": "#/$defs/cancellationRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaqueId"
          }
        },
        "journal": {
          "$ref": "#/$defs/evidenceRef"
        },
        "adapter_diagnostics": {
          "$ref": "#/$defs/namespacedDiagnostics"
        },
        "document_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "session_family",
        "version",
        "document",
        "record_id",
        "created_at",
        "agent_session_ref",
        "posture",
        "profile_digest",
        "work_ref",
        "assignment_ref",
        "negotiated_wire_version",
        "advertised_client_capabilities",
        "negotiated_session_capabilities",
        "pinned_policy",
        "observed_policy",
        "state",
        "state_history",
        "cancellation",
        "turn_ids",
        "journal",
        "adapter_diagnostics",
        "document_digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "posture": {
                "const": "consent"
              }
            },
            "required": [
              "posture"
            ]
          },
          "then": {
            "properties": {
              "assignment_ref": {
                "type": "null"
              },
              "agent_session_ref": {
                "properties": {
                  "posture": {
                    "const": "consent"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "posture": {
                "const": "execution"
              }
            },
            "required": [
              "posture"
            ]
          },
          "then": {
            "properties": {
              "assignment_ref": {
                "$ref": "#/$defs/assignmentRef"
              },
              "agent_session_ref": {
                "properties": {
                  "posture": {
                    "const": "execution"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "terminalFact": {
