set shell := ["bash", "-lc"]
set quiet

PY := "python3"

# The wheelhouse variable this file used to carry is gone.
#
# PLAN item 4bp, approved: dependency distributions do not belong in Git. The
# repository carries `pyproject.toml`, the exact hash-locked `requirements.lock`,
# source, tests and package data -- and no downloaded wheels, including the
# platform-specific `rpds-py` one. A normal checkout builds its own disposable
# environment and downloads exactly the locked artifacts from its configured
# package index, WITH THE HASHES STILL ENFORCED.
#
# What the lock guarantees is unchanged: the same five distributions at the same
# versions with the same SHA-256s. What changed is where the bytes come from. An
# operator-maintained cache, certified bundle or offline mirror may supply the
# same artifacts as deployment infrastructure, but that is outside the source
# tree and is not the fresh-checkout contract.

# THE gate for the v12 Python distribution: the interpreter it claims, the
# standard library's own test runner over the source tree, and then the locked
# build proving the distribution actually installs and passes from the
# installed layout.
default: gate

gate: version test build

# The distribution declares `requires-python = ">=3.13"`. A gate that ran on an
# older interpreter would prove the wrong thing quietly, so it refuses.
version:
    #!/usr/bin/env bash
    set -euo pipefail
    "{{PY}}" - <<'PY'
    import sys
    if sys.version_info < (3, 13):
        raise SystemExit(f"v12 requires Python 3.13 or newer; this is {sys.version.split()[0]}")
    print(f"[gate] python {sys.version.split()[0]}")
    PY

test:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(dirname "{{justfile()}}")"
    # WHICH VALIDATOR THIS STAGE ACTUALLY RESOLVED, said out loud.
    #
    # Found while implementing item 4bp: this stage runs against whatever
    # `jsonschema` the ambient interpreter has, which on the machine I develop on
    # is 4.19.2 while the lock pins 4.26.0 -- so a green source run proved the
    # code works with a version this distribution does not pin, and it had been
    # doing that quietly for two rounds. The LOCKED stage is what proves the pin;
    # this line is what stops a green source run from looking like it did.
    PYTHONPATH=src "{{PY}}" -c "
    import importlib.metadata as metadata
    try:
        print(f'[test] resolved jsonschema {metadata.version(\"jsonschema\")}')
    except Exception:
        print('[test] no jsonschema resolved; validation cases will fail')
    " || true
    PYTHONPATH=src "{{PY}}" -m unittest discover -s tests -t . -v

# The locked build, CONSUMED rather than described.
#
# Review [P2]: `requirements.lock` was checked by a test that looked at its
# TEXT, and nothing ever used it. A lock nobody resolves from is a document
# about a build rather than a property of one, and "hash-enforced" was a claim
# with no mechanism behind it.
#
# So this RESOLVES the lock with `--require-hashes`, and with
# `--ignore-installed` so every pin is actually fetched and verified rather than
# skipped as already-satisfied. The artifacts come from the configured package
# index (item 4bp); `--require-hashes` is what makes that a locked build rather
# than a resolution, because pip refuses any bytes whose SHA-256 is not the one
# this distribution pins, wherever they were found.
#
# It then builds and installs THIS distribution with `--no-build-isolation`, so
# the build reaches for exactly the pinned `setuptools` already installed above
# rather than resolving its own unpinned copy -- and finally runs the whole suite
# against the INSTALLED layout from outside the source tree, so a packaging
# mistake cannot hide behind `PYTHONPATH=src`.
#
# IT FAILS RATHER THAN SKIPS. `set -euo pipefail` means an index that cannot be
# reached, a hash that does not match, or a suite that does not pass stops the
# gate. A gate that quietly passes because it could not run is the failure mode
# this whole distribution is built against -- and an unreachable index is now one
# of the ways it cannot run, which is a deployment concern rather than a licence
# to skip.
#
# The superseded text this replaces said the lock resolved OFFLINE, that build
# isolation would reach the network contrary to the lock, and that the gate
# refuses when the wheelhouse is absent. All three described the mechanism item
# 4bp removed.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(dirname "{{justfile()}}")"
    ENV="$(mktemp -d)/env"
    trap 'rm -rf "$(dirname "$ENV")"' EXIT
    "{{PY}}" -m venv "$ENV"
    # DISPOSABLE, and hash-verified. `--require-hashes` is what makes this a
    # locked build rather than a resolution: pip refuses any artifact whose
    # SHA-256 is not the one this file pins, wherever the index found it.
    "$ENV/bin/pip" install --no-cache-dir --disable-pip-version-check \
        --require-hashes --ignore-installed -r requirements.lock
    "$ENV/bin/pip" install --no-index --no-cache-dir --disable-pip-version-check \
        --no-build-isolation .
    # From OUTSIDE the source tree, so `src/` cannot be what is really imported.
    (cd / && "$ENV/bin/python" -c "
    import baton_v12.authority as authority
    import baton_v12.contracts as contracts
    import pathlib
    # BOTH slices, because the distribution now carries two. An origin check
    # that named one of them would report a green import while the other came
    # from wherever it liked.
    for name, package in (('authority', authority), ('contracts', contracts)):
        here = pathlib.Path(package.__file__).resolve()
        assert 'site-packages' in here.parts, here
        print(f'[build] imported the INSTALLED {name} from {here.parent}')
        print(f'[build] {len(package.__all__)} exported names in {name}')
    # And the frozen schema assets have to have TRAVELLED, not merely been
    # importable: package data that never entered the wheel would fail here
    # rather than in a source-tree run that reads them from the checkout.
    schema = pathlib.Path(contracts.__file__).resolve().parent / 'schema'
    assets = sorted(path.name for path in schema.glob('*.json'))
    assert assets == ['agent-session-1.0.schema.json',
                      'worker-control-1.0.schema.json'], assets
    print(f'[build] the frozen schema assets travelled: {len(assets)}')
    ")
    PYTHONPATH= "$ENV/bin/python" -m unittest discover -s tests -t . 2>&1 | tail -3
    echo "[build] the locked build installs, imports and passes"

# There is deliberately no separate `imports` recipe. The dependency claims are
# CHECKED, not restated, and there are now two of them because the distribution
# ships two slices: `tests/authority/test_boundary.py` parses the AUTHORITY
# package and refuses any import outside the standard library, and
# `tests/manager/test_dependencies.py` holds the Worker Manager to the one ruled
# validator, reached from exactly one module, with the lock and the environment
# it produces proved to agree. One mechanism each, inside the gate, rather than a second one
# beside it that can drift.
#
# This paragraph used to say the runtime dependency set was empty. It stopped
# being empty when the validator was ruled, and a comment that restates a
# superseded state is exactly the drift the paragraph warns about.

# W9707 — THE SAME PROOF, ACROSS THE HOST'S CPUs.
#
# `work/records/2026/08/finding-v12-parallel-test-runner/`.
#
# The `test` stage above runs one `unittest` process over the whole tree. That
# measured 423.54s elapsed against 422.65s user on the 16-core/32-CPU
# development host: one CPU, all of it, while thirty-one idled.
#
# THESE RECIPES DO NOT REPLACE `gate`, AND THAT IS DELIBERATE. `gate` stays the
# canonical, reviewed proof until parity and cleanup have been independently
# signed off; replacing it is a separate recorded decision, not a side effect of
# adding a faster way to run the same tests. Two entry points that disagree
# would be worse than a slow one, so the runner's registry completeness case
# fails the moment a v12 test module belongs to neither of its phases.
#
# `tools/parallel_test.py` owns the split: pure shards concurrently, then the
# explicit serial registry — the worker image gate and the real-engine gate —
# one at a time, never beside the parallel phase.
# Run source tests safely across the host's available CPUs.
parallel-test JOBS='':
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(dirname "{{justfile()}}")"
    # An empty JOBS means "every available CPU". The override may only LOWER
    # that, and the runner refuses anything that is not a whole number within
    # the host's count rather than clamping it quietly.
    if [[ -n "{{JOBS}}" ]]; then
        "{{PY}}" tools/parallel_test.py --jobs "{{JOBS}}"
    else
        "{{PY}}" tools/parallel_test.py
    fi

# The complete parallel gate, in the SAME ORDER `gate` uses and with the same
# fail-fast: the interpreter it claims, then the source phases, then the locked
# build that proves the distribution installs and passes from site-packages.
#
# `just parallel-gate 8` is the documented way to lower the worker count.
# Run the complete parallel source and locked installed-layout gate.
parallel-gate JOBS='': version
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(dirname "{{justfile()}}")"
    "{{just_executable()}}" --justfile "{{justfile()}}" parallel-test "{{JOBS}}"
    "{{just_executable()}}" --justfile "{{justfile()}}" build
    # Named phases rather than one word, because "it passed" hides WHICH proof
    # ran. The source lines come from the runner's own summary above; this line
    # is what records that the installed-layout replay ran too, since `build`
    # reports its own tail and `set -e` means nothing reaches here otherwise.
    echo "[parallel-gate] version, parallel source, serial source and the locked installed layout all ran"

# -- W384870: the supported test entries ------------------------------------
#
# THREE ENTRIES, ONE RUNNER. `test-all` is the full supported run and the only
# one whose clean result is acceptance evidence; `test-group` runs one logical
# group of `tools/parallel_test.py`'s exact partition; `test-one` runs named
# unittest ids. All three use the PREPARED interpreter (`just setup`), never
# the ambient one, so the validator that ran is the one the lock pins.
#
# Accounting is exact in `test-all` and `test-group`: the runner collects every
# id the selected registries declare, executes each exactly once, and reports
# `passed + optional skipped = collected` with zero failures, errors, duplicates
# or unaccounted ids. A skip outside the runner's OPTIONAL_SKIPS registry is a
# required proof that did not run, and fails.

# Run exactly one logical test group with exact test-identity accounting.
test-group GROUP JOBS='':
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(dirname "{{justfile()}}")"
    PREPARED="$(python3 -m tools.environment interpreter)"
    ARGS=(--group "{{GROUP}}" --account --keep-going)
    case "{{GROUP}}" in
        tools-packaged) export BATON_V12_STACK_PACKAGING_REQUIRED=1 ;;
        supervised) ARGS+=(--with-supervised) ;;
    esac
    if [[ -n "{{JOBS}}" ]]; then ARGS+=(--jobs "{{JOBS}}"); fi
    exec "$PREPARED" tools/parallel_test.py "${ARGS[@]}"

# Run named unittest ids (package.module[.Class[.method]]) on the prepared interpreter.
test-one +IDS:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(dirname "{{justfile()}}")"
    PREPARED="$(python3 -m tools.environment interpreter)"
    PYTHONPATH=src exec "$PREPARED" -m unittest -v {{IDS}}

# THE full supported run, with a retained log. LOG is an absolute path outside
# /tmp; the JSON ledger lands beside it as LOG-with-.summary.json and the
# supervised run directories beside it too. The log header records the exact
# source identity (HEAD, dirty-path count and digest), interpreter, validator,
# daemon, uid, CPU count, user-namespace capability and the selected image.
# A fresh bundle is built first unless BATON_V12_STACK_DISTRO names one, and
# the packaged cases are REQUIRED. The supervised deadline gate needs
# BATON_W32577_IMAGE_DIGEST, the reviewed preloaded reference-worker image.
test-all LOG JOBS='':
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(dirname "{{justfile()}}")"
    LOG="{{LOG}}"
    case "$LOG" in
        /tmp/*) echo "error: LOG under /tmp is not retained; name a path on real storage" >&2; exit 1 ;;
        /*) ;;
        *) echo "error: LOG must be an absolute path" >&2; exit 1 ;;
    esac
    : "${BATON_W32577_IMAGE_DIGEST:?set BATON_W32577_IMAGE_DIGEST to the reviewed preloaded reference-worker image digest (sha256:...)}"
    mkdir -p "$(dirname "$LOG")"
    PREPARED="$(python3 -m tools.environment interpreter)"
    export BATON_V12_STACK_PACKAGING_REQUIRED=1
    {
        echo "[test-all] started $(date -u +%FT%TZ)"
        # The identity REFUSES (exit 2) when a declared consumed input is absent,
        # and that ends this recipe before anything runs: a run that cannot
        # find what it would consume cannot name the candidate it tested.
        "$PREPARED" -m tools.source_identity --repo "$(git rev-parse --show-toplevel)" --declared v12 > "${LOG%.log}.source.json"
        echo "[test-all] source HEAD $("$PREPARED" -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["head"])' "${LOG%.log}.source.json") changed-files $("$PREPARED" -c 'import json,sys; print(json.load(open(sys.argv[1]))["changed_count"])' "${LOG%.log}.source.json") consumed-input-files $("$PREPARED" -c 'import json,sys; print(json.load(open(sys.argv[1]))["consumed_count"])' "${LOG%.log}.source.json") content-digest $("$PREPARED" -c 'import json,sys; print(json.load(open(sys.argv[1]))["content_digest"])' "${LOG%.log}.source.json") scope v12 + declared inputs (HEAD + sha256 of every modified/untracked file under v12 + sha256 of every file of each consumed input tools.parallel_test declares; gitignored and other out-of-scope paths excluded; per-file lists in the .source.json beside this log)"
        echo "[test-all] python $("$PREPARED" -c 'import sys; print(sys.version.split()[0])') jsonschema $("$PREPARED" -c 'import importlib.metadata as m; print(m.version("jsonschema"))') docker $(docker version 2>/dev/null | awk '/Server:/{s=1} s && /Version:/{print $2; exit}') uid $(id -u) cpus $(nproc) userns $(unshare -rm true 2>/dev/null && echo yes || echo no) tmpfs-tmp $(findmnt -no FSTYPE /tmp 2>/dev/null || echo unknown)"
        echo "[test-all] image $BATON_W32577_IMAGE_DIGEST distro ${BATON_V12_STACK_DISTRO:-(fresh build)}"
    } | tee "$LOG"
    if [[ -z "${BATON_V12_STACK_DISTRO:-}" ]]; then
        echo "[test-all] building a fresh bundle" | tee -a "$LOG"
        "{{just_executable()}}" --justfile "$(dirname "{{justfile()}}")/../justfile" build 2>&1 | tail -n 5 | tee -a "$LOG"
    fi
    ARGS=(--phase all --with-supervised --account --keep-going --summary "${LOG%.log}.summary.json" --retain "$(dirname "$LOG")")
    if [[ -n "{{JOBS}}" ]]; then ARGS+=(--jobs "{{JOBS}}"); fi
    set +e
    "$PREPARED" tools/parallel_test.py "${ARGS[@]}" 2>&1 | tee -a "$LOG"
    CODE=${PIPESTATUS[0]}
    # DRIFT IS VISIBLE: the identity is taken again after the run; if the tested
    # bytes changed under the run, the evidence names it and the run fails.
    if ! "$PREPARED" -m tools.source_identity --repo "$(git rev-parse --show-toplevel)" --declared v12 > "${LOG%.log}.source-after.json"; then
        echo "[test-all] SOURCE IDENTITY REFUSED after the run (a declared consumed input is no longer present); this run does not identify one candidate" | tee -a "$LOG"
        CODE=1
    else
        BEFORE=$("$PREPARED" -c 'import json,sys; print(json.load(open(sys.argv[1]))["content_digest"])' "${LOG%.log}.source.json")
        AFTER=$("$PREPARED" -c 'import json,sys; print(json.load(open(sys.argv[1]))["content_digest"])' "${LOG%.log}.source-after.json")
        if [[ "$BEFORE" != "$AFTER" ]]; then
            echo "[test-all] SOURCE DRIFT during the run: content-digest $BEFORE -> $AFTER; compare the two .source*.json files; this run does not identify one candidate" | tee -a "$LOG"
            CODE=1
        else
            echo "[test-all] source unchanged during the run (content-digest $AFTER)" | tee -a "$LOG"
        fi
    fi
    echo "[test-all] finished $(date -u +%FT%TZ) exit $CODE" | tee -a "$LOG"
    exit "$CODE"
