+def _environment(term=None):
+    held = {"PATH": "/usr/bin:/bin", "PYTHONPATH": "src:.", "PYTHONDONTWRITEBYTECODE": "1", "LANG": "C.UTF-8"}
+    if term:
+        held["TERM"] = term
+    return held
