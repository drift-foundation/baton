+            sorted({held["WORKER_DEFAULT_BOUND"], held["JOB_SELECTED_BOUND"],
+                    held["JOB_DEFAULT_BOUND"], held["UNSTATED_BOUND_SOURCE"]}))
+
+    def test_the_RESULT_GENERATIONS_and_the_DOCUMENT_NAME_are_their_owners(self):
