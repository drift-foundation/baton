+        owned = set(held["PROVIDER_FAILURE_REASONS"].values())
+        owned.update({held["PROVIDER_TIMED_OUT"],
+                      held["PROVIDER_START_ERROR"], held["UNCLASSIFIED"]})
+        self.assertEqual(sorted(failure_cause.DECLARED_FAILURE_REASONS),
+                         sorted(owned))
+
