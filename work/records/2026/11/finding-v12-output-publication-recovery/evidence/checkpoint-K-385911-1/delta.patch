+        self.read()
+        other = "attempt-" + "9" * 64
+        self.control._connection.execute(
+            "INSERT INTO attempts (runtime_attempt_id, adapter_name, "
+            "adapter_digest, profile_digest, created_at) VALUES (?, 'a', "
