+# -- 1. the seam a deployment composes ---------------------------------------
+#
+# SEVEN MEMBERS, each one an OWNER rather than a convenience, and the module
+# decides with all of them and holds none of them itself.
+#
+#   control    the Worker Manager's control store: where the attempt, its
+#              workspace preparation, its frozen result and its intake
+#              receipt live. Read and written only through that package's own
+#              public operations.
+#   host       the owner of the ORIGINAL output -- the trust root door. The
+#              ONLY way to the original bytes; a path is never an operand.
+#   exclusion  the host's cessation evidence about an attempt. `unknown` holds.
+#   workspaces the private root recovery-owned staging is allocated under. A
+#              sibling of the stores and never a child of custody: a writable
+#              tree inside immutable evidence is a wider boundary than the one
+#              the contract declares.
+#   writer     the DETERMINISTIC PUBLICATION ADAPTER. It runs no provider and
+#              no command; it adopts measured bytes and publishes an envelope.
+#              Injected because writing files is a host act -- `baton_v12`
+#              never holds a process -- and because a case drives this adapter
+#              over disposable roots.
+#   authority  the participant-bound Authority port the custody acts need.
+#   adapter    the engine/custodian adapter those same acts reach the host
+#              through. Faked only at this boundary, never above it.
+#
+# AND DELIBERATELY NOT A RETENTION POLICY. The first cut of this seam carried
+# one, and nothing here used it: retention and cleanup are the SERVING
+# manager's remaining ending steps, which ART-7 keeps independent of result
+# acceptance. A seam member no act asks for is a capability nobody granted and
+# nothing proves, so it is gone rather than documented.
+PUBLICATION_SEAM = ("control", "host", "exclusion", "workspaces", "writer",
+                    "authority", "adapter")
+HOST_OUTPUT = ("instance", "output_of")
+HOST_EXCLUSION = ("instance", "evidence_of")
+WRITER_PORT = ("instance", "adopt")
+
+# WHERE THE STAGED ORIGINAL AND THE RECOVERY'S OWN PROVENANCE SIT inside the
+# private staging root. Two names and they are two: the staged original is
+# the read-only input a publication consumes, and the provenance is the
+# recovery's own account, which is a SEPARATE declared output and must never
+# be inside the tree whose digest this capability exists to preserve.
+STAGED_ROOT = "input"
+PROVENANCE_ROOT = "provenance"
+STAGING_LOCK = ".staging.lock"
+PRIVATE = 0o700
+READ_ONLY_FILE = 0o444
+READ_ONLY_DIR = 0o555
