+    # -- the bound dominates a late completion (review 03-03-48Z C2) ---------
+
+    def supervised_under_a_clock(self, release_at, bound=1, late_setup=None):
+        """The REAL supervisor over a REAL child, with only the clock and the
+        moment the child is released under control. The child cannot end
+        until a release file exists; the wait that would observe it first
+        moves the clock to `release_at`, writes the file and reaps the child.
+        Nothing here sleeps to make a point."""
+        import signal
+        from unittest import mock
+
+        import bounded_command
+
+        ledger = os.path.join(self.root, f"ledger-clock-{release_at}")
+        os.makedirs(ledger)
+        release = os.path.join(self.root, f"release-{release_at}")
+        clock, first, actual = [0.0], [True], os.waitpid
+
+        def wait(pid, flags):
+            if pid > 0 and first[0]:
+                first[0] = False
+                clock[0] = release_at
+                open(release, "w").close()
+                return actual(pid, 0)
+            return actual(pid, flags)
+
+        def written(*operands, **named):
+            if late_setup is not None and operands[1].endswith(".started"):
+                clock[0] = late_setup
+            return kept(*operands, **named)
+
+        kept = bounded_command._written
+        handlers = {number: signal.getsignal(number) for number in (
+            signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
+        child = ("import os, time\n"
+                 f"while not os.path.exists({release!r}): time.sleep(0.001)\n")
+        try:
+            with mock.patch.object(bounded_command.time, "monotonic",
+                                   lambda: clock[0]), \
+                    mock.patch.object(bounded_command.os, "waitpid", wait), \
+                    mock.patch.object(bounded_command, "_written", written):
+                status = bounded_command.supervise(
+                    [sys.executable, "-c", child], label="check",
+                    seconds=bound, deadline=float(bound), ledger=ledger)
+        finally:
+            for number, handler in handlers.items():
+                signal.signal(number, handler)
+            open(release, "w").close()
+        return status, next(iter(bounded_command.account(ledger).values()))
+
+    def test_a_command_that_ends_inside_its_bound_is_its_own_status(self):
+        status, record = self.supervised_under_a_clock(0.5)
+        self.assertEqual((status, record["outcome"], record["status"]),
+                         (0, "exited", 0))
+
+    def test_a_command_that_ends_after_its_bound_is_a_timeout_not_a_success(
+            self):
+        """The child is released only AFTER the clock has crossed the bound.
+        It then exits 0 -- and the supervisor answers 124, records
+        `timed-out` and publishes no status."""
+        import bounded_command
+
+        for release_at in (1.0, 2.0):
+            with self.subTest(release_at=release_at):
+                status, record = self.supervised_under_a_clock(release_at)
+                self.assertEqual(
+                    (status, record["outcome"], record["status"],
+                     record["descendants_gone"]),
+                    (bounded_command.TIMED_OUT, "timed-out", None, True))
+
+    def test_a_bound_that_expires_while_the_supervisor_sets_up_runs_nothing(
+            self):
+        """The allowance is re-read at the launch: the clock crosses the
+        bound while the start record is being left, and no child exists."""
+        import bounded_command
+        from unittest import mock
+
+        with mock.patch.object(bounded_command.os, "fork",
+                               side_effect=AssertionError("launched")):
+            status, record = self.supervised_under_a_clock(
+                0.5, late_setup=1.5)
+        self.assertEqual((status, record["outcome"]),
+                         (bounded_command.TIMED_OUT, "not-run"))
+
+    def test_a_supervisor_that_answers_after_the_deadline_is_not_a_pass(self):
+        """THE ADAPTER'S OWN CLOCK. The supervisor's record says the check
+        exited 0; the adapter's clock says its supervisor answered after the
+        invocation deadline. The check is `timed-out`, never `passed`."""
+        from unittest import mock
+
+        actual, clock, moved = subprocess.Popen, [None], []
+
+        class Waited:
+            def __init__(self, child):
+                self.child = child
+                self.pid = child.pid
+
+            def wait(self, timeout=None):
+                answer = self.child.wait(timeout=timeout)
+                if not moved:
+                    moved.append(True)
+                    clock[0] = time.monotonic() + 7200
+                return answer
+
+        def now():
+            return clock[0] if clock[0] is not None else monotonic()
+
+        monotonic = time.monotonic
+        with mock.patch.object(self.module.subprocess, "Popen",
+                               lambda *a, **k: Waited(actual(*a, **k))), \
+                mock.patch.object(self.module.time, "monotonic", now):
+            seen = self.checked("pass")
+        self.assertEqual((seen["outcome"], seen["status"]),
+                         ("timed-out", None))
+
+    def test_a_provider_whose_supervisor_answers_late_is_a_timeout(self):
+        """The same rule for the provider: a clean exit recorded by its
+        supervisor, observed by the adapter after the one invocation
+        deadline, is a timed-out turn."""
+        from unittest import mock
+
+        monotonic, jump = time.monotonic, [0.0]
+        ran = self.agent._ran_provider
+
+        def late(*operands, **named):
+            answer = ran(*operands, **named)
+            jump[0] = 7200.0
+            return answer
+
+        with mock.patch.object(self.agent, "_ran_provider", late), \
+                mock.patch.object(self.module.time, "monotonic",
+                                  lambda: monotonic() + jump[0]):
+            answer, account = self.provided("pass\n")
+        self.assertEqual(account["provider"]["outcome"], "exited")
+        self.assertEqual((answer["ok"], answer["failure_reason"]),
+                         (False, self.module.PROVIDER_TIMED_OUT))
+
