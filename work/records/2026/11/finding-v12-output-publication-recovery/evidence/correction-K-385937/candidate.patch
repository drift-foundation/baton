+def _delivered(store, held, ended, settled, intent, at):
+    """THE OWNER ITEM, addressed to the participant who decided.
+
+    WHAT IT CARRIES IS WHAT AN OWNER NEEDS TO DISPOSE OF IT: what ended the
+    publication, where the retained material is, and what -- if anything --
+    is still owed. It carries no bytes, no path an agent could redirect and
+    no verdict.
+    """
+    job_id = held["job_id"]
+    decision = publication_recovery.decision_of(store, held["decision_id"])
+    staging = staging_of(store, job_id)
+    remaining = []
+    if intent is not None and settled is None:              # pragma: no cover
+        remaining.append("the publication runtime's settlement")
+    record = {
+        "decision_id": held["decision_id"], "job_id": job_id,
+        "prior_job_id": held["prior_job_id"],
+        "outcome": ended["outcome"], "cause": ended["cause"],
+        # THE PARTICIPANT WHO DECIDED, read off the committed decision. The
+        # item goes to whoever approved this recovery and to nobody else.
+        "destination": ((decision or {}).get("owner") or {}).get("endpoint"),
+        "evidence": {
+            "original": "the failed Job's retained output, unchanged; read "
+                        "it with publication-inspect",
+            "original_attempt_id": held["candidate"].get("attempt_id"),
+            "staged_input": None if staging is None
+            else staging["staged"]["locator"],
+            "publication_attempt_id": None if intent is None
+            else intent["attempt_id"],
+            "publication_workspace": (
+                None if intent is None else
+                "retained under the publication attempt; not published, not "
+                "frozen and not a candidate"),
+            "runtime": None if settled is None else settled["runtime"]},
+        "remaining": remaining,
+        "automatic_retry": False,
+        "delivered_at": at}
+    return store.transact(
+        owner_item_operation_id(job_id), OWNER_ITEM_KIND,
+        job_signature(OWNER_ITEM_KIND, {"decision_id": record["decision_id"],
+                                        "job_id": job_id}),
+        lambda connection: record)
+
+
+# -- 10b. the review this recovery released ----------------------------------
+
+def review_stage_of(store, held, at=None, *, control=None):
+    """WHERE THE RECOVERY'S REVIEW STAGE STANDS, from this store's own rows.
+
+    A READ. `state` is one of: `not-started` (no episode was ever opened),
+    `in-progress` (an episode is open), or the terminal state its last episode
+    ended in. `ended` is set only for a review that ENDED WITHOUT A VERDICT
+    PATH OF ITS OWN -- an exceptional ending, or a recovery whose own control
+    closed before any episode opened -- and names what closed it. A completed
+    or changes-requested review is the reviewer's own outcome and is read from
+    the review owner, never classified here.
+    """
+    stage_id = held["review_stage_id"]
+    history = episodes.episodes_of(store, stage_id)
+    last = history[-1] if history else None
+    state = ("not-started" if last is None else
+             "in-progress" if last["ended_state"] is None else
+             last["ended_state"])
+    at = store._now() if at is None else at
+    own = cancellation.fenced(store._connection, held["job_id"])
+    closed = job_control.closed_of(store, held["job_id"], at, any_stage=True)
+    closure = None
+    if own is not None:
+        expired = own.get("trigger", "operator") != "operator"
+        closure = {"outcome": "review-expired" if expired
+                   else "review-cancelled",
+                   "cause": f"this recovery was "
+                            f"{'expired' if expired else 'cancelled'} at "
+                            f"{own['requested_at']} ({own['reason']})"}
+    elif closed is not None and closed["cause"] == "deadline":
+        first = closed["first"]
+        closure = {"outcome": "review-expired",
+                   "cause": f"this recovery reached its {first['trigger']} "
+                            f"at {first['deadline_at']}"}
+    ended = None
+    if state == "exceptional":
+        ended = closure or {
+            "outcome": "review-failed",
+            "cause": "the review stage ended exceptionally with no verdict"}
+    elif state in ("not-started", "in-progress") and closure is not None:
+        # CLOSED BY THIS RECOVERY'S OWN CONTROL. An open episode is not
+        # reopened by anything after the fence; whether its reviewer has
+        # positively stopped, and whether it left a verdict of its own, are
+        # the control store's facts and `deliver_review_item` asks them.
+        ended = closure
+    elif state == "in-progress" and control is not None \
+            and last["attempt_id"] is not None:
+        # A REVIEW THAT COULD NOT BE STARTED. The deployment's post-claim
+        # preparation refused -- for a recovery, typically the line owner
+        # holding the recovered checkpoint -- and journalled that as this
+        # attempt's ending. The episode stays open in this store, so the
+        # Worker Manager's own record is what says the review is over; it is
+        # read only where a caller supplied that store.
+        from ..worker_manager import attempt_preparation_failure_of
+
+        failed = attempt_preparation_failure_of(control, last["attempt_id"])
+        if failed is not None:
+            ended = {"outcome": "review-failed",
+                     "cause": "the review could not be started: its "
+                              "preparation was refused and recorded as this "
+                              "attempt's ending; read the attempt for the "
+                              "typed refusal"}
+    return {"stage_id": stage_id,
+            "episode": None if last is None else last["episode"],
+            "attempt_id": None if last is None else last["attempt_id"],
+            "state": state, "ended": ended}
+
+
+def _review_verdict(seam, state, attempt_id):
+    """The review owner's committed verdict act for this attempt, or `None`."""
+    from ..worker_manager import review_cycles
+
+    if state is None or state.get("assignment") is None:
+        return None
+    attachment = review_cycles.review_for_attempt(
+        seam["control"], attempt_id=attempt_id,
+        generation=state["assignment"]["generation"])
+    if attachment is None:
+        return None
+    act = seam["control"].operation_record(
+        review_cycles.VERDICT_KIND + ":" + attachment["attachment_id"])
+    if act is None or act["state"] != "committed":
+        return None
+    return act
+
+
+def deliver_review_item(store, seam, *, decision_id, now=None):
+    """ACT SIX: tell the owner a PUBLISHED recovery's review did not conclude.
+
+    REPLAYS ITS COMMITTED ITEM. Refuses -- held, changing nothing -- while the
+    review is still open, has a verdict path of its own, or its attempt's
+    runtime is not yet positively gone: an item is not delivered as settled
+    over a reviewer that may still be running.
+
+    IT STARTS NOTHING. No retry, no second review, no analysis and no
+    re-admission; the published custody and the frozen candidate checkpoint
+    stay exactly as they are, and the item says which continuation this build
+    does not offer.
+    """
+    taken = check_publication_seam(seam)
+    _agreeing_instance(taken, what="this review item")
+    held = _admitted(store, decision_id)
+    job_id = held["job_id"]
+    delivered = review_item_of(store, job_id)
+    if delivered is not None:
+        return delivered
+    handoff = handoff_of(store, job_id)
+    if handoff is None:
+        _refuse(f"recovery {name_value(job_id)} handed nothing to review; "
+                f"a publication that did not complete is settled by its own "
+                f"act")
+    at = boundaries.instant(now if now is not None else store._now(),
+                            "a review item instant")
+    review = review_stage_of(store, held, at, control=taken["control"])
+    if review["ended"] is None:
+        _refuse(f"recovery {name_value(job_id)}'s review is "
+                f"{name_value(review['state'])}; an item is delivered only "
+                f"for a review that ended without a verdict",
+                category="runtime-observation", code="quiescence-unknown")
+    remaining = []
+    answered = None
+    if review["attempt_id"] is not None:
+        state = _runtime_of(taken, review["attempt_id"])
+        started = state is not None and state["runtime_id"] is not None
+        gone = started and state["execution_runtime"] == "destroyed" \
+            and state["cleanup"] in ("complete", "retained")
+        if started and not gone \
+                and state["execution_runtime"] != "quiescent":
+            _refuse(f"review attempt {name_value(review['attempt_id'])}'s "
+                    f"runtime is recorded "
+                    f"{name_value(state['execution_runtime'])} with cleanup "
+                    f"{name_value(state['cleanup'])}; the review's ending is "
+                    f"reported to the owner once its execution has "
+                    f"positively ceased",
+                    category="runtime-observation", code="quiescence-unknown")
+        if _review_verdict(taken, state, review["attempt_id"]) is not None:
+            _refuse(f"review attempt {name_value(review['attempt_id'])} "
+                    f"recorded a verdict; a review with its own outcome is "
+                    f"read from the review owner and is not reported as one "
+                    f"that did not conclude")
+        if started and not gone:
+            remaining.append(
+                f"the review attempt's runtime is stopped and retained. With "
+                f"the manager stopped, remove it with: manager "
+                f"settlement-remove --instance <instance.json> --job "
+                f"{job_id} --stage {review['stage_id']} --episode "
+                f"{review['episode']} --reason <why>")
+        if not started and state is not None \
+                and state.get("assignment") is not None:
+            remaining.append(
+                "the review attempt claimed the Work and started no runtime; "
+                "ending that assignment is the ordinary supported settlement "
+                "of an unstarted attempt")
+        frozen = frozen_output_of(taken["control"], review["attempt_id"])
+        answered = None if frozen is None else frozen["result_id"]
+    decision = publication_recovery.decision_of(store, decision_id)
+    record = {
+        "decision_id": decision_id, "job_id": job_id,
+        "prior_job_id": held["prior_job_id"],
+        "outcome": review["ended"]["outcome"],
+        "cause": review["ended"]["cause"],
+        "destination": ((decision or {}).get("owner") or {}).get("endpoint"),
+        "evidence": {
+            "original": "the failed Job's retained output, unchanged",
+            "publication": {
+                "attempt_id": handoff["publication_attempt_id"],
+                "result_id": handoff["custody"]["result_id"],
+                "manifest_digest": handoff["custody"]["manifest_digest"],
+                "artifact_id": handoff["custody"]["artifact_id"],
+                "state": "published and in custody; retained"},
+            "candidate": {"base": handoff["candidate"]["base"],
+                          "head": handoff["candidate"]["head"]},
+            "handoff_digest": digest(handoff),
+            "review": {"stage_id": review["stage_id"],
+                       "episode": review["episode"],
+                       "attempt_id": review["attempt_id"],
+                       "answered_result_id": answered,
+                       "verdict": None}},
+        "remaining": remaining,
+        "continuation": "a review-only continuation from this completed "
+                        "publication is not a supported command of this "
+                        "build; the custody above is retained and a new "
+                        "owner decision is required",
+        "automatic_retry": False,
+        "delivered_at": at}
+    return store.transact(
+        review_item_operation_id(job_id), REVIEW_ITEM_KIND,
+        job_signature(REVIEW_ITEM_KIND, {"decision_id": decision_id,
+                                         "job_id": job_id}),
+        lambda connection: record)
+
+
+# -- 11. the level-triggered pass --------------------------------------------
+#
+# WHICH ACT ONE TICK PERFORMS, DERIVED FROM DURABLE ROWS and never from a
+# process's memory. `retained_verification.advance_verification`'s shape and
+# its reason: a restarted manager must owe exactly what the records say is
+# owed, and a pass that remembered where it was would owe something else.
+ACTS = ("stage", "publish", "custody", "hand-off", "settle", "review-item")
+ACT_OUTCOMES = ("performed", "held", "refused")
+
+
+def publication_readiness(store, decision_id, *, control=None):
+    """WHICH ACT THIS RECOVERY OWES NEXT, and what has already happened.
+
+    THE WHOLE ANSWER IS DERIVED, so the same question asked by a status
+    command, by the sweep and by a case gets the same answer. `owed` is the
+    next act or `None` when the handoff is done -- and `None` does NOT mean
+    "reviewed": it means this module has nothing further to do and the review
+    stage is now the ordinary pipeline's.
+    """
+    held = _admitted(store, decision_id)
+    job_id = held["job_id"]
+    staged = staging_of(store, job_id)
+    adopted = result_of(store, job_id)
+    custody = custody_of(store, job_id)
+    handoff = handoff_of(store, job_id)
+    uncertain = hold_of(store, job_id)
+    launched = launch_of(store, job_id)
+    ended = ending_of(store, job_id)
+    unknown = unknown_of(store, job_id)
+    settled = settlement_of(store, job_id)
+    item = owner_item_of(store, job_id)
+    # A RECOVERY THAT DID NOT PUBLISH OWES ITS SETTLEMENT, and one whose own
+    # control has closed before anything was recorded owes it too -- an
+    # expired recovery nobody settled is an owner nobody told.
+    closed = adopted is None and item is None and ended is None \
+        and _closure_of(store, held, store._now()) is not None
+    owed = None
+    if adopted is None and item is not None:
+        owed = None
+    elif adopted is None and (uncertain is not None or ended is not None
+                              or closed):
+        owed = "settle"
+    elif staged is None:
+        owed = "stage"
+    elif adopted is None:
+        owed = "publish"
+    elif custody is None:
+        owed = "custody"
+    elif handoff is None:
+        owed = "hand-off"
+    review = None
+    review_item = None
+    if handoff is not None:
+        # AFTER THE HAND-OFF THE REVIEW IS THE ORDINARY PIPELINE'S, with one
+        # thing still owed here: a review that ENDED WITHOUT A VERDICT is
+        # reported to the owner who decided this recovery, once.
+        review = review_stage_of(store, held, control=control)
+        review_item = review_item_of(store, job_id)
+        if review["ended"] is not None and review_item is None:
+            owed = "review-item"
+    # WHAT IS KNOWN ABOUT THE RUNTIME, said so a reader cannot take the last
+    # recorded axis for current knowledge (review 2026-11-23T20-28-00Z). A
+    # failed observation stands until a settlement or a result supersedes it.
+    not_known = unknown is not None and settled is None and adopted is None
+    outcome = ("published" if adopted is not None else
+               ended["outcome"] if ended is not None else
+               "unknown" if (uncertain is not None or not_known) else None)
+    return {"decision_id": decision_id, "job_id": job_id,
+            "prior_job_id": held["prior_job_id"],
+            "staged": staged is not None,
+            "launched": launched is not None,
+            "published": adopted is not None,
+            "custody": custody is not None,
+            "handed_off": handoff is not None,
+            "uncertain": adopted is None and ended is None
+            and (uncertain is not None or not_known),
+            "outcome": outcome,
+            "ended": None if ended is None else {
+                "outcome": ended["outcome"], "cause": ended["cause"],
+                "ended_at": ended["ended_at"]},
+            "runtime_knowledge": (
+                "settled: positively absent" if settled is not None else
+                f"unknown: the engine could not be read at "
+                f"{unknown['observed_at']}; the recorded runtime axis is the "
+                f"last observation and is not current knowledge"
+                if not_known else
+                "recorded: the Worker Manager's own journal; read the "
+                "attempt for it"),
+            "settled": settled is not None,
+            "owner_item": None if item is None else {
+                "destination": item["destination"],
+                "outcome": item["outcome"],
+                "delivered_at": item["delivered_at"],
+                "remaining": list(item["remaining"])},
+            "review": ("blocked" if handoff is None else
+                       "runnable" if review["state"] in ("not-started",
+                                                         "in-progress")
+                       and review["ended"] is None else
+                       review["ended"]["outcome"] if review["ended"]
+                       is not None else "ended: " + review["state"]),
+            "review_stage": review,
+            "review_item": None if review_item is None else {
+                "destination": review_item["destination"],
+                "outcome": review_item["outcome"],
+                "delivered_at": review_item["delivered_at"],
+                "continuation": review_item["continuation"]},
+            "owed": owed,
+            "original_job": "failed; unchanged by this recovery",
+            "detail": ("the published candidate is in custody and the review "
+                       "gate is open; the independent reviewer's own required "
+                       "verification is owed to the review contract and "
+                       "nothing here has judged it"
+                       if handoff is not None else
+                       "nothing is runnable for review: the exact publication "
+                       "custody and candidate handoff REC-9 requires are not "
+                       "both present")}
+
