+        agent, wall, steady, ended = self.watched()
+        agent._enter("completing")
+        self.assertFalse(agent._due())
+        # MEASURING, AND THE INSTANT IS REACHED: the main thread cannot be
+        # interrupted, so the process is ended -- at once.
