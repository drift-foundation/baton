+        self.assertEqual(act["outcome"], "held")
+        # THE REFUSAL'S TYPED CATEGORY AND CODE CROSS, AND ITS PROSE DOES NOT.
+        self.assertEqual(act["detail"], {"category": "runtime-observation",
+                                         "code": "quiescence-unknown"})
