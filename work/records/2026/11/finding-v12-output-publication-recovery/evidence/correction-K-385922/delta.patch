+        return bundle
+    members = ("path", "identity", "declared_base", "verified", "why")
+    if type(source) is not dict or sorted(source) != sorted(members):
+        raise ContractRefusal(
+            "integrity", "schema",
+            f"the line's recorded source is exactly {', '.join(members)}")
