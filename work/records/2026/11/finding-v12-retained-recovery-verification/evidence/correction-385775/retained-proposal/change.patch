+    def command(self, *argv, clock=None):
+        from tools import job_manager
+
+        said = io.StringIO()
+        code = job_manager.main(list(argv), clock=clock or (lambda: NOW),
+                                stream=said)
+        text = said.getvalue()
+        return code, (json.loads(text) if text.strip() else None)
