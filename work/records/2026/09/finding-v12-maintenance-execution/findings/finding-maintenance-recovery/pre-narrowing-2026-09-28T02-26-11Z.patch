+        return self._generation
+
+    @property
+    def execution(self):
+        return self._execution
+
+    @property
+    def container(self):
+        return self._container
+
+    @property
+    def authority(self):
+        """THIS ADMISSION's own identity, and the reason it does not travel.
+
+        W285465 review 2026-09-28T00-30-16Z [P1]: comparing the public facts was not
+        non-transferability, and the reviewer proved it the honest way -- two
+        INDEPENDENT stores, each with its own legitimate hold over the same domain with
+        the same carried facts, and the first store's capability acquired in the second.
+        Every value it compared genuinely matched.
+
+        So the admission derives a value over facts the OTHER store's admission cannot
+        reproduce -- its own journal's database, the incarnation that admitted, and the
+        instant of admission -- records it, and hands it out in the capability. A
+        reopened store computes nothing: it READS the recorded authority, so restart and
+        recovery keep working, which is the property the review told me to preserve
+        explicitly rather than hand-wave with "a process-local object".
+        """
+        return self._authority
+
+
+def standing_recovery(control, domain):
+    """Every recovery hold on this resource that has not been cleared.
+
+    JOURNAL READS ONLY, by derived identity, so this is askable from inside another
+    act's `BEGIN IMMEDIATE` -- which is exactly where `acquire` asks it.
+    """
+    boundaries.text(domain, "a governed conflict domain")
+    ordinal = 1
+    found = []
+    while True:
+        record = _document(control, _recovery_held_id(domain, ordinal),
+                           RECOVERY_HELD_KIND)
+        if record is None:
+            return found
+        if _document(control, _recovery_cleared_id(domain, ordinal),
+                     RECOVERY_CLEARED_KIND) is None:
+            found.append((ordinal, record))
+        ordinal += 1
+
+
+def hold_for_recovery(control, domain, *, generation, recovery, what):
+    """Gate ordinary use of this resource for exactly one recovery operation.
+
+    TAKEN WHILE THE OLD GENERATION IS STILL OUTSTANDING, which is what makes the
+    transition atomic: the hold commits in the same serialized write in which the
+    journal still shows the old token held, so no competing acquisition, preparation,
+    deletion or unrelated custody can arrive between the two facts.
+
+    THE FACTS ARE READ, NOT ACCEPTED. Review 2026-09-27T23-54-20Z: "Recovery admission
+    must validate correlated trusted facts, not merely accept caller-supplied
+    generation/container or a capability minted from those assertions." So the caller
+    names a generation and this reads what that generation actually is -- revoked, with
+    a journalled launch and a bound container, with no admitted activation still
+    unsettled, and not yet returned -- and the record carries forward what the JOURNAL
+    said rather than what the caller said.
+    """
+    import hashlib
+
+    from .store import _recorded, manager_signature
+
+    boundaries.text(domain, "a governed conflict domain")
+    recovery = boundaries.text(recovery, "a recovery operation identity")
+    what = boundaries.text(what, "what is being held for")
+    if type(generation) is not int or generation < 1:
+        raise ContractRefusal(
+            "integrity", "schema",
+            f"a recovery hold carries forward one token generation; "
+            f"{name_value(generation)} is not a generation number")
+    connection = control._connection
+    connection.execute("BEGIN IMMEDIATE")
+    try:
+        for ordinal, held in standing_recovery(control, domain):
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"{what} is refused: {name_value(domain)} already carries recovery "
+                f"hold {ordinal} for operation {name_value(held.get('recovery'))}, "
+                f"which has recorded no clearance; one resource is repaired by one "
+                f"recovery at a time and a standing hold is reconciled rather than "
+                f"taken again")
+        current = token_of(control, domain, generation)
+        if current is None:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"{what} is refused: {name_value(domain)} has no generation "
+                f"{generation} to carry forward")
+        if not current["revoked"]:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"{what} is refused: generation {generation} of {name_value(domain)} "
+                f"has not been revoked, so it is a live permission; a recovery hold "
+                f"carries forward a WITHDRAWN entitlement and does not withdraw one")
+        if current["returned"]:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"{what} is refused: generation {generation} of {name_value(domain)} "
+                f"has already been RETURNED, so this hold would be taken over a "
+                f"resource that was ordinarily eligible in between; the gate is taken "
+                f"while the old token is still held or not at all")
+        if current["launch"] is None or current["container"] is None:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"{what} is refused: generation {generation} of {name_value(domain)} "
+                f"journalled launch {name_value(current['launch'])} and bound "
+                f"container {name_value(current['container'])}; a recovery carries "
+                f"forward the exact execution it is repairing after, and an unbound "
+                f"generation is reconciled rather than recovered from")
+        if current["activating"]:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"{what} is refused: generation {generation} of {name_value(domain)} "
+                f"has an ADMITTED ACTIVATION with no settled outcome, so a container "
+                f"may be about to run over this resource; that is reconciled before a "
+                f"recovery is planned over it")
+        # W285465 review 2026-09-28T00-30-16Z [P1]: THE RECOVERY IS A NEW ACT.
+        # The probe admitted a hold whose recovery operation WAS the revoked task's own
+        # operation, returned that token, and the clearance then found the old
+        # generation and accepted its old cessation -- a resource declared repaired with
+        # no recovery execution at all. TOK-12 requires a FRESH maintenance generation,
+        # so the operation that performs it cannot be the one being recovered from.
+        if recovery == current["operation"]:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"{what} is refused: the recovery operation offered is "
+                f"{name_value(recovery)}, which is the very operation generation "
+                f"{generation} of {name_value(domain)} holds; a revoked execution does "
+                f"not perform its own repair, and a fresh recovery act is required")
+        ordinal = 1
+        while _document(control, _recovery_held_id(domain, ordinal),
+                        RECOVERY_HELD_KIND) is not None:
+            ordinal += 1
+        held_at = control._now()
+        authority = hashlib.sha256("\n".join((
+            "baton-v12-recovery-hold",
+            str(getattr(control, "database", "")),
+            str(getattr(control, "incarnation", "")),
+            domain, str(ordinal), recovery, str(generation),
+            str(current["execution"]), str(current["container"]),
+            held_at)).encode("utf-8")).hexdigest()
+        document = {"version": TOKEN_VERSION, "domain": domain, "ordinal": ordinal,
+                    "recovery": recovery, "what": what,
+                    # THE CARRIED-FORWARD FACTS, as the journal states them.
+                    "generation": generation,
+                    "operation": current["operation"],
+                    "execution": current["execution"],
+                    "container": current["container"],
+                    "launch": current["launch"],
+                    "authority": authority,
+                    "held_at": held_at}
+        control._record(_recovery_held_id(domain, ordinal), RECOVERY_HELD_KIND,
+                        manager_signature(RECOVERY_HELD_KIND, document),
+                        "committed", _recorded(document), None)
+        connection.execute("COMMIT")
+    except BaseException:
+        try:
+            connection.execute("ROLLBACK")
+        except Exception:
+            pass
+        raise
+    return RecoveryHold(domain, ordinal, recovery, generation,
+                        current["execution"], current["container"], authority, _MINT)
+
+
+def _generation_for_operation(control, domain, operation):
+    """The generation this exact operation acquired in this domain, or `None`."""
+    generation = 1
+    while True:
+        recorded = _document(control, _acquired_id(domain, generation), ACQUIRED_KIND)
+        if recorded is None:
+            return None
+        if recorded["operation"] == operation:
+            return generation
+        generation += 1
+
+
+def resume_recovery(control, domain, ordinal):
+    """RE-MINT the capability for a standing hold, from the journal that records it.
+
+    W285465 review 2026-09-28T00-55-52Z, and the review is right that prose about a
+    restart is not a reopen path. Without this there ISN'T one: `hold_for_recovery`
+    refuses while a hold stands and `RecoveryHold` is mint-gated, so a manager that died
+    mid-recovery could never clear its own gate and the resource would be held forever.
+    That is a defect in what I built, not a property of TOK-12.
+
+    SO THE REOPEN IS EXPLICIT AND IT IS A READ. Nothing is admitted, nothing is
+    recorded, no effect is repeated: the standing record is read and the capability is
+    re-minted from the AUTHORITY it already carries, so the value is the same one the
+    original admission derived and a second admission never happens. A cleared or
+    unrecorded ordinal answers a refusal rather than a capability.
+
+    IT IS NOT A WIDENING. Holding this control store already IS this manager's
+    authority; what the capability prevents is a caller fabricating authority for a hold
+    recorded somewhere else, and re-minting from THIS journal's own row cannot do that.
+    """
+    boundaries.text(domain, "a governed conflict domain")
+    if type(ordinal) is not int or ordinal < 1:
+        raise ContractRefusal(
+            "integrity", "schema",
+            f"a recovery hold is named by its ordinal; this is {name_value(ordinal)}")
+    for one, held in standing_recovery(control, domain):
+        if one != ordinal:
+            continue
+        if held.get("authority") is None:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"recovery hold {ordinal} of {name_value(domain)} carries no recorded "
+                f"authority, so this build cannot resume it; it is reconciled by an "
+                f"operator rather than continued on a guess")
+        return RecoveryHold(domain, ordinal, held["recovery"], held["generation"],
+                            held["execution"], held["container"], held["authority"],
+                            _MINT)
+    raise ContractRefusal(
+        "refused", "precondition",
+        f"{name_value(domain)} carries no standing recovery hold {ordinal}; a cleared "
+        f"or unrecorded hold is not resumed")
+
+
+def _presents(recovering, domain, ordinal, held, operation):
+    """Whether this capability IS the standing hold's, decided against the record.
+
+    W285465. My first cut compared the capability against the store's PATH, and the
+    store itself says why that is worthless: `ControlStore` keeps no object identity
+    because "three attempts to prove that a REOPENED connection is this same database
+    were each defeated". Measured here too -- there is no such attribute, so the check
+    could only ever have compared `None` with `None`.
+
+    SO THE RECORD DECIDES. The capability must name this domain, this ordinal, this
+    operation AND carry exactly the facts the standing record carries. A capability from
+    another store fails because that store's journal holds no such hold; one whose
+    carried generation, execution or container disagrees is not this hold's.
+    """
+    return (type(recovering) is RecoveryHold
+            and recovering.domain == domain
+            and recovering.ordinal == ordinal
+            and recovering.recovery == operation
+            and held.get("recovery") == operation
+            and recovering.generation == held.get("generation")
+            and recovering.execution == held.get("execution")
+            and recovering.container == held.get("container")
+            # AND THE ADMISSION'S OWN AUTHORITY, which is what makes this capability
+            # this store's admission rather than a matching set of public facts.
+            and recovering.authority is not None
+            and recovering.authority == held.get("authority"))
+
+
+def recovery_authorizes(control, domain, operation, recovering):
+    """Whether a standing recovery hold authorizes THIS operation, for this holder.
+
+    W285465. The exclusion `workspaces` applies to ownership-transferring acts has to be
+    able to ask the same question `acquire` asks, and the comparison belongs in one
+    place: this is that place. Journal reads only, by derived identity, so it is askable
+    from inside another act's `BEGIN IMMEDIATE`.
+    """
+    if recovering is None:
+        return False
+    boundaries.text(domain, "a governed conflict domain")
+    boundaries.text(operation, "a token operation identity")
+    for ordinal, held in standing_recovery(control, domain):
+        if _presents(recovering, domain, ordinal, held, operation):
+            return True
+    return False
+
+
+def _recovery_refusal(control, domain, operation, recovering):
+    """The refusal a standing recovery hold earns THIS acquisition, or `None`.
+
+    Journal reads only, and called from inside `acquire`'s own transaction.
+    """
+    standing = standing_recovery(control, domain)
+    matched = None
+    for ordinal, held in standing:
+        if _presents(recovering, domain, ordinal, held, operation):
+            matched = ordinal
+            continue
+        return ContractRefusal(
+            "refused", "precondition",
+            f"resource {name_value(domain)} is held for recovery {ordinal} of "
+            f"operation {name_value(held.get('recovery'))}, carrying forward "
+            f"generation {held.get('generation')} and container "
+            f"{name_value(held.get('container'))}; ordinary use stays gated until "
+            f"that recovery's own token is returned with its recorded result, and an "
+            f"acquisition for anything else is refused rather than queued")
+    if recovering is not None and matched is None:
+        # AN OLD CAPABILITY STOPS WORKING, which the review requires by name: cleared,
+        # superseded, another domain, another store or another operation all land here
+        # because the JOURNAL decides and this object only says which hold it claims.
+        return ContractRefusal(
+            "refused", "capability",
+            f"a recovery capability was presented for {name_value(domain)} and names "
+            f"no standing hold for operation {name_value(operation)}; a cleared or "
+            f"superseded hold authorizes nothing, and a capability minted against "
+            f"another resource, store or operation was never authority here")
+    return None
+
+
+def record_recovery_result(control, holding, token, *, outcome, detail=None):
+    """RECORD what the recovery act actually did, under its own live token.
+
+    W285465 review 2026-09-28T00-30-16Z [P1]. The clearance used to take the caller's
+    word for the outcome, so a FAILED repair opened the gate. This is where the outcome
+    becomes a durable fact instead: written by the act that is performing the recovery,
+    while it still HOLDS the recovery generation -- so the record is bound to the exact
+    generation and container the journal has, and a later caller cannot invent one.
+
+    IT DOES NOT CLEAR ANYTHING. A recorded `failed` is just as durable as a recorded
+    `succeeded`, and `clear_recovery` refuses on it; the resource stays held, which is
+    what a failed reset is supposed to leave behind.
+    """
+    from .store import _recorded, manager_signature
+
+    if type(holding) is not RecoveryHold:
+        raise ContractRefusal(
+            "refused", "capability",
+            "a recovery result is recorded by the act that took the hold, presenting "
+            "the capability that admission minted")
+    if outcome not in RECOVERY_OUTCOMES:
+        raise ContractRefusal(
+            "integrity", "schema",
+            f"a recovery outcome is one of {RECOVERY_OUTCOMES!r}; this is "
+            f"{name_value(outcome)}")
+    if detail is not None:
+        boundaries.text(detail, "a recovery result detail")
+    domain = holding.domain
+    connection = control._connection
+    connection.execute("BEGIN IMMEDIATE")
+    try:
+        standing = [held for one, held in standing_recovery(control, domain)
+                    if one == holding.ordinal]
+        if not standing or not _presents(holding, domain, holding.ordinal,
+                                        standing[0], holding.recovery):
+            raise ContractRefusal(
+                "refused", "capability",
+                f"recovery hold {holding.ordinal} of {name_value(domain)} does not "
+                f"stand here under this capability's own authority; a result is "
+                f"recorded against the admission that authorized the act")
+        current = token_of(control, domain, token["generation"])
+        if current is None or current["owner"] != token["owner"]:
+            raise ContractRefusal(
+                "runtime-observation", "identity-mismatch",
+                f"the token offered for recovery {name_value(holding.recovery)} does "
+                f"not own generation {token['generation']} of {name_value(domain)}; a "
+                f"result is recorded by the holder of the recovery generation")
+        if current["operation"] != holding.recovery:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"generation {token['generation']} of {name_value(domain)} performs "
+                f"operation {name_value(current['operation'])} and this hold admitted "
+                f"{name_value(holding.recovery)}; a result is recorded under the "
+                f"operation that was admitted")
+        if token["generation"] <= holding.generation:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"generation {token['generation']} of {name_value(domain)} is not "
+                f"later than the generation {holding.generation} this hold carries "
+                f"forward; a recovery is causally after the execution it repairs")
+        if current["returned"]:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"recovery generation {token['generation']} of {name_value(domain)} "
+                f"has already been returned; its result is recorded while it still "
+                f"holds the resource, so the record cannot be composed afterwards")
+        if current["container"] is None:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"recovery generation {token['generation']} of {name_value(domain)} "
+                f"has bound no container; TOK-12 accounts for the exact maintenance "
+                f"container that performed the repair")
+        # W285465 review 2026-09-28T00-55-52Z [P1]: A BOUND CONTAINER IS NOT AN EXECUTED
+        # REPAIR. The reviewer's probe journalled a launch, bound an INERT container,
+        # never admitted or started its activation, and recorded `succeeded` -- so an
+        # inert create cleared the gate. The two-act shape exists exactly so that
+        # "created" and "ran" are different facts, and this is the reader that has to
+        # tell them apart.
+        #
+        # A FAILURE OR AN UNKNOWN MAY STILL BE RECORDED over an inert or unsettled
+        # generation, which is the honest account of an act that did not run: what is
+        # refused is calling that a SUCCESS.
+        if outcome == "succeeded":
+            if current["activating"]:
+                raise ContractRefusal(
+                    "refused", "precondition",
+                    f"recovery generation {token['generation']} of "
+                    f"{name_value(domain)} has an ADMITTED ACTIVATION with no settled "
+                    f"outcome, so whether container "
+                    f"{name_value(current['container'])} ran is not yet decided; an "
+                    f"undecided activation is not a successful repair, and a failure "
+                    f"or unknown may be recorded here instead")
+            if current["activation_started"] is not True:
+                raise ContractRefusal(
+                    "refused", "precondition",
+                    f"recovery generation {token['generation']} of "
+                    f"{name_value(domain)} bound container "
+                    f"{name_value(current['container'])} and its activation settled "
+                    f"as {name_value(current['activation_started'])}; a container that "
+                    f"was created and never proved started performed no repair, and an "
+                    f"inert create is not accounted for as a success")
+        document = {"version": TOKEN_VERSION, "domain": domain,
+                    "ordinal": holding.ordinal, "recovery": holding.recovery,
+                    "generation": token["generation"],
+                    "container": current["container"],
+                    "launch": current["launch"],
+                    "outcome": outcome, "detail": detail,
+                    "recorded_at": control._now()}
+        control._record(
+            _recovery_result_id(domain, holding.ordinal, token["generation"]),
+            RECOVERY_RESULT_KIND,
+            manager_signature(RECOVERY_RESULT_KIND, document),
+            "committed", _recorded(document), None)
+        connection.execute("COMMIT")
+    except BaseException:
+        try:
+            connection.execute("ROLLBACK")
+        except Exception:
+            pass
+        raise
+    return document
+
+
+def clear_recovery(control, holding, *, result, cessation, why):
+    """Open ordinary use again, on the recovery's OWN settled return.
+
+    NOT THE HOST-PREPARATION RULE, and review 2026-09-27T23-54-20Z is right that
+    copying it would have been wrong: there, a writer that RETURNS has provably ended,
+    because the window is about a call stack. A recovery is about a CONTAINER and a
+    repair, so a returned call proves neither that the resource was repaired nor that
+    the helper is gone.
+
+    WHAT CLEARS THE GATE is the recovery generation's own return -- which `returned`
+    only grants against typed cessation evidence naming the exact bound container --
+    plus the recorded result of the act. Both are read here out of the journal.
+    """
+    from .store import _recorded, manager_signature
+
+    if type(holding) is not RecoveryHold:
+        raise ContractRefusal(
+            "refused", "capability",
+            "clearing a recovery hold is done by the act that took it, presenting the "
+            "capability that admission minted")
+    # THE ACT'S OWN ACCOUNT, with a CLOSED shape: `operation` and `outcome` are what
+    # this gate reads, and the three optional names are the ones the maintenance
+    # facility's own answers already carry. Measured: `document` refuses an
+    # unrecognised member rather than ignoring it, so the optional set is stated
+    # instead of discovered by a caller's surprise.
+    result = boundaries.document(result, "a recovery result",
+                                 required=("operation", "outcome"),
+                                 optional=("root", "verb", "detail"))
+    cessation = boundaries.document(
+        cessation, "a recovery container cessation answer",
+        required=("domain", "generation", "launch", "container", "stopped",
+                  "helpers"))
+    why = boundaries.text(why, "why the recovery hold is cleared")
+    domain = holding.domain
+    connection = control._connection
+    connection.execute("BEGIN IMMEDIATE")
+    try:
+        standing = [held for one, held in standing_recovery(control, domain)
+                    if one == holding.ordinal]
+        if not standing:
+            raise ContractRefusal(
+                "refused", "already-terminal",
+                f"recovery hold {holding.ordinal} of {name_value(domain)} carries a "
+                f"clearance already, or was never recorded in this journal; a cleared "
+                f"hold is not cleared a second time and a capability from elsewhere "
+                f"clears nothing here")
+        if not _presents(holding, domain, holding.ordinal, standing[0],
+                         holding.recovery):
+            raise ContractRefusal(
+                "refused", "capability",
+                f"the capability offered for recovery hold {holding.ordinal} of "
+                f"{name_value(domain)} does not carry that hold's own facts "
+                f"(generation {standing[0].get('generation')}, execution "
+                f"{name_value(standing[0].get('execution'))}, container "
+                f"{name_value(standing[0].get('container'))}); a capability that names "
+                f"another act is not this one")
+        # THE RECOVERY IS FOUND BY ITS OPERATION, not by an execution the hold could
+        # not have known: `acquire` guarantees that while this hold stood, ONLY this
+        # operation could take a generation here, so the operation identifies it.
+        # Measured: looking it up under the carried-forward execution found nothing,
+        # because the recovery executor is not the old task's execution -- which is
+        # exactly the review's point that a revoked task cannot authorize the writer.
+        generation = _generation_for_operation(control, domain, holding.recovery)
+        if generation is not None and generation <= holding.generation:
+            # AND IT MUST BE CAUSALLY AFTER what it repairs. Review
+            # 2026-09-28T00-30-16Z [P1]: a historically returned operation is not proof
+            # of THIS recovery, so an earlier generation wearing the admitted
+            # operation's name clears nothing.
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"operation {name_value(holding.recovery)} holds generation "
+                f"{generation} of {name_value(domain)}, which is not later than the "
+                f"generation {holding.generation} this hold carries forward; a "
+                f"historical act is not this recovery")
+        if generation is None:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"recovery {name_value(holding.recovery)} acquired no generation of "
+                f"{name_value(domain)}, so no recovery execution happened; the hold "
+                f"stays standing, because an unperformed repair is not a completed one")
+        recovered = token_of(control, domain, generation)
+        if not recovered["returned"]:
+            raise ContractRefusal(
+                "refused", "precondition",
+                f"recovery generation {generation} of {name_value(domain)} is still "
+                f"OUTSTANDING (container {name_value(recovered['container'])}); the "
+                f"gate opens on that token's own settled return, not on its holder "
+                f"reporting itself finished")
+        if cessation["domain"] != domain \
+                or cessation["generation"] != generation \
+                or cessation["launch"] != recovered["launch"] \
+                or cessation["container"] != recovered["container"]:
+            raise ContractRefusal(
+                "runtime-observation", "identity-mismatch",
+                f"the cessation offered for recovery generation {generation} of "
+                f"{name_value(domain)} describes launch "
+                f"{name_value(cessation['launch'])} and container "
+                f"{name_value(cessation['container'])}, and that generation bound "
+                f"launch {name_value(recovered['launch'])} and container "
+                f"{name_value(recovered['container'])}; evidence about another "
+                f"execution clears nothing")
+        # THE ACCEPTED SHAPE, NOT AN INVENTED ONE. `returned` treats `helpers` as the
+        # LIST OF SURVIVORS -- empty means none -- and `stopped` as the boolean itself.
+        # Measured while writing this: my first cut demanded `helpers is True`, which
+        # would have refused every honest answer the rest of this module produces.
+        if cessation["stopped"] is not True or cessation["helpers"]:
+            raise ContractRefusal(
+                "runtime-observation", "quiescence-unknown",
+                f"the cessation offered for recovery generation {generation} of "
