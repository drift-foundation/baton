+class TheGOVERNEDCustodyActBindsBeforeItActivates(MaintenanceCase):
+    """W285465, TOK-12: the token-bound custody act, driven end to end.
+
+    The engine is a stand-in answering the exact vocabulary this branch composes --
+    create, start, wait, logs and the reclamation verbs -- and recording the order. What
+    is proved is the ORDER and the SHAPE: the container is created INERT, the binding
+    happens before any activation, the activation is settled only after a positive
+    start, the act's status comes from the CONTAINER's exit rather than the logs
+    command's, the account is read from that exact container, and the container is
+    ceased explicitly because this branch composes no `--rm`.
+    """
+
+    def governed(self, *, exit_status="0\n", start=0):
+        order, governed, submitted, vectors = [], [], [], []
+
+        def engine(argv, *, seconds=None):
+            verb = argv[1]
+            order.append(verb)
+            vectors.append(list(argv))
+            if verb == "create":
+                submitted.append(custody_suite.echoed(argv))
+                return {"status": 0, "stdout": "container-governed\n", "stderr": ""}
+            if verb == "start":
+                return {"status": start, "stdout": "", "stderr": "lost reply"}
+            if verb == "wait":
+                return {"status": 0, "stdout": exit_status, "stderr": ""}
+            if verb == "logs":
+                return {"status": 0, "stderr": "",
+                        "stdout": json.dumps(
+                            custody_suite.reported("normalize")) + "\n"}
+            if verb == "inspect":
+                return {"status": 1, "stdout": "",
+                        "stderr": "Error: No such container: " + argv[-1]}
+            return {"status": 0, "stdout": "", "stderr": ""}
+
+        def governing(container, phase):
+            governed.append((container, phase, list(order)))
+
+        answered = custody.custody_act(
+            "docker", engine, image_digest="sha256:" + "c" * 64, store=self.store,
+            assignment_id="attempt-1", operation="normalize", which="workspace",
+            governing=governing)
+        # THE TUPLE STAYS THREE-WIDE, deliberately: the reviewer's immutable
+        # review_governed_start_20260928.py calls this helper and unpacks three, and
+        # widening it broke their probe -- measured. The captured vectors travel on the
+        # case instead, so a shared fixture keeps its contract.
+        self.vectors = vectors
+        return answered, order, governed
+
+    def test_the_inert_create_is_bound_before_anything_is_activated(self):
+        answered, order, governed = self.governed()
+        vectors = self.vectors
+        # MEASURED: the act reconciles what may already answer to its derived name
+        # BEFORE it creates anything -- `ps` first -- which is W43974's rule and not
+        # something this branch changes. The create is the first thing that MAKES
+        # anything.
+        self.assertEqual(order[0], "ps")
+        self.assertEqual([one for one in order if one == "create"], ["create"])
+        # THE PROPERTY UNDER TEST: the FIRST thing the governing callback is asked is
+        # the binding, with the created identity, and it happens before any activation
+        # vector has been issued. MEASURED AND NOT OVERSTATED: with this stand-in engine
+        # the later settle phase is not reached, and why is recorded below rather than
+        # asserted away -- so this case claims the ordering it actually observes.
+        self.assertEqual(governed[0][1], "created")
+        self.assertEqual(governed[0][0], "container-governed")
+        self.assertNotIn("start", governed[0][2],
+                         "the binding ran after the container was activated")
+        # AND THE SHAPE IS THE INERT ONE, read off the ACTUAL VECTOR rather than its
+        # verb: review 2026-09-28T01-55-57Z is right that checking a verb list could
+        # never have seen `--rm`, because `--rm` is an operand.
+        created = [one for one in vectors if one[1] == "create"]
+        self.assertEqual(len(created), 1)
+        self.assertNotIn("--rm", created[0])
+        self.assertNotIn("run", [one[1] for one in vectors])
+        # AND THE ACT COMPLETED ACCOUNTABLY -- which my previous case DISCARDED, and
+        # discarding it is how a branch that raised NameError passed.
+        self.assertTrue(answered.ok, answered.diagnostic)
+        self.assertEqual(answered.status, 0)
+        # THE CESSATION COMES AFTER THE ACCOUNT, which is the pinned order.
+        self.assertLess(order.index("logs"), order.index("rm"))
+        self.assertEqual([one[1] for one in governed], ["created", "started"])
+        self.assertIn("start", governed[1][2],
+                      "the activation was settled before the engine answered it")
+
+    def test_a_LOST_start_reply_settles_nothing_and_holds(self):
+        """A failed start is compatible with a running container, so the activation is
+        left UNSETTLED -- which holds the resource -- and no account is claimed.
+
+        RESTORED, and my reason for dropping it was wrong: review 2026-09-28T01-55-57Z
+        measured that `_settled` translates EXCEPTIONS, not every non-zero result, so a
+        status the engine returns arrives here intact. I had inferred the opposite from a
+        failure whose real cause was the missing `oci` import.
+        """
+        answered, order, governed = self.governed(start=1)
+        self.assertEqual([one[1] for one in governed], ["created"],
+                         "a lost start reply settled the activation anyway")
+        self.assertIn("create", order)
+        self.assertNotIn("wait", order, "the act waited on an unconfirmed start")
+        self.assertFalse(answered.ok)
+        self.assertIn("UNRESOLVED", answered.diagnostic)
+
+    def test_the_CONTAINERS_own_exit_decides_and_not_the_logs_command(self):
+        """Two successful commands about a failed execution are not a success."""
+        answered, order, _governed = self.governed(exit_status="17\n")
+        self.assertIn("logs", order)
+        self.assertEqual(answered.status, 17)
+        self.assertFalse(answered.ok, "a container that exited 17 answered ok")
