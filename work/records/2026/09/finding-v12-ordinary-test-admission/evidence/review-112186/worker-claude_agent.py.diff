+def _task_digest(raw):
+    """The frozen task's identity, as prefixed text a document may carry.
+
+    `_bytes_digest` answers raw bytes for an in-process comparison and is
+    deliberately left alone; this is the same hash rendered the way every other
+    digest that crosses a boundary in this campaign is rendered, because a
+    document member has to be JSON and a consumer has to be able to compare it
+    to one it computed itself.
+    """
+    import hashlib
+
+    return "sha256:" + hashlib.sha256(raw).hexdigest()
+
+
+def _ordinary_tests(task, task_bytes, verification, base, head):
+    """The actual ordinary-test observation this turn produced.
+
+    W112029. EVERY MEMBER IS ALREADY TRUE OF THIS TURN and none of it is new
+    work: the argv is the frozen task's own, the status is what this adapter
+    read from the child it already ran, the digest names the exact bytes it
+    read that task from, and the two objects are the ones the proposal claim
+    already carries.
+
+    UNRUN IS EXPLICITLY NULL RATHER THAN ABSENT OR ZERO. `_verify` is skipped
+    when the provider failed or produced no patch, and a timeout or a failed
+    start answers `None` too. All three are "this command did not produce a
+    status", and a consumer that must refuse on anything but an actual zero
+    needs to see the difference between that and a status it can compare. A
+    missing member would make the same statement by omission, which is the one
+    shape a closed reader cannot tell from a producer that forgot.
+    """
+    return {ORDINARY_TESTS_NAMESPACE: {
+        "task_id": task["task_id"],
+        "task_digest": _task_digest(task_bytes),
+        "argv": list(task["verification"]),
+        "status": None if verification is None else verification["status"],
+        "base": base, "head": head}}
+
