+
+    THE COMMAND REALLY RUNS HERE. Review 2026-09-07T17-47-09Z [P1]: the first
+    version of these cases inherited a runner that returned a
+    `CompletedProcess` for every non-Git argv, so the status in the metadata
+    was one the fixture injected and the case proved only that the member was
+    carried. `really()` below executes the task's own verification argv for
+    real, so a status of zero is a command that actually exited zero.
     """
+
+    def really(self, **operands):
+        """The adapter's process seam with the VERIFICATION COMMAND REAL.
+
+        Git is real, as `LineCase` already makes it; the provider stays
+        injected, because a model turn is what a deterministic case cannot
+        have. The task's own command is executed with `subprocess.run` in the
+        candidate, which is the one thing the accepted contract asks this
+        observation to be about.
+        """
+        fake = self.provider(**operands)
+
+        def run(argv, **options):
+            if argv[0] == "git":
+                self.git_calls.append(list(argv))
+                return subprocess.run(list(argv), env=self.environment(),
+                                      **options)
+            if list(argv) == list(LINE_TASK["verification"]):
+                return subprocess.run(list(argv), **options)
+            return fake(argv, **options)
+
+        return run
+
+    def ran(self, **operands):
+        agent = ClaudeAgent(run=self.really(**operands),
+                            home=self.turn_scratch())
+        return agent.work({"contract": "the frozen task"}, list(DECLARED))
 
