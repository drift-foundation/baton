+             "sequence_id": _exchange.sequence_of(held.attempt_id)},
+            _exchange.observation(held)["command"]["command_digest"],
+            operation="work",
+            operation_id=_exchange.worker_operation_id(held.attempt_id,
+                                                       "work")),
