+    def test_a_directory_replaced_before_scanning_cannot_redirect_the_scan(self):
+        agent, state = self.bound()
+        child = os.path.join(state, "child")
+        self.native(child, "own.jsonl", "x" * 7)
+        foreign = os.path.join(self.home, "foreign")
+        self.native(foreign, "foreign.jsonl", "x" * 9000)
+        original = os.scandir
+        calls = []
+
+        def replaced(place):
+            calls.append(place)
+            if len(calls) == 2:
+                os.rename(child, child + "-original")
+                os.symlink(foreign, child)
+            return original(place)
+
+        with mock.patch.object(os, "scandir", replaced):
