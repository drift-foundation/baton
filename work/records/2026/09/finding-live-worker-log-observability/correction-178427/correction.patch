+        self.assertIn(total, (None, 7), "foreign activity was attributed")
+
+    def test_directory_acquisition_rejects_replacement_and_closes_descriptors(self):
+        # Replace between no-follow entry stat and open, rather than after an
+        # already-held descriptor. Both links and different ordinary objects
+        # must fail toward unknown and release every descriptor we acquired.
+        for link in (True, False):
+            with self.subTest(link=link):
+                scratch = os.path.join(self.home, "race-" + str(link))
+                agent, state = self.bound(scratch)
+                child = os.path.join(state, "child")
+                self.native(child, "own.jsonl", "x" * 7)
+                foreign = os.path.join(self.home, "foreign-" + str(link))
+                self.native(foreign, "foreign.jsonl", "x" * 9000)
+                opened, closed, replaced = [], [], []
+                real_open, real_close = os.open, os.close
+
+                def opening(path, flags, *args, **kwargs):
+                    if path == "child" and not replaced:
+                        replaced.append(True)
+                        os.rename(child, child + "-original")
+                        if link:
+                            os.symlink(foreign, child)
+                        else:
+                            os.rename(foreign, child)
+                    fd = real_open(path, flags, *args, **kwargs)
+                    opened.append(fd)
+                    return fd
+
+                def closing(fd):
+                    closed.append(fd)
+                    real_close(fd)
+
+                with mock.patch.object(os, "open", opening), \
+                        mock.patch.object(os, "close", closing):
+                    self.assertIsNone(agent.observed_activity())
+                self.assertEqual(replaced, [True])
+                self.assertCountEqual(opened, closed)
