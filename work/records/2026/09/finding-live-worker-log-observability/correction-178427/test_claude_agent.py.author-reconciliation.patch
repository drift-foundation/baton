     def test_truncation_freezes_the_total(self):
+        """FROZEN, NOT MERELY UNREDUCED. A file truncated IN PLACE keeps its
+        identity, so the count could have carried on from the new size -- and
+        the bytes it then counted would be a second accounting of bytes it had
+        already reported. The growth after the truncation is what tells the
+        two apart, so it is asserted rather than the instant value alone."""
         agent, state = self.bound()
         place = self.native(state, "session.jsonl", "a" * 100)
         self.assertEqual(agent.observed_activity(), 100)
         with open(place, "w", encoding="utf-8") as writing:
             writing.write("a" * 10)
         self.assertEqual(agent.observed_activity(), 100)
+        with open(place, "a", encoding="utf-8") as writing:
+            writing.write("b" * 1000)
+        self.assertEqual(agent.observed_activity(), 100,
+                         "the total resumed after an ambiguous source")
 
