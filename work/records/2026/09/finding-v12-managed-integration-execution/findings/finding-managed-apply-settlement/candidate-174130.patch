+def materialize_prepared_objects(manager, preparation, *, repository, profile, reader):
+    """Materialize retained Git objects without merging or executing content.
+
+    Candidate bytes are re-read from accepted custody and compared with every
+    blob in the exact reported commit. Git tree modes, not custody modes, define
+    the executable candidate. The resulting private object store is reusable.
+    """
+    from tools import integration_bundle
+    material = integration_bundle.retained_preparation_objects(manager, preparation)
+    derived = material["derived"]
+    if not isinstance(derived, dict) or set(derived) != {"revision", "tree", "base", "candidate", "target_revision"}:
+        _denied("the preparation carries no exact derived Git identity")
+    if any(derived[name] != preparation["source"][name] for name in ("base", "candidate", "target_revision")):
+        _denied("the preparation object identity names different source revisions")
+    source = material["candidate"]
+
+    def verify(place):
+        held = profile.held(place, derived["revision"])
+        if held["tree"] != derived["tree"]:
+            _denied("the retained derived commit has a different Git tree")
+        content = profile.content(place, derived["revision"])
+        if set(content) != set(source):
+            _denied("the retained Git tree and candidate files have different paths")
+        handle = integration_bundle._held_directory(place, "the preparation object store")
+        try:
+            for path, blob in content.items():
+                body = reader(("git", "--no-optional-locks", "cat-file", "blob", blob["object"]), directory=handle)
+                if body["returncode"] != 0 or body["stdout"] != source[path]:
+                    _denied("the retained Git blob differs from candidate content: " + path)
+        finally:
+            os.close(handle)
+        return {"head": derived["revision"], "tree": derived["tree"], "content": content}
+
+    if os.path.lexists(repository):
+        answer = verify(repository)
+    else:
+        parent = os.path.dirname(repository)
+        os.makedirs(parent, exist_ok=True)
+        with tempfile.TemporaryDirectory(prefix=".prepared-objects-", dir=parent) as scratch:
+            bundle = os.path.join(scratch, "objects.bundle")
+            with open(bundle, "xb") as stream:
+                stream.write(material["bundle"])
+            place = os.path.join(scratch, "repository")
+            profile._run(("git", "init", "--quiet", "--bare", place), "private preparation object store")
+            profile._run(("git", "-C", place, "fetch", "--quiet", bundle,
+                          "refs/baton/prepared/candidate:refs/baton/prepared/candidate"), "retained preparation objects")
+            answer = verify(place)
+            os.rename(place, repository)
+    return answer
 
 
