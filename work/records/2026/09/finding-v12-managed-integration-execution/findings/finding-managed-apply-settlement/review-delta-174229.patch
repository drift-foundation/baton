+def managed_apply_failure_evidence(store, control, managed_result_id, reported):
+    """Prove a failed apply report against the bytes actually taken into custody.
+
+    The refused entry retains the worker's canonical report. Its JSON is not
+    authority: weigh it against the sealed file and accepted intake, then bind
+    its measurements to the owned phase and approved candidate.
+    """
+    from ..worker_manager.intake import intake_receipt_of
+
+    result = managed_result_of(store, managed_result_id)
+    phase = result["phases"].get("apply")
+    if phase is None or phase["result"]["collected"] is None:
+        _refuse("the failed apply has no owned collected phase")
+    task, account = phase["task"], phase["result"]
+    attempt = task["execution_attempt_id"]
+    intake = intake_receipt_of(control, attempt)
+    collected = account["collected"]
+    if intake is None or intake["custody"] != "accepted" or intake["attempt_id"] != attempt or intake["assignment"] != task["assignment"] or any(intake[name] != collected[name] for name in ("result_id", "manifest_digest")):
+        _refuse("the failed apply report has no matching accepted custody")
+    retained, indexed, custody = _retained_outputs(control, dict(collected, artifacts=intake["artifacts"]), attempt)
+    if retained["assignment_ref"] != task["assignment"] or retained["input_manifest_digest"] != task["input_digest"]:
+        _refuse("the failed apply collection names another fixed assignment or input")
+    outputs = [one for one in retained["outputs"] if one["artifact"] is not None and any(entry["path"] == "managed-apply.json" for entry in one["content_manifest"]["entries"])]
+    if len(outputs) != 1 or len(outputs[0]["content_manifest"]["entries"]) != 1:
+        _refuse("the failed apply requires exactly one sealed report file")
+    output = outputs[0]
+    artifact = _adopted_artifact(retained, indexed, custody, output["name"], attempt)
+    body = canonical_text(reported).encode()
+    raw = _measured_body(body, output["content_manifest"]["entries"][0], "the failed apply report")
+    raw = boundaries.document(raw, "the failed apply report", required=managed_execution.APPLY_REPORT_MEMBERS)
+    expected = {"schema": managed_execution.APPLY_REPORT_SCHEMA, "candidate": result["prepared"]["head"], "tree": result["prepared"]["tree"],
+                "harness_digest": task["harness_digest"], "command": ["python3", "harness.py"],
+                "seconds": task["execution_limits"]["boundaries"]["host_verification"]["seconds"], "tag": None}
+    if any(raw[name] != value for name, value in expected.items()) or type(raw["unchanged"]) is not bool or type(raw["status"]) is not int or raw["status"] < 0:
+        _refuse("the failed apply report disagrees with its candidate, harness or measured command")
+    measured = managed_execution.collected_report(task, kind="measured", completed=[{"name": "post-import", "status": raw["status"]}], not_run=[], status=raw["status"])
+    if account["report"] != measured or (raw["status"] == 0 and raw["unchanged"]):
+        _refuse("the apply execution has no custody-proved verification failure")
+    return {"phase_digest": digest(phase), "report": raw, "report_digest": digest_of_bytes(body), "artifact": artifact, "collected": collected}
+
+
