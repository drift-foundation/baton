+    def publication_receipt(self, repository, *, publication_id):
+        """Read the immutable receipt, never infer an effect from the target."""
+        reference = self.publication_reference(publication_id)
+        named = self._answer(["git", "-C", _path(repository, "the target repository"),
+                              "rev-parse", "--verify", "--quiet", reference], "publication receipt lookup")
+        if named["returncode"] == 1 and not named["stdout"]:
+            return None
+        if named["returncode"] != 0:
+            _refuse("the publication receipt cannot be read")
+        oid = _object_name(named["stdout"].strip(), "the publication receipt")
+        body = self._run(["git", "-C", repository, "cat-file", "blob", oid], "publication receipt content")
+        try:
+            document = json.loads(body)
+        except (ValueError, TypeError):
+            _refuse("the publication receipt is not a JSON document")
+        return {"object": oid, "reference": reference, "document": document}
+
+    @staticmethod
+    def publication_reference(publication_id):
+        if type(publication_id) is not str or not publication_id or "\x00" in publication_id:
+            _refuse("a publication needs a nonempty identity")
+        return RECEIPT_NAMESPACE + hashlib.sha256(publication_id.encode("utf-8")).hexdigest()
+
+    def publish_with_receipt(self, repository, *, reference, imported, reviewed,
+                             publication_id, receipt, before_commit):
+        """Atomically CAS the configured target and create its exact receipt.
+
+        Receipt object preparation precedes the live grant check. A failed or
+        lost transaction answer remains an unknown effect until receipt recovery.
+        This operation never retries a transaction or rewrites an existing receipt.
+        """
+        repository = _path(repository, "the target repository")
+        reference = _configured_reference(reference)
+        receipt_ref = self.publication_reference(publication_id)
+        if reference.startswith(RECEIPT_NAMESPACE):
+            _refuse("a target reference cannot be a publication receipt")
+        # These names enter the update-ref line protocol, so reject whitespace
+        # and every other invalid ref spelling through Git's own validator.
+        self._run(["git", "check-ref-format", reference], "target reference validation")
+        imported = _object_name(imported, "the imported revision")
+        reviewed = _object_name(reviewed, "the admitted revision")
+        self.held(repository, imported)
+        if not callable(before_commit):
+            _refuse("a publication requires its current-grant check")
+        body = json.dumps(receipt, sort_keys=True, separators=(",", ":"), ensure_ascii=True) + "\n"
+        written = self._answer(["git", "-C", repository, "hash-object", "-w", "--stdin"],
+                               "receipt object creation", input=body.encode("utf-8"))
+        if written["returncode"] != 0:
+            _refuse("the publication receipt object could not be written")
+        oid = _object_name(written["stdout"].strip(), "the receipt object")
+        commands = (f"start\noption no-deref\nupdate {reference} {imported} {reviewed}\n"
+                    f"create {receipt_ref} {oid}\nprepare\ncommit\n").encode("ascii")
+        before_commit()
+        committed = self._answer(["git", "-C", repository, "update-ref", "--stdin"],
+                                 "atomic target publication", input=commands)
+        if committed["returncode"] != 0:
+            _refuse("the target publication did not answer committed; inspect its receipt before any further action")
+        return {"object": oid, "reference": receipt_ref, "document": receipt}
