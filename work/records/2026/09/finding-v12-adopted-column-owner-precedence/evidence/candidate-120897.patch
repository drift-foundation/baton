+def _column_check_span(node, site, kind, label):
+    calls = [n for n in _scope_nodes(node) if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and isinstance(n.func.value, ast.Name) and n.func.value.id == "boundaries" and n.func.attr == kind and len(n.args) > 1 and _label(n.args[1], {}) == label]
+    assert len(calls) == 1, f"duplicate column check needs one {site}/{kind}/{label} call"
+    call = calls[0]
+    return (site, call.lineno, call.col_offset, call.end_lineno, call.end_col_offset)
+
