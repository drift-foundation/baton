+def _column_check_relations(records, entries, sources=None):
+    """Exact witnessed row/repeat pairs, shared by labels and call accounting."""
+    targets = set(entries).intersection(_DUPLICATE_COLUMN_ENTRIES)
+    if not targets:
+        return {}
+    assert set(_DUPLICATE_COLUMN_CHECKS) == set(_DUPLICATE_COLUMN_ENTRIES), "missing or extra duplicate column check declaration"
+    sources = _column_check_sources() if sources is None else sources
+    _column_check_node(sources, "boundaries.py", "__module__", _DUPLICATE_COLUMN_RULE)
+    witnessed = {}
+    for entry in sorted(targets):
+        row_label, helper, kind, label, columns, receiver_hash, helper_hash, column_hash = _DUPLICATE_COLUMN_CHECKS[entry]
+        module, receiver = entry[1].split(":")
+        row_node = _column_check_node(sources, module, receiver, receiver_hash)
+        helper_node = _column_check_node(sources, module, helper, helper_hash)
+        _column_check_node(sources, "schema.py", columns, column_hash)
+        witnessed[entry] = (row_node, helper_node)
+    # Validate every semantic witness before using any source position. A
+    # changed receiver can shift an unchanged receiver's call spans as well.
+    result = {}
+    for entry, (row_node, helper_node) in witnessed.items():
+        row_label, helper, kind, label, *_ = _DUPLICATE_COLUMN_CHECKS[entry]
+        module = entry[1].split(":")[0]
+        row_call = _column_check_span(row_node, entry[1], "row", row_label)
+        repeat_call = _column_check_span(helper_node, module + ":" + helper, kind, label)
+        table = _claims((entry[0], entry[1], entry[2].split(".")[0]))
+        rows = [r for r in records if r.call == row_call and r.site == entry[1] and r.kind == "row" and r.label == row_label and r.subject == table and not r.propagated]
+        repeats = [r for r in records if r.call == repeat_call and r.site == entry[1] and r.kind == kind and r.label == label and r.subject == _claims(entry) and r.propagated]
+        assert len(rows) == len(repeats) == 1, f"missing or ambiguous duplicate column check occurrences for {entry}"
+        result[entry] = (rows[0], repeats[0])
+    return result
