+class DuplicateColumnChecksRequireOwnedWitnesses(unittest.TestCase):
+    def setUp(self):
+        self.records = boundary_occurrences()
+        self.entries = set(_DUPLICATE_COLUMN_ENTRIES)
+        self.sources = tuple((p, t) for p, t in _column_check_sources() if p.name in ("review_cycles.py", "schema.py", "boundaries.py"))
+        self.relations = _column_check_relations(self.records, self.entries, self.sources)
+
+    def changed_source(self, module, before, after):
+        sources = []
+        for path, tree in self.sources:
+            if path.name == module:
+                source = ast.unparse(tree)
+                self.assertIn(before, source)
+                tree = ast.parse(source.replace(before, after, 1))
+            sources.append((path, tree))
+        return tuple(sources)
+
+    def test_two_exact_entries_use_the_same_row_in_labels_and_accounting(self):
+        self.assertEqual(self.entries, {
+            ("adopted", "review_cycles.py:checkpoint_of", "line_checkpoints.fence"),
+            ("adopted", "review_cycles.py:integration_checkpoint", "integration_eligibility.verdict_id"),
+        })
+        claimed = _boundary_claims(self.records, receiving_entries(), DELEGATED)
+        resolved, _ = _account_boundary_calls(self.records, claimed, NOT_AN_ENTRY)
+        for entry, (row, repeat) in self.relations.items():
+            with self.subTest(entry=entry):
+                self.assertEqual(layer_labels(entry), [row.label])
+                self.assertIn(entry, claimed[row])
+                self.assertNotIn(entry, claimed.get(repeat, ()))
+                self.assertEqual(resolved[repeat], {row})
+                self.assertIn(repeat, self.records)
+
+    def test_missing_or_ambiguous_row_or_later_occurrence_refuses(self):
+        for entry, pair in self.relations.items():
+            for occurrence in pair:
+                with self.subTest(entry=entry, kind=occurrence.kind):
+                    with self.assertRaisesRegex(AssertionError, "missing or ambiguous"):
+                        _column_check_relations(self.records - {occurrence}, self.entries, self.sources)
+                    with self.assertRaisesRegex(AssertionError, "missing or ambiguous"):
+                        _column_check_relations(list(self.records) + [occurrence], self.entries, self.sources)
+
+    def test_a_relation_without_its_claimed_row_cannot_discharge_the_repeat(self):
+        claimed = _boundary_claims(self.records, receiving_entries(), DELEGATED)
+        for entry, (row, _) in self.relations.items():
+            changed = {r: set(owners) for r, owners in claimed.items()}
+            changed[row].remove(entry)
+            with self.subTest(entry=entry), self.assertRaisesRegex(AssertionError, "no claimed row owner"):
+                _account_boundary_calls(self.records, changed, NOT_AN_ENTRY)
+
+    def test_missing_declaration_or_source_witness_refuses(self):
+        with patch.dict(_DUPLICATE_COLUMN_CHECKS, {}, clear=True):
+            with self.assertRaisesRegex(AssertionError, "declaration"):
+                _column_check_relations(self.records, self.entries, self.sources)
+        for module in ("review_cycles.py", "schema.py", "boundaries.py"):
+            with self.subTest(module=module), self.assertRaisesRegex(AssertionError, "needs one"):
+                _column_check_relations(self.records, self.entries, tuple((p, t) for p, t in self.sources if p.name != module))
+
+    def test_unchanged_ast_uses_current_call_spans_and_ambiguous_sources_refuse(self):
+        import copy
+        shifted = tuple((p, ast.increment_lineno(copy.deepcopy(t), 7) if p.name == "review_cycles.py" else t) for p, t in self.sources)
+        records = {r._replace(call=(r.call[0], r.call[1] + 7, r.call[2], r.call[3] + 7, r.call[4])) if r.call[0].startswith("review_cycles.py:") else r for r in self.records}
+        relations = _column_check_relations(records, self.entries, shifted)
+        for entry, pair in relations.items():
+            for before, after in zip(self.relations[entry], pair):
+                self.assertEqual(after.call[1], before.call[1] + 7)
+                self.assertEqual(after.subject, before.subject)
+        with self.assertRaisesRegex(AssertionError, "needs one"):
+            _column_check_relations(self.records, self.entries, self.sources + self.sources)
+
+    def test_source_changes_require_fresh_review_instead_of_refreshing_witnesses(self):
+        changes = (
+            ("review_cycles.py", "taken = boundaries.row(row, 'a persisted line checkpoint', schema.LINE_CHECKPOINT_COLUMNS)", "taken = dict(row)"),
+            ("review_cycles.py", "boundaries.identity(verdict_id, 'a checkpoint verdict identity')", "str(verdict_id)"),
+            ("review_cycles.py", "if taken['fence'] is not None:", "if True:"),
+            ("review_cycles.py", "_verdict_row(store, owned['verdict_id'])", "_verdict_row(store, line_id)"),
+            ("review_cycles.py", "verdict = _verdict_row(store, owned['verdict_id'])", "owned = other\n    verdict = _verdict_row(store, owned['verdict_id'])"),
+            ("review_cycles.py", "required=('intent', 'fenced')", "required=('intent', 'fenced', 'extra')"),
+            ("schema.py", "INTEGRATION_ELIGIBILITY_COLUMNS =", "OTHER_ELIGIBILITY_COLUMNS ="),
+            ("schema.py", "'fence': Column('json', nullable=True, members=('intent', 'fenced'))", "'fence': Column('text')"),
+            ("schema.py", "'fence': Column('json', nullable=True, members=('intent', 'fenced'))", "'fence': Column('json', nullable=True, members=('intent',))"),
+            ("boundaries.py", "if type(value) is not str or value == '':", "if type(value) is not str:"),
+        )
+        for module, before, after in changes:
+            with self.subTest(module=module, before=before):
+                sources = self.changed_source(module, before, after)
+                with self.assertRaisesRegex(AssertionError, "stale duplicate|needs one"):
+                    _column_check_relations(self.records, self.entries, sources)
+
+    def test_an_unrelated_same_label_call_and_another_origin_cannot_borrow_the_link(self):
+        claimed = _boundary_claims(self.records, receiving_entries(), DELEGATED)
+        extras = set()
+        for _, repeat in self.relations.values():
+            extras.add(repeat._replace(call=("unrelated.py:_check", 1, 0, 1, 1)))
+            extras.add(repeat._replace(site="unrelated.py:public", subject="read:unrelated.py:public|table[value]"))
+        resolved, residual = _account_boundary_calls(self.records | extras, claimed, NOT_AN_ENTRY)
+        self.assertTrue(extras.issubset(residual))
+        self.assertFalse(extras.intersection(resolved))
+
+    def test_identity_column_and_later_rule_are_identical_and_the_row_owns_a_fresh_value(self):
+        self.assertEqual(schema.INTEGRATION_ELIGIBILITY_COLUMNS["verdict_id"].kind, "identity")
+        self.assertIs(boundaries._COLUMN_RULE["identity"], boundaries.identity)
+        for value in ("verdict", "", [], SURROGATE):
+            with self.subTest(value=value):
+                raw = {"verdict_id": value}
+                if value == "verdict":
+                    taken = boundaries.row(raw, "row", {"verdict_id": schema.INTEGRATION_ELIGIBILITY_COLUMNS["verdict_id"]})
+                    self.assertIsNot(taken, raw)
+                    self.assertEqual(boundaries.identity(taken["verdict_id"], "later"), value)
+                else:
+                    for run in (lambda: boundaries.row(raw, "row", {"verdict_id": schema.INTEGRATION_ELIGIBILITY_COLUMNS["verdict_id"]}), lambda: boundaries.identity(value, "later")):
+                        with self.assertRaises(ContractRefusal) as caught:
+                            run()
+                        self.assertEqual((caught.exception.category, caught.exception.code), ("integrity", "schema"))
+
+    def test_row_result_flow_and_nullable_guard_match_the_reviewed_relations(self):
+        tree = next(t for p, t in self.sources if p.name == "review_cycles.py")
+        functions = dict(_functions(tree, "review_cycles.py"))
+        receiver = functions["review_cycles.py:integration_checkpoint"]
+        assignments = [n for n in receiver.body if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "owned" for t in n.targets)]
+        self.assertEqual(len(assignments), 1)
+        self.assertEqual(ast.unparse(assignments[0].value), "boundaries.row(eligibility_row, 'persisted integration eligibility', schema.INTEGRATION_ELIGIBILITY_COLUMNS)")
+        calls = [n for n in ast.walk(receiver) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == "_verdict_row"]
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(ast.unparse(calls[0].args[1]), "owned['verdict_id']")
