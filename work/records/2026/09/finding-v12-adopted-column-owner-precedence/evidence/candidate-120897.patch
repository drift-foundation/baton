+def _column_check_node(sources, module, symbol, fingerprint):
+    trees = [tree for path, tree in sources if path.name == module]
+    assert len(trees) == 1, f"duplicate column check needs one {module} source"
+    nodes = trees if symbol == "__module__" else [n for n in trees[0].body if getattr(n, "name", None) == symbol or isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == symbol for t in n.targets)]
+    assert len(nodes) == 1, f"duplicate column check needs one {module}:{symbol} witness"
+    assert _contracts_digest(ast.dump(nodes[0], include_attributes=False)) == fingerprint, f"stale duplicate column check witness {module}:{symbol}; fresh review required"
+    return nodes[0]
+
