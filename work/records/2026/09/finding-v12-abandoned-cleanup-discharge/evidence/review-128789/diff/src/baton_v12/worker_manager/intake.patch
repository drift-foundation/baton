+def _abandoned_fence(taken, expect, what):
+    """The authority's own fence answer, owned and related to this attempt.
+
+    `AuthorityPort.cancel` already proved these members when the act ran; this
+    is a READ of what it committed, and a read that adopted the answer would
+    be trusting a stored value rather than owning it. What is compared is the
+    same relationship `cancel` compared: the fence is about THIS assignment,
+    and the gate it installed is the one this attempt's own generation
+    composes.
+    """
+    fence = boundaries.document(taken, f"{what}'s committed fence",
+                                required=FENCE)
+    if not fence["fenced"]:
+        raise ContractRefusal(
+            "integrity", "schema",
+            f"{what} records a fence answer that did not fence; an "
+            f"abandonment that never ended its generation has no gate of its "
+            f"own to discharge")
+    if fence["assignment"] != expect:
+        raise ContractRefusal(
+            "integrity", "schema",
+            f"{what} records a fence of assignment "
+            f"{name_value(fence['assignment'])} and this attempt is fixed to "
+            f"{name_value(expect)}; a fence that ended somebody else's "
+            f"assignment is not this abandonment's")
+    gate = _quiescence_gate_token(expect)
+    if fence["gate"] != gate:
+        raise ContractRefusal(
+            "integrity", "schema",
+            f"{what} records gate {name_value(fence['gate'])} and this "
+            f"attempt's own generation composes {name_value(gate)}")
+    return fence
