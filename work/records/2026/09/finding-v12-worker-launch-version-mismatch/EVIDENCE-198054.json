  "R3_absence_and_cleanup": {
    "finding": "gone() answered absent=true for EVERY non-zero docker inspect; remove() ignored stop/rm statuses; held_open had no enclosing finally after Popen; and it removed whatever held the name without establishing ownership",
    "measured_engine_behaviour": {
      "missing_object": "returncode 1, stdout '[]', stderr 'error: no such object: <name>'",
      "daemon_unavailable": "returncode 1, stdout '[]', stderr 'failed to connect to the docker API at ...'",
      "consequence": "a daemon outage during cleanup would have been recorded as 'removed, confirmed absent'"
    },
    "correction": "positive absence or uncertain, decided by the manager's own oci._absent_prose imported rather than copied; a taken name is refused rather than removed; the container is owned by the engine-reported ID and every later act names it; cleanup in a finally, retaining the engine's own stop, rm and final-look answers, attached to a primary failure rather than replacing it",
    "fake_engine_regression": {
      "claims_a_free_name": true,
      "claims_a_taken_name": true,
      "claims_a_unknown_name": true,
      "cleanup_not_claimed_when_uncertain": true,
      "cleanup_proved_when_absent": true,
      "cleanup_refuses_a_foreign_absence_sentence": true,
      "cleanup_retains_engine_answers": true,
      "cleanup_survives_an_unrunnable_engine": true,
      "daemon_unavailable_is_uncertain": true,
      "foreign_absence_is_uncertain": true,
      "matching_absence_is_absent": true,
      "not_json_is_uncertain": true,
      "permission_denied_is_uncertain": true,
      "present_is_present": true,
      "two_objects_for_one_identity_is_uncertain": true
    },
    "note": "the first run of this helper FAILED its own absence regression because the fixture freed one identity against an absence sentence naming another -- the rule refusing a foreign sentence, which is the rule working. The fixture was corrected, not the rule."
  },
