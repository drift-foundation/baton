+def _authority_account(job, verdict, attachment, review, table):
+    """What the accepted records say about each row that needs saying-about.
+
+    W114085. THE PRODUCER STATES; IT DOES NOT DECIDE. Every grant here names an
+    accepted owner's own answer -- today the accepted Job's scheduled test
+    scope, which `job_manager/documents` calls "the bounded test-change
+    authority a later reviewer and integrator check a proposal against". The
+    workload still decides the import.
+
+    AND WHERE NO OWNER EXISTS, THIS REFUSES. A mode change and an executable
+    addition have no accepted scope anywhere in this build: the Job carries
+    `test_scope` and nothing else per-path. Publishing such a candidate would
+    mean either shipping an unauthorized change or inventing the authority for
+    it, so the bundle is not published and the gap is named exactly.
+    """
+    scope = list(job["test_scope"])
+    rows = []
+    for row in table:
+        requires = _required_authority(row, scope)
+        if not requires:
+            continue
+        grants = []
+        for requirement in requires:
+            entry = _grant(requirement, row["path"], scope)
+            if entry is None:
+                _gap(f"reviewed path {name_value(row['path'])} requires "
+                     f"{requirement} authority and no accepted record in this "
+                     f"build supplies it; the accepted Job carries a test "
+                     f"scope and no mode or executable scope, so this "
+                     f"candidate is refused rather than published without the "
+                     f"authority it needs")
+            grants.append({"requirement": requirement,
+                           "kind": "job-test-scope", "entry": entry})
+        rows.append({"path": row["path"], "operation": row["operation"],
+                     "base_mode": row["base"]["mode"] if row["base"] else None,
+                     "candidate_mode": (row["candidate"]["mode"]
+                                        if row["candidate"] else None),
+                     "requires": requires, "authorized_by": grants})
+    return {"schema": AUTHORITY_SCHEMA,
+            "scope": {"job_id": job["job_id"], "stage_id": job["stage_id"],
+                      "work_id": job["work_id"],
+                      "scope_digest": job["scope_digest"],
+                      "test_scope": scope},
+            "review": {"verdict_id": verdict["verdict_id"],
+                       "attachment_id": verdict["attachment_id"],
+                       "disposition": verdict["disposition"],
+                       "reviewer_participant":
+                           attachment["reviewer_participant"],
+                       "result_id": verdict["review_result"]["result_id"],
+                       "result_digest": verdict["review_result_digest"],
+                       "documents": review["documents"]},
+            "paths": rows}
+
+
+def _within_scope(path, scope):
+    """A scope entry is a directory, matched at a COMPONENT boundary."""
+    return any(path == one or path.startswith(one.rstrip("/") + "/")
+               for one in scope)
+
+
+def _required_authority(row, scope):
+    """What one reviewed row needs somebody to have decided, and nothing else.
+
+    NO FILENAME IS INSPECTED. The accepted scope is the enumeration, so
+    membership in it is both what makes a test change need authority and what
+    supplies it; a heuristic over names would be this producer inventing the
+    reviewed enumeration it is supposed to be carrying.
+    """
+    needs = set()
+    base, candidate = row["base"], row["candidate"]
+    if row["operation"] in ("edit", "delete") and _within_scope(row["path"],
+                                                                scope):
+        needs.add("existing-test")
+    if base is not None and candidate is not None \
+            and base["mode"] != candidate["mode"]:
+        needs.add("mode-change")
+    if base is None and candidate is not None \
+            and candidate["mode"] == "100755":
+        needs.add("executable-addition")
+    return sorted(needs)
+
+
+def _grant(requirement, path, scope):
+    """The accepted entry that supplies one requirement, or None."""
+    if requirement != "existing-test":
+        return None
+    for one in scope:
+        if _within_scope(path, [one]):
+            return one
+    return None
 
 
