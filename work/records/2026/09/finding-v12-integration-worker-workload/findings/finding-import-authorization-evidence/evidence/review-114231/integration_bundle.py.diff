+def _scratch(place):
+    """One private tree beside the destination, this producer's own.
+
+    THE SAME RULES AS THE STAGING NAME, for the same reason: an existing one
+    means a previous publication stopped here and an operator decides what
+    happened to it, rather than this call reusing a directory it did not make.
+    It is created at 0700 and removed whichever way the composition ends, and
+    nothing consumable ever exists at it.
+    """
+    scratch = place + ".review"
+    if os.path.lexists(scratch):
+        _refuse(f"{name_value(scratch)} already exists; a previous "
+                f"publication stopped and an operator decides what happened "
+                f"to it", category="refused", code="operation-collision")
+    os.mkdir(scratch, STAGING_DIR)
+    return scratch
 
 
