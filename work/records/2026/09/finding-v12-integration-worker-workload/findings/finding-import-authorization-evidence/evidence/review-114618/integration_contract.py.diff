+
+def _canonical(value, depth=0):
+    if depth > 64:
+        _refuse("a measured document nests deeper than this reader digests")
+    if value is None:
+        return "null"
+    kind = type(value)
+    if kind is bool:
+        return "true" if value else "false"
+    if kind is int:
+        if value < 0 or value > 2 ** 53 - 1:
+            _refuse("a measured document carries a number outside the "
+                    "canonical value space")
+        return str(value)
+    if kind is str:
+        try:
+            value.encode("utf-16-be")
+        except UnicodeEncodeError:
+            _refuse("a measured document carries a lone UTF-16 surrogate")
+        return json.dumps(value, ensure_ascii=False)
+    if kind is list:
+        if len(value) > 512:
+            _refuse("a measured array is above the frozen canonical limit")
+        return "[" + ",".join(_canonical(one, depth + 1)
+                              for one in value) + "]"
+    if kind is dict:
+        if len(value) > 512:
+            _refuse("a measured object is above the frozen canonical limit")
+        names = sorted(value, key=lambda one: one.encode("utf-16-be"))
+        return "{" + ",".join(f"{json.dumps(one, ensure_ascii=False)}:"
+                              f"{_canonical(value[one], depth + 1)}"
+                              for one in names) + "}"
+    _refuse("a measured document carries a value canonical JSON has no "
+            "representation for")
+
+
+def canonical_digest(value):
+    """The identity the frozen owners took theirs in."""
+    from hashlib import sha256
+
+    return "sha256:" + sha256(
+        _canonical(value).encode("utf-8")).hexdigest()
+
