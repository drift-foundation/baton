+def _held_directory(path, what):
+    """One descriptor for `path`, walked from `/` a component at a time.
+
+    W114085 review 2026-09-07T23:16:55Z [P1]. The first version compared the
+    locator's LEXICAL prefix with the configured store and then handed the
+    pathname to `workspaces.copied_manifest`, whose `_real` resolves the root
+    with `realpath` before its own descriptor-safe walk begins. That walk is
+    safe for DESCENDANTS and says nothing about the root or its ancestors, so
+    a symlink anywhere above the custody directory was followed -- and the
+    reviewer's probe published a bundle whose review files came from outside
+    configured storage entirely.
+
+    THE OWNER GAP, RECORDED RATHER THAN WORKED AROUND: no public capability in
+    this build measures or copies a tree through a HELD directory identity.
+    `directory_manifest` and `copied_manifest` both take a pathname and
+    realpath it. Editing them is generic-core work this Work is not authorized
+    to do, so this module walks and measures through its own descriptors, and
+    a conformance case holds its measurement equal to `directory_manifest`'s
+    on a tree with no links at all.
+
+    `realpath` IS DELIBERATELY NOT USED. It resolves a link and hands back the
+    target, which ACCEPTS the escape rather than refusing it.
+    """
+    if type(path) is not str or not path or not os.path.isabs(path) \
+            or os.path.normpath(path) != path or path.startswith("//"):
+        _refuse(f"{what} is one canonical absolute path",
+                category="integrity", code="path")
+    holder = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    opened = [holder]
+    try:
+        for name in [one for one in path.split("/") if one]:
+            try:
+                holder = os.open(name, os.O_RDONLY | os.O_DIRECTORY
+                                 | os.O_NOFOLLOW, dir_fd=holder)
+            except OSError as failed:
+                _denied(f"{what} is not reachable without following a link "
+                        f"({failed.errno}); {name!r} is a link, a file or "
+                        f"absent")
+            opened.append(holder)
+        return opened.pop()
+    finally:
+        for one in opened:
+            os.close(one)
+
+
+def _measured_tree(holder, what, *, prefix="", entries=None, content=None,
+                   depth=0):
+    """Every regular file under a HELD directory, measured as it is read.
+
+    ONE PASS AND NO SECOND LOOK. The bytes that are digested are the bytes
+    that are kept: there is no measure-then-reopen window for a replacement to
+    land in, which is the shape `copied_manifest` exists to provide and the
+    reason this does not measure with one call and read with another.
+
+    THE SPELLING IS `directory_manifest`'S, deliberately: relative paths sorted
+    bytewise, `digest_of_bytes` per file, and `digest(entries)` as the tree
+    identity -- because the frozen review recorded its `content_digest` with
+    that owner and a second spelling here would be a comparison that could
+    never succeed.
+    """
+    entries = [] if entries is None else entries
+    content = {} if content is None else content
+    if depth > MAX_REVIEW_DEPTH:
+        _refuse(f"{what} nests deeper than this contract measures")
+    for name in sorted(os.listdir(holder)):
+        held = os.stat(name, dir_fd=holder, follow_symlinks=False)
+        relative = name if not prefix else f"{prefix}/{name}"
+        if stat.S_ISDIR(held.st_mode):
+            try:
+                child = os.open(name, os.O_RDONLY | os.O_DIRECTORY
+                                | os.O_NOFOLLOW, dir_fd=holder)
+            except OSError as failed:
+                _denied(f"{what} carries {relative!r}, which is not a "
+                        f"directory this reader can enter without following a "
+                        f"link ({failed.errno})")
+            try:
+                _measured_tree(child, what, prefix=relative, entries=entries,
+                               content=content, depth=depth + 1)
+            finally:
+                os.close(child)
+            continue
+        if not stat.S_ISREG(held.st_mode):
+            _denied(f"{what} carries {relative!r}, which is neither a "
+                    f"directory nor a regular file; custody this producer "
+                    f"cannot account for is not custody it publishes")
+        if len(entries) >= MAX_REVIEW_FILES:
+            _refuse(f"{what} holds more than the bound of "
+                    f"{MAX_REVIEW_FILES} files")
+        payload = _read_held(holder, name, relative, what)
+        entries.append({"path": relative, "bytes": len(payload),
+                        "content_digest": digest_of_bytes(payload)})
+        content[relative] = payload
+    entries.sort(key=lambda one: one["path"].encode("utf-8"))
+    total = sum(one["bytes"] for one in entries)
+    if total > MAX_REVIEW_BYTES:
+        _refuse(f"{what} holds {total} bytes, above the bound of "
+                f"{MAX_REVIEW_BYTES}")
+    return {"entries": entries, "entry_count": len(entries),
+            "total_bytes": total, "tree_digest": digest(entries),
+            "content": content}
+
+
+def _read_held(holder, name, relative, what):
+    """One regular file, proved on the descriptor that reads it."""
+    try:
+        handle = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
+                         dir_fd=holder)
+    except OSError as failed:
+        _denied(f"{what} carries {relative!r}, which is not readable as an "
+                f"ordinary file ({failed.errno})")
+    try:
+        held = os.fstat(handle)
+        if not stat.S_ISREG(held.st_mode):
+            _denied(f"{what} carries {relative!r}, which is not a regular "
+                    f"file")
+        if held.st_size > MAX_REVIEW_BYTES:
+            _refuse(f"{what} carries {relative!r} at {held.st_size} bytes, "
+                    f"above the bound of {MAX_REVIEW_BYTES}")
+        os.set_blocking(handle, True)
+        payload = b""
+        while True:
+            chunk = os.read(handle, 65536)
+            if not chunk:
+                break
+            payload += chunk
+            if len(payload) > MAX_REVIEW_BYTES:
+                _refuse(f"{what} carries {relative!r} above the bound of "
+                        f"{MAX_REVIEW_BYTES}")
+        if len(payload) != held.st_size:
+            _refuse(f"{what} carries {relative!r}, which changed size while "
+                    f"it was read")
+        return payload
+    finally:
+        os.close(handle)
+
