+def _review_documents(manager, verdict):
+    """Every byte of the frozen independent review, out of manager custody.
+
+    W114085. WHAT WAS MISSING AND WHY IT MATTERS. `review.json` carried the
+    reviewer's frozen output REFERENCES -- an artifact id, a tree digest and a
+    `file://` locator into manager custody -- and a container cannot read a
+    host path. So the bundle asserted that an independent review existed and
+    gave the runtime no way to read what it said, which is exactly the
+    authority a scheduled existing-test change needs.
+
+    THE LOCATOR IS CHECKED, NEVER TRUSTED, AND CONTAINMENT IS PHYSICAL. The
+    configured store and the custody directory are each walked from `/` one
+    component at a time with `O_NOFOLLOW`, so neither can be reached through a
+    link; only then does lexical containment mean anything, because a
+    link-free path that is lexically inside a link-free root IS inside it.
+    Every byte is then read through the descriptor that walk produced.
+    """
+    from baton_v12.contracts.manifest import check_uri
+    from baton_v12.worker_manager.workspaces import (
+        configured_workspace_storage)
+
+    frozen = verdict["review_result"]
+    artifacts = frozen["artifacts"]
+    if type(artifacts) is not list or len(artifacts) > MAX_REVIEW_OUTPUTS:
+        _refuse(f"a frozen review carries at most {MAX_REVIEW_OUTPUTS} "
+                f"collected outputs; this one carries {len(artifacts)}")
+    storage = configured_workspace_storage(manager).place
+    # THE STORE ITSELF, PROVED FIRST. A configured store reached through a
+    # link is a store this deployment cannot hold anything to.
+    os.close(_held_directory(storage, "the configured workspace store"))
+    documents = []
+    held = {}
+    counted = 0
+    measured = 0
+    for artifact in sorted(artifacts, key=lambda one: one["output_name"]):
+        name = artifact["output_name"]
+        if type(name) is not str or not name or "/" in name \
+                or name in (".", ".."):
+            _refuse("a collected review output is named by one ordinary name")
+        check_uri(artifact["locator"], f"review output {name}'s locator")
+        if not artifact["locator"].startswith("file:///"):
+            _gap(f"review output {name} is not held at a local custody path")
+        place = artifact["locator"][len("file://"):]
+        what = f"review output {name}'s custody directory"
+        if os.path.normpath(place) != place \
+                or not (place == storage
+                        or place.startswith(storage.rstrip("/") + "/")):
+            _gap(f"review output {name} is held at {name_value(place)}, which "
+                 f"is not inside the workspace store this deployment "
+                 f"configured; a public locator is not host access")
+        holder = _held_directory(place, what)
+        try:
+            copied = _measured_tree(holder, what)
+        finally:
+            os.close(holder)
+        if copied["tree_digest"] != artifact["content_digest"] \
+                or copied["total_bytes"] != artifact["bytes"]:
+            _drifted(f"review output {name} does not measure to the identity "
+                     f"the frozen review recorded for it")
+        counted += copied["entry_count"]
+        measured += copied["total_bytes"]
+        if counted > MAX_REVIEW_FILES or measured > MAX_REVIEW_BYTES:
+            _refuse(f"this review materializes {counted} files and "
+                    f"{measured} bytes, above the bounds of "
+                    f"{MAX_REVIEW_FILES} and {MAX_REVIEW_BYTES}")
+        files = []
+        for entry in copied["entries"]:
+            payload = copied["content"][entry["path"]]
+            try:
+                rendered = payload.decode("utf-8")
+            except UnicodeDecodeError:
+                # NOT WRAPPED INTO READABILITY. A reviewer's evaluation of a
+                # test change is prose; a review document this producer cannot
+                # decode is an operator's case, and encoding it would publish
+                # something no runtime can actually read and evaluate.
+                _gap(f"review file {name}/{entry['path']} is not UTF-8 text; "
+                     f"this build carries the independent review's own words "
+                     f"and does not encode material it cannot render")
+            files.append({"path": entry["path"], "bytes": entry["bytes"],
+                          "digest": _address(payload), "text": rendered})
+            held[(name, entry["path"])] = payload
+        documents.append({"output_name": name,
+                          "tree_digest": copied["tree_digest"],
+                          "bytes": copied["total_bytes"],
+                          "entry_count": copied["entry_count"],
+                          "files": files})
+    return {"documents": documents, "content": held}
+
