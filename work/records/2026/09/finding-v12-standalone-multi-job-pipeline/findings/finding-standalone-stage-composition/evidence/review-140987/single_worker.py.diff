+def effective_engine_run(engine_run=None):
+    """The engine runner this module would ACTUALLY use, named publicly.
+
+    W103068 review 2026-09-11T02-06-10Z [P1]. `worker_operations` resolves
+    `engine_run or _engine_run` privately, so a composer that passed its own
+    `engine_run` through to a second consumer passed `None` whenever the caller
+    had supplied nothing -- and the production `factory` supplies nothing. The
+    integration runtime port then refused for want of an engine capability, on
+    the one entry point that is supposed to work by default.
+
+    IT IS THE SAME EXPRESSION AND NOT A SECOND OPINION. Injected overrides and
+    ordinary defaults converge here by construction, which is exactly what the
+    pinned design requires: one boundary answers what this module runs
+    containers with, and `worker_operations` below resolves through it.
+    """
+    return engine_run or _engine_run
+
