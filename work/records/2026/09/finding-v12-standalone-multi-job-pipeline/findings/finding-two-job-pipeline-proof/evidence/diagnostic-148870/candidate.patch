+def _supported_detail(given):
+    """Reconstruct the reviewed adapter contract; never trust arbitrary report prose."""
+    keys = {'schema', 'http_status', 'classification', 'explanation', 'explanation_status', 'request_id', 'request_id_status'}
+    if not isinstance(given, dict) or set(given) != keys or given['schema'] != 'baton.provider-diagnostic/1':
+        return None
+    code = given['http_status']
+    if code is not None and (type(code) is not int or not 400 <= code <= 599):
+        return None
+    if given['request_id'] is not None or given['request_id_status'] != 'unavailable':
+        return None
+    recognized = given['classification'] == 'authentication_failed' and given['explanation'] == _OAUTH_EXPLANATION and given['explanation_status'] == 'supported-constant'
+    unknown = given['classification'] == 'unknown' and given['explanation'] is None and given['explanation_status'] in ('unavailable', 'withheld')
+    if not (recognized or unknown):
+        return None
+    return {'schema': 'baton.provider-diagnostic/1', 'http_status': code,
+            'classification': 'authentication_failed' if recognized else 'unknown',
+            'explanation': _OAUTH_EXPLANATION if recognized else None,
+            'explanation_status': 'supported-constant' if recognized else ('withheld' if given['explanation_status'] == 'withheld' else 'unavailable'),
+            'request_id': None, 'request_id_status': 'unavailable'}
