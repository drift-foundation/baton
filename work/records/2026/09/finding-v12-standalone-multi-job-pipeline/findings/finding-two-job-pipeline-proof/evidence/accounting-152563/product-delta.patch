+class ReadonlyAcquisition(StoreCase):
+    def read(self, path=None, clock=None):
+        held = ControlStore.open_readonly(path or self.path, incarnation='read-only-test', clock=clock or (lambda: NOW))
+        self.addCleanup(held.close)
+        return held
+
+    def test_existing_store_preserves_bytes_and_journal_without_initialization(self):
+        self.store().close()
+        with sqlite3.connect(self.path) as prepared:
+            prepared.execute('PRAGMA journal_mode=DELETE')
+        before = self.bytes_at(self.path)
+        with mock.patch.object(ControlStore, '_initialize', side_effect=AssertionError('initialize')), mock.patch.object(ControlStore, '_request_wal', side_effect=AssertionError('journal mode')):
+            held = self.read()
+            self.assertEqual('delete', held._connection.execute('PRAGMA journal_mode').fetchone()[0])
+            with self.assertRaises(sqlite3.OperationalError):
+                held._connection.execute("INSERT INTO meta VALUES ('forbidden','write')")
+            held.close()
+        self.assertEqual(before, self.bytes_at(self.path))
+
+    def test_missing_empty_foreign_version_and_unreadable_stores_refuse(self):
+        missing = os.path.join(self.root, 'missing.sqlite3')
+        with self.assertRaises(ContractRefusal): self.read(missing)
+        self.assertFalse(os.path.exists(missing))
+        cases = [self.foreign_store('empty.sqlite3', []), self.foreign_store('foreign.sqlite3', ['CREATE TABLE stranger (value TEXT)'])]
+        self.store().close()
+        with sqlite3.connect(self.path) as changed:
+            changed.execute("UPDATE meta SET value='unsupported' WHERE key='schema_version'")
+        cases.append(self.path)
+        garbage = os.path.join(self.root, 'garbage.sqlite3')
+        with open(garbage, 'wb') as output: output.write(b'not a database')
+        cases.append(garbage)
+        for path in cases:
+            before = self.bytes_at(path)
+            with self.subTest(path=path), self.assertRaises(ContractRefusal): self.read(path)
+            self.assertEqual(before, self.bytes_at(path))
+
