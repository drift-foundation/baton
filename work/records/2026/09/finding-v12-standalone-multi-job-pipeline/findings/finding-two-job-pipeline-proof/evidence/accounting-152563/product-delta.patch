+    @classmethod
+    def open_readonly(cls, path, *, incarnation, clock):
+        """Read an existing recognized manager; never initialize or change it.
+
+        SQLite owns its WAL/SHM coordination files, as for the Authority and
+        coordinator read-only openers. The database connection is mode=ro,
+        never immutable and never reopened with write access on a refusal.
+        """
+        boundaries.text(path, "a read-only control store path")
+        boundaries.text(incarnation, "a manager incarnation")
+        boundaries.capability(clock, "the manager's instant source")
+        if not os.path.isfile(path):
+            raise ContractRefusal("refused", "precondition", "a read-only manager requires an existing regular store")
+        connection = None
+        try:
+            uri = "file:" + quote(os.path.abspath(path), safe="/") + "?mode=ro"
+            connection = sqlite3.connect(uri, uri=True, isolation_level=None, timeout=_BUSY_TIMEOUT_MS / 1000)
+            connection.row_factory = sqlite3.Row
+            connection.execute(f"PRAGMA busy_timeout = {_BUSY_TIMEOUT_MS}")
+            connection.execute("PRAGMA foreign_keys = ON")
+            store = cls(connection, incarnation=incarnation, clock=clock, readonly=True)
+            with store.snapshot():
+                if not cls._objects(connection):
+                    raise ContractRefusal("refused", "precondition", "a read-only manager refuses an empty store without initializing it")
+                cls._adopt(connection, path)
+            store._now()
+            return store
+        except BaseException as failure:
+            if connection is not None:
+                try:
+                    connection.close()
+                except BaseException:
+                    pass
+            if isinstance(failure, sqlite3.Error):
+                raise ContractRefusal("refused", "precondition", "the existing manager store could not be read through its non-writing opener (" + type(failure).__name__ + "); no write-capable fallback was attempted") from None
+            raise
+
+    @contextmanager
+    def snapshot(self):
+        """Keep related owner reads coherent, including nested readers.
+
+        No action is allowed inside this read boundary, even on an ordinary
+        handle. A caller already inside an action keeps that action's snapshot;
+        this context never commits or rolls back its caller's transaction.
+        """
+        connection = self._connection
+        owns = not connection.in_transaction
+        if owns:
+            connection.execute("BEGIN")
+        self._snapshots += 1
+        try:
+            yield self
+            if owns:
+                connection.execute("COMMIT")
+        except BaseException:
+            if owns:
+                try:
+                    connection.execute("ROLLBACK")
+                except BaseException:
+                    pass
+            raise
+        finally:
+            self._snapshots -= 1
