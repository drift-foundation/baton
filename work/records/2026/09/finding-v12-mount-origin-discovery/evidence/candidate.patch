+class DeclaredMountOriginsStayWithTheirElements(unittest.TestCase):
+    def entries(self, body):
+        source = pathlib.Path("sample.py")
+        tree = ast.parse('''
+def _view(mount):
+    return mount["source"], mount["target"], mount["writable"]
+def public(adapter, other, supplied):
+''' + body)
+        returned = _returned_origins([(source, tree)])
+        node = dict(_functions(tree, source.name))["sample.py:public"]
+        local = _origins(node, "sample.py:public", returned)
+        return _through_helpers({}, "sample.py:public", node, local, _helpers(tree, source.name), returns=returned)
+
+    def expected(self, receiver="adapter"):
+        return {("caller", "sample.py:public", f"{receiver}.mounts.{member}") for member in ("source", "target", "writable")}
+
+    def test_literal_mount_member_survives_direct_iteration(self):
+        self.assertEqual(self.entries('''
+    plan = getattr(adapter, "mounts", None)
+    for mount in plan:
+        _view(mount)
+'''), self.expected())
+
+    def test_selected_mounts_keep_their_origin_through_append_and_index(self):
+        self.assertEqual(self.entries('''
+    plan = getattr(adapter, "mounts", None)
+    landing = []
+    for mount in plan:
+        one = boundaries.document(mount, "a mount")
+        if one:
+            landing.append(one)
+    if landing:
+        _view(landing[0])
+'''), self.expected())
+
+    def test_a_direct_list_alias_carries_the_same_appended_elements(self):
+        self.assertEqual(self.entries('''
+    landing = []
+    alias = landing
+    for mount in getattr(adapter, "mounts", None):
+        alias.append(mount)
+    _view(landing[0])
+'''), self.expected())
+
+    def test_clear_and_reassignment_remove_the_old_element_origin(self):
+        for change in ("landing.clear()", "alias.clear()", "landing = []", "landing = supplied"):
+            with self.subTest(change=change):
+                self.assertEqual(self.entries(f'''
+    landing = []
+    alias = landing
+    for mount in getattr(adapter, "mounts", None):
+        landing.append(mount)
+    {change}
+    _view(landing[0])
+'''), set() if change != "landing = supplied" else {
+                    ("caller", "sample.py:public", f"supplied.{member}") for member in ("source", "target", "writable")})
+
+    def test_reassigned_alias_cannot_mutate_the_old_list(self):
+        self.assertEqual(self.entries('''
+    landing = []
+    alias = landing
+    alias = []
+    for mount in getattr(adapter, "mounts", None):
+        alias.append(mount)
+    _view(landing[0])
+'''), set())
+
+    def test_loop_target_rebinding_cannot_keep_an_old_list_identity(self):
+        self.assertEqual(self.entries('''
+    landing = []
+    for landing in getattr(adapter, "mounts", None):
+        landing.append(other)
+        _view(landing[0])
+'''), self.expected())
+
+    def test_unknown_collection_cannot_borrow_appended_mount_origins(self):
+        self.assertEqual(self.entries('''
+    for mount in getattr(adapter, "mounts", None):
+        supplied.append(mount)
+    _view(supplied[0])
+'''), {("caller", "sample.py:public", f"supplied.{member}") for member in ("source", "target", "writable")})
+
+    def test_other_receiver_and_nonliteral_getattr_do_not_become_adapter_mounts(self):
+        self.assertEqual(self.entries('''
+    for mount in getattr(other, "mounts", None):
+        _view(mount)
+'''), self.expected("other"))
+        self.assertEqual(self.entries('''
+    for mount in getattr(adapter, supplied, None):
+        _view(mount)
+'''), {("caller", "sample.py:public", f"adapter.{member}") for member in ("source", "target", "writable")})
+
+    def test_callable_presence_getattr_keeps_the_existing_adapter_subject(self):
+        expression = ast.parse('getattr(adapter, "start", None)', mode="eval").body
+        self.assertEqual(_source(expression, {"adapter": "caller:adapter"}), "caller:adapter")
+
