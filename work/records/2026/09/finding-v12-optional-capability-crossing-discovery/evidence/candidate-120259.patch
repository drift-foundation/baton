+class OptionalCapabilityAliasesKeepTheirCrossing(unittest.TestCase):
+    def model(self, text):
+        sources = ((pathlib.Path("sample.py"), ast.parse(text)),)
+        _clear_boundary_projections()
+        try:
+            with patch.object(sys.modules[__name__], "_sources", lambda: sources):
+                return dict(_crossings()), receiving_entries()
+        finally:
+            _clear_boundary_projections()
+
+    def injected(self, entries):
+        return {entry for entry in entries if entry[0] == "injected"}
+
+    def expected(self, *members, method="release_token", site="sample.py:public"):
+        return {("injected", site, method + suffix) for suffix in ("",) + members}
+
+    def test_optional_alias_and_direct_member_have_the_same_result_entries(self):
+        for invocation in ('session.release_token({})', 'getattr(session, "release_token", None)({})', 'performing({})'):
+            with self.subTest(invocation=invocation):
+                crossings, entries = self.model(f'''
+def public(session):
+    performing = getattr(session, "release_token", None)
+    answer = {invocation}
+    return answer["kind"]
+''')
+                self.assertEqual(crossings, {"release_token": "sample.py:public"})
+                self.assertEqual(self.injected(entries), self.expected(".kind"))
+
+    def test_self_receiver_general_literal_method_and_chained_alias(self):
+        crossings, entries = self.model('''
+class Port:
+    def inspect(self):
+        performing = getattr(self._session, "inspect_receipt", _ABSENT)
+        alias = performing
+        answer = boundaries.document(alias({}), "an answer")
+        return answer["phase"]
+''')
+        self.assertEqual(crossings, {"inspect_receipt": "sample.py:Port.inspect"})
+        self.assertEqual(self.injected(entries), self.expected(".phase", method="inspect_receipt", site="sample.py:Port.inspect"))
+
+    def test_direct_bound_callable_alias_keeps_result_origin(self):
+        _, entries = self.model('''
+def public(session):
+    performing = session.release_token
+    answer = performing({})
+    return answer["kind"]
+''')
+        self.assertEqual(self.injected(entries), self.expected(".kind"))
+
+    def test_forwarded_and_helper_consumed_members_belong_to_original_crossing(self):
+        crossings, entries = self.model('''
+def _view(answer):
+    return answer["original_member"]
+def public(session):
+    performing = getattr(session, "release_token", None)
+    answer = performing({})
+    return _view(answer)
+def forwarded(port):
+    answer = port.release_token({})
+    return answer["forwarded_member"]
+''')
+        self.assertEqual(crossings, {"release_token": "sample.py:public"})
+        self.assertEqual(self.injected(entries), self.expected(".original_member", ".forwarded_member"))
+
+    def test_overwritten_alias_does_not_reappear_at_a_later_call(self):
+        for replacement in ("performing = other", "performing: object = other", "(performing := other)", "del performing",
+                            "def performing(value):\n        return value", "class performing:\n        pass", "from other import performing"):
+            with self.subTest(replacement=replacement):
+                _, entries = self.model(f'''
+def public(session, other):
+    performing = getattr(session, "release_token", None)
+    before = performing({{}})
+    {replacement}
+    after = performing({{}})
+    return before["kept"], after["must_not_borrow"]
+''')
+                self.assertEqual(self.injected(entries), self.expected(".kept"))
+
+    def test_alias_parameters_do_not_borrow_another_functions_binding(self):
+        crossings, entries = self.model('''
