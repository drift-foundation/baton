+def _callable_members(value, origins):
+    """Capability references, kept separate from the value owned by getattr.
+
+    A presence check still owns its receiver operand. Only invoking a proved
+    reference creates the session result origin; an unused optional lookup is
+    not an answer. The temporary AST wrappers reuse recognizers without changing
+    any node in the shared source snapshot.
+    """
+    if isinstance(origins, _OriginBindings) and id(value) not in origins.at:
+        return frozenset()
+    if isinstance(value, ast.Name):
+        return _origin_values(_bindings_at(origins, value).get(("callable", value.id)))
+    if isinstance(value, ast.Call) and isinstance(value.func, ast.Name) and value.func.id == "getattr":
+        if len(value.args) not in (2, 3) or value.keywords or not isinstance(value.args[1], ast.Constant) or type(value.args[1].value) is not str:
+            return frozenset()
+        value = ast.Attribute(value=value.args[0], attr=value.args[1].value)
+    if isinstance(value, ast.Attribute):
+        member = _capability_call(ast.Call(func=value, args=[], keywords=[]))
+        return _origin_values(member)
+    return frozenset()
+
+
+def _invoked_capabilities(node, origins):
+    if not isinstance(node, ast.Call):
+        return frozenset()
+    return _origin_values(_capability_call(node)) | _callable_members(node.func, origins)
+
+
+def _discovered_capabilities(node, origins):
+    """The same invocation universe for crossing sites and receiving entries."""
+    return _invoked_capabilities(node, origins) | _origin_values(_capability_value(node))
+
