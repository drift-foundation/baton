+    def test_argument_rebinding_preserves_the_selected_call_but_not_the_next(self):
+        for argument in ("(performing := other)", "key=(performing := other)"):
+            with self.subTest(argument=argument):
+                _, entries = self.model(f'''
+def public(session, other):
+    performing = getattr(session, "release_token", None)
+    answer = performing({argument})
+    later = performing({{}})
+    return answer["kept"], later["wrong"]
+''')
+                self.assertEqual(self.injected(entries), self.expected(".kept"))
+
+    def test_argument_rebinding_to_another_capability_separates_the_two_results(self):
+        _, entries = self.model('''
+def public(session):
+    performing = getattr(session, "release_token", None)
+    next_call = getattr(session, "inspect_token", None)
+    answer = performing((performing := next_call))
+    later = performing({})
+    return answer["first"], later["second"]
+''')
+        self.assertEqual(self.injected(entries), self.expected(".first") | self.expected(".second", method="inspect_token"))
+
+    def test_argument_rebinding_keeps_each_branchs_selected_callable(self):
+        _, entries = self.model('''
+def public(session, choice, other):
+    performing = getattr(session, "release_token", None)
+    if choice:
+        performing = getattr(session, "inspect_token", None)
+    answer = performing((performing := other))
+    return answer["kept"], performing({})["wrong"]
+''')
+        self.assertEqual(self.injected(entries), self.expected(".kept") | self.expected(".kept", method="inspect_token"))
+
