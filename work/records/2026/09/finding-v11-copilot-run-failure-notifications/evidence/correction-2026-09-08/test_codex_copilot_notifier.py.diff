+                if ending == "absent":
+                    self.runtimes = []
+                elif ending == "other-owner":
+                    self.expire_runtime(action_owner="pc.slaw")
+                else:
+                    self.add_runtime(state="unknown" if ending == "reported-unknown" else ending, provenance="reported", stale=False)
+                state, result = self.poll(state)
