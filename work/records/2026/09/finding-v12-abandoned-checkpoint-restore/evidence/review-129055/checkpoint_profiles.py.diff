+def _pinned_object(repository):
+    """The exact directory a restore is nominated over, by identity.
+
+    W128692 review [P1]. `lstat` rather than `stat` on purpose: a symlink whose
+    target is a directory answers a perfectly good directory to `stat`, and a
+    checkout reached through one is a checkout this profile was not asked to
+    write. What is pinned is the object the NAME resolves to without following
+    anything.
+    """
+    try:
+        status = os.lstat(repository)
+    except OSError:
+        raise ProfileRefusal(
+            "the private line repository is a directory that exists") from None
+    if not os.path.isdir(repository) or os.path.islink(repository):
+        raise ProfileRefusal(
+            "the private line repository is a directory of its own and not a "
+            "link to one")
+    return (status.st_dev, status.st_ino)
+
+
+def _same_object(repository, pinned):
+    """Still the object this restore pinned, or a refusal before it writes."""
+    try:
+        status = os.lstat(repository)
+    except OSError:
+        raise ProfileRefusal(
+            "the private line repository is a directory that exists") from None
+    if os.path.islink(repository) or (status.st_dev, status.st_ino) != pinned:
+        raise ProfileRefusal(
+            "the private line repository pathname now names another object; a "
+            "restore writes the exact checkout it was nominated over")
 
 
