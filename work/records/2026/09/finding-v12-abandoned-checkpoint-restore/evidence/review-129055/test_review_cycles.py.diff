+    def test_the_intent_takes_the_exclusion_before_the_profile_is_asked(self):
+        """[P1] THE SERIALIZATION, stated where it happens. The revocation is
+        committed in the same transaction that fixes the intent, so a second
+        restorer finds no active writer to recover -- and the line is
+        deliberately left `writing`, so no successor is admitted across the
+        profile boundary either."""
+        self.abandoned()
+        seen = {}
+        original = self.profile.restore_checkpoint
+
+        def watching(repository, evidence):
+            seen["writer"] = writer_of(
+                self.store, self.writer_row["writer_id"])["state"]
+            seen["line"] = line_of(self.store, self.line_id)["state"]
+            seen["admission"] = self.refused(self.admit).category
+            return original(repository, evidence)
+
+        self.profile.restore_checkpoint = watching
+        self.restore()
+        self.assertEqual(seen, {"writer": "revoked", "line": "writing",
+                                "admission": "refused"})
+
+    def test_an_in_flight_duplicate_cannot_reset_a_successors_checkout(self):
+        """[P1] THE COUNTEREXAMPLE, DRIVEN. Recovery A is paused before its
+        effect; recovery B completes through the same public act, the line is
+        released and writer 3 is admitted and puts the checkout somewhere of
+        its own. A then resumes -- and must not write.
+
+        WHAT DISTINGUISHES A FROM A CRASH RETRY is the successor: an ACTIVE
+        writer on the line means somebody else now owns the checkout, which a
+        retry of this recovery never sees.
+        """
+        self.abandoned()
+        original = self.profile.restore_checkpoint
+        resumed = {}
+
+        def paused(repository, evidence):
+            # ONCE. B goes through the same public act, which reaches this same
+            # seam; without the guard the pause would pause itself.
+            if resumed:
+                return original(repository, evidence)
+            resumed["b"] = None
+            # B completes, the line is released, and a successor takes it and
+            # moves the checkout to its own revision.
+            resumed["b"] = restore_abandoned_correction(
+                self.store, attempt_id=self.abandoned_attempt, generation=2,
+                retention_policy_digest=RETENTION, profile=self.profile)
+            granted = self.admit()
+            self.profile.current_revision = 999
+            resumed["successor"] = granted["writer_id"]
+            return original(repository, evidence)
+
+        self.profile.restore_checkpoint = paused
+        refusal = self.refused()
+
+        self.assertEqual((refusal.category, refusal.code),
+                         ("refused", "operation-collision"))
+        self.assertIn("another call's", refusal.message)
+        self.assertIsNotNone(resumed["b"])
+        # A DOES NOT REPORT B'S SUCCESS AS ITS OWN, and the successor keeps its
+        # line: nothing here released it a second time.
+        self.assertEqual(line_of(self.store, self.line_id)["state"], "writing")
+        self.assertEqual(
+            writer_of(self.store, resumed["successor"])["state"], "active")
+        self.assertEqual(abandoned_correction_of(
+            self.store, attempt_id=self.abandoned_attempt, generation=2),
+            resumed["b"])
+        # THE RESIDUAL, MEASURED RATHER THAN CLAIMED AWAY. A's effect ran --
+        # the seam paused it INSIDE the profile, past every guard this module
+        # can place -- so the successor's checkout was reset. That is reported
+        # in this Work's record with what closing it would take; what is fixed
+        # here is that A refuses instead of returning a success.
+        self.assertEqual(self.profile.current_revision,
+                         int(self.checkpoint["evidence"]["head"], 16))
+
+    def test_a_duplicate_that_completed_is_not_reported_as_this_call(self):
+        """The other half of the same guard, with no successor involved: if
+        this recovery completed while this call was restoring, the committed
+        record is the OTHER call's and `store.transact` would have replayed it
+        as an ordinary success."""
+        self.abandoned()
+        original = self.profile.restore_checkpoint
+        held = {}
+
+        def paused(repository, evidence):
+            if held:
+                return original(repository, evidence)
+            held["b"] = None
+            held["b"] = restore_abandoned_correction(
+                self.store, attempt_id=self.abandoned_attempt, generation=2,
+                retention_policy_digest=RETENTION, profile=self.profile)
+            return original(repository, evidence)
+
+        self.profile.restore_checkpoint = paused
+        refusal = self.refused()
+        self.assertEqual((refusal.category, refusal.code),
+                         ("refused", "operation-collision"))
+        self.assertIsNotNone(held["b"])
+        # ONE COMMITTED RECOVERY, and it is the one that made it.
+        self.assertEqual(abandoned_correction_of(
+            self.store, attempt_id=self.abandoned_attempt, generation=2),
+            held["b"])
+        self.assertEqual(line_of(self.store, self.line_id)["state"],
+                         "correction-ready")
 
