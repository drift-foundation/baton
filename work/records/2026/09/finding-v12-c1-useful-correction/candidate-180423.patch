+                    adopted = case.adopt(store, body=body)
+                    result = managed_result_of(case.coordinated(), case.ORCHESTRATION)
+                    self.assertEqual(result["state"], expected)
+                    self.assertEqual(adopted["report"]["status"], next((s for s in statuses if s), 0))
