+class PreparedEligibilityUsesCandidateMeasurements(ThePreparationIsAdoptedFromWhatItCollected):
+    """Retained-object adoption with synthetic unit inputs through real owners.
+
+    C1's process scenario separately supplies genuine worker-produced objects.
+    These fixtures vary one measured report while preserving frozen custody.
+    """
+
+    def published_declaration(self):
+        held = super().published_declaration()
+        return sealed_manifest(dict(held, outputs=held["outputs"] + [_declared_output("prepared-objects", "workspace/objects")]))
+
+    def outputs(self, body=None, **changed):
+        return super().outputs(body, **changed) + [_answered_output("prepared-objects", b"unit-object-fixture", "artifact-objects", path="objects.bundle")]
+
+    def report_body(self, **changed):
+        held = json.loads(super().report_body())
+        source = self.request()["source"]
+        held["derived_candidate"] = dict(source, revision="d" * 40, tree="e" * 40)
+        held.update(changed)
+        return json.dumps(held, sort_keys=True).encode()
+
+    def test_eligibility_preserves_measurements_and_replays_retained_custody(self):
+        for statuses, expected, reason in [
+            ((0, 1, 0), "awaiting-evidence", None),
+            ((0, 0, 0), "awaiting-evidence", None),
+            ((7, 1, 0), "blocked", "combined command"),
+            ((0, 1, 9), "blocked", "isolated command"),
+        ]:
+            with self.subTest(statuses=statuses):
+                case = type(self)(); case.setUp()
+                try:
+                    request = case.request()
+                    report = worker_task.compose_report(request, case.trees(), [{"name": name, "status": status, "harness_added": name == "base", "output": "unit measurement fixture"} for name, status in zip(request["commands"], statuses)], [], None, harness_measured=case.HARNESS)
+                    body = case.report_body(**report)
+                    store = case.ended(body=body)
+                    adopted = case.adopt(store, body=body)
+                    result = managed_result_of(case.coordinated(), case.ORCHESTRATION)
+                    self.assertEqual(result["state"], expected)
+                    self.assertEqual(adopted["report"]["status"], next((s for s in statuses if s), 0))
+                    self.assertEqual([one["status"] for one in adopted["report"]["completed"]], list(statuses))
+                    self.assertEqual(adopted["collected"]["custody"], "accepted")
+                    self.assertIsNotNone(adopted["objects"])
+                    self.assertEqual(result["prepared"]["preparation"], adopted)
+                    if reason is None:
+                        self.assertIsNone(result["reason"])
+                    else:
+                        self.assertIn(reason, result["reason"])
+                    self.assertEqual(case.adopt(store, body=body), adopted)
+                    self.assertEqual(managed_result_of(case.coordinated(), case.ORCHESTRATION), result)
+                    self.assertEqual(list(result["phases"]), ["prepare"])
+                finally:
+                    case.doCleanups()
+
+    def test_incomplete_or_timed_out_measurements_remain_blocked(self):
+        for kind, status, tag in [("measured", 0, None), ("collected-without-status", None, "timeout")]:
+            with self.subTest(kind=kind):
+                case = type(self)(); case.setUp()
+                try:
+                    body = case.report_body(kind=kind, status=status, tag=tag, completed=[{"name": "combined", "status": 0, "harness_added": False}], not_run=["base", "isolated"])
+                    store = case.ended(body=body)
+                    adopted = case.adopt(store, body=body)
