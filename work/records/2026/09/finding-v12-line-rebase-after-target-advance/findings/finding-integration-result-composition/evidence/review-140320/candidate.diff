+class TheDirectFinalizationRefusesBeforeItWritesAnything(ExecutionCase):
+    """W133129, owner return137905's amendment: the three refusals that protect
+    the dedicated Git target, each proved to write NOTHING.
+
+    THE PROFILE IS AN INJECTED CAPABILITY, exactly as the runtime port is, and
+    that is what makes "nothing was written" provable rather than asserted: this
+    one answers `revision` and RAISES from `held` and `advance`. A control that
+    let a real profile run could only check the target afterwards and could not
+    distinguish "refused before the write" from "wrote and then refused".
+    """
+
+    CANDIDATE = "d" * 40
+    ACCEPTED_OLD = "e" * 40
+    REFERENCE = "refs/heads/main"
+
+    class Profile:
+        """`revision` answers; every write raises. `asked` is the whole log."""
+
+        def __init__(self, revision):
+            self._revision = revision
+            self.asked = []
+
+        def revision(self, root, reference):
+            self.asked.append(("revision", root, reference))
+            return self._revision
+
+        def held(self, root, revision, what):
+            self.asked.append(("held", root, revision, what))
+            return {"head": revision, "tree": "f" * 40}
+
+        def advance(self, root, *, reference, imported, reviewed):
+            self.asked.append(("advance", root, reference, imported, reviewed))
+            raise AssertionError("the reference was advanced after a refusal")
+
+    def granted(self):
+        """The real live grant this finalization would hold."""
+        return grant_lease(self.coordinator, canonical_target_id=TARGET,
+                           entry_id="entry-1", lease_id="lease-1",
+                           integrator_participant=INTEGRATOR,
+                           attempt_id="attempt-1")["lease"]
+
+    def finalizing(self, profile, **changed):
+        operands = {"canonical_target_id": TARGET, "entry_id": "entry-1",
+                    "lease_id": "lease-1", "fence": self.granted()["fence"],
+                    "source": self.target, "candidate": self.CANDIDATE,
+                    "accepted_old": self.ACCEPTED_OLD,
+                    "target_root": self.target, "reference": self.REFERENCE}
+        operands.update(changed)
+
+        def runner(argv):
+            raise AssertionError(f"a Git command ran after a refusal: {argv}")
+
+        return execution.finalize_direct_target(
+            self.coordinator, profile, runner, **operands)
+
+    def test_a_target_that_moved_is_reconciled_and_never_overwritten(self):
+        """THE STALE TARGET. The reference holds neither the revision this
+        integration was accepted against nor its candidate, so a second writer
+        moved it -- and an accepted-against comparison is what makes that a
+        refusal instead of a new baseline."""
+        profile = self.Profile("9" * 40)
+        caught = self.refusal(self.finalizing, profile)
+        self.assertEqual(caught.category, "stale-assignment")
+        self.assertEqual(caught.code, "target")
+        self.assertIn("a target that moved is reconciled again rather than "
+                      "overwritten", caught.message)
+        # AND THE REVISION READ WAS THE ONLY THING IT DID.
+        self.assertEqual(profile.asked,
+                         [("revision", self.target, self.REFERENCE)])
+
+    def test_an_already_finalized_reference_is_held_and_never_adopted(self):
+        """ALREADY AT THE CANDIDATE. Nothing in this build records that THIS
