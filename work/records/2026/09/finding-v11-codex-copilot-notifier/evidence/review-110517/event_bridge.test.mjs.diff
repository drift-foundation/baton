+test("copilot admission requires an idle prompt and exact current thread/incarnation", async () => {
+  const { bridge, fake } = bridgeWithFake();
+  const state = bridge.targetStates.get("a");
+  const notification = { target: "a", source: "baton-copilot", type: "operator-attention", summary: "attention", copilotThreadId: "thread-a", copilotInstanceId: bridge.copilotInstanceId };
+  assert.equal(bridge.enqueue(notification).reason, "copilot-requires-prompt");
+  // Inject the configured identity into this isolated bridge fixture.
+  state.identity = { participant: "baton.prompt", role: "prompt" };
+  assert.equal(bridge.enqueue({ ...notification, copilotThreadId: "old-thread" }).reason, "copilot-target-changed");
+  assert.equal(bridge.enqueue({ ...notification, copilotInstanceId: "old-bridge" }).reason, "copilot-target-changed");
+  fake.emit("status", { threadId: "thread-a", status: { type: "active" } });
+  assert.equal(bridge.enqueue(notification).reason, "copilot-busy");
+  assert.equal(state.queue.length, 0);
+  fake.emit("status", { threadId: "thread-a", status: { type: "idle" } });
+  assert.equal(bridge.handleRequest({ control: "copilot-status" }).targets.a.role, "prompt");
+  assert.equal(bridge.enqueue(notification).accepted, true);
+  assert.equal(bridge.enqueue(notification).reason, "copilot-busy");
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.equal(fake.starts.length, 1);
+  assert.match(fake.starts[0].text, /Do not claim, approve/);
+  assert.equal(fake.starts[0].threadId, "thread-a");
+});
+
