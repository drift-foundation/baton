+REASON = "operator stops this Job before its deadline"
+SOON = "2026-09-02T00:00:30.000Z"            # NOW + 30 s
+MUCH_LATER = "2026-09-02T00:02:01.000Z"      # NOW + 121 s
+EARLIER = "2026-09-01T23:59:00.000Z"
