+"""W371294 — the closed development role contract, its registry and its vectors.
+
+WHAT IS FROZEN HERE AND WHY IT IS NOT PARAPHRASED. The approved specification
+is `PROPOSAL.md` SHA-256
+`ad0f2171f06f8da9e6e3c2784e50cab91d27f94c4d0727014e4520b00aa0b339`, and the
+POSITIVE VECTOR is the exact `ROLE-CONTRACT.proposed.json` it carries, read
+from the record as bytes. So the positive case is not "whatever this module
+composes": it is the document the owner approved, compared against the module,
+with its canonical digest asserted on both sides. If either drifts, this fails.
+
+Nothing in this module is substituted. There is no store, no filesystem beyond
+reading that one approved vector, no engine, provider or deployment, and no
+qualification: this slice is a data contract and its validator.
+"""
+
+import copy
+import json
+import pathlib
+import sys
+import unittest
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2] / "src"))
+
+from baton_v12.contracts import ContractRefusal, canonical_bytes, digest  # noqa: E402
+from baton_v12.job_manager import role_contract, templates                # noqa: E402
+from baton_v12.job_manager import review_driver                           # noqa: E402
+
+# THE APPROVED VECTOR, from the record rather than from this test's own idea of
+# it. `parents[3]` is the repository's `v12`, so the record is beside it.
+RECORD = (pathlib.Path(__file__).resolve().parents[4] / "work" / "records"
+          / "2026" / "10" / "finding-v12-workflow-fragility-assessment"
+          / "findings" / "finding-template-adapter-admission-plan")
+APPROVED = RECORD / "ROLE-CONTRACT.proposed.json"
+PROPOSAL_DIGEST = (
+    "ad0f2171f06f8da9e6e3c2784e50cab91d27f94c4d0727014e4520b00aa0b339")
+
+
+class TheApprovedVectorIsTheOneThisBuildCarries(unittest.TestCase):
+    """THE FROZEN POSITIVE VECTOR, both directions.
+
+    The owner approved a document and a digest. This asserts that the module
+    composes that document, that the document validates, and that the record
+    the approval names has not moved under either.
+    """
+
+    def test_the_proposal_is_the_pinned_one(self):
+        """The specification itself, by digest. If the approved proposal were
+        edited, every bound below would be describing a different decision."""
+        self.assertEqual(
+            digest(json.loads(APPROVED.read_text(encoding="utf-8"))),
+            role_contract.BASELINE_DIGEST)
+        import hashlib
+        self.assertEqual(
+            hashlib.sha256((RECORD / "PROPOSAL.md").read_bytes()).hexdigest(),
+            PROPOSAL_DIGEST)
+
+    def test_the_module_composes_the_approved_document(self):
+        self.assertEqual(role_contract.baseline_document(),
+                         json.loads(APPROVED.read_text(encoding="utf-8")))
+
+    def test_the_approved_bytes_validate(self):
+        """Read as BYTES, through the bounded reader a carrier would use."""
+        taken = role_contract.role_contract_of_bytes(APPROVED.read_bytes())
+        self.assertEqual(taken, role_contract.baseline_document())
+
+    def test_the_canonical_digest_is_the_approved_one(self):
+        self.assertEqual(
+            role_contract.contract_digest(role_contract.baseline_document()),
+            "sha256:21b78036947430e3ae073a04fd5237b10a844471207a52c"
+            "ba9ea6186acdffdaf")
+
+    def test_whitespace_in_a_file_is_not_identity(self):
+        """The proposal says so in those words, so it is driven: the same
+        document re-encoded with different spacing has the same digest."""
+        held = role_contract.baseline_document()
+        wide = json.dumps(held, indent=4).encode("utf-8")
+        self.assertNotEqual(wide, canonical_bytes(held))
+        self.assertEqual(
+            role_contract.contract_digest(
+                role_contract.role_contract_of_bytes(wide)),
+            role_contract.BASELINE_DIGEST)
+
+    def test_the_document_carries_no_digest_member_to_disagree_with(self):
+        """"without any embedded digest member" — the identity is a fact about
+        the bytes rather than a field the document asserts about itself, so
+        there is nowhere for a lying digest to live."""
+        self.assertNotIn("digest", role_contract.baseline_document())
+        self.assertEqual(sorted(role_contract.baseline_document()),
+                         sorted(role_contract.CONTRACT_MEMBERS))
+
+    def test_each_inspection_is_detached(self):
+        """`templates.template_document`'s rule: mutating what you were handed
+        changes nothing for the next reader."""
+        first = role_contract.baseline_document()
+        first["outputs"][0]["constraints"]["max_bytes"] = 1
+        self.assertEqual(
+            role_contract.baseline_document()["outputs"][0]["constraints"]
+            ["max_bytes"], role_contract.MAX_OUTPUT_BYTES)
+
+
+class TheExactBoundsAreTheApprovedOnes(unittest.TestCase):
+    """The values, named one at a time, against the proposal's own table."""
+
+    def setUp(self):
+        self.held = role_contract.baseline_document()
+
+    def test_the_four_literals(self):
+        self.assertEqual(self.held["schema"],
+                         "baton.v12.development-role-contract/1")
+        self.assertEqual(self.held["template"],
+                         "baton.v12.job-template.implementation-review/2")
+        self.assertEqual(self.held["task_schema"], "baton.dogfood-task/2")
+        self.assertEqual(self.held["source_profile"], "git-line")
+
+    def test_the_three_outputs_in_proposal_findings_logs_order(self):
+        self.assertEqual([one["name"] for one in self.held["outputs"]],
+                         ["proposal", "findings", "logs"])
+        self.assertEqual([one["type"] for one in self.held["outputs"]],
+                         ["git-change-proposal", "directory-result",
+                          "directory-result"])
+
+    def test_every_name_is_its_own_path(self):
+        for one in self.held["outputs"]:
+            self.assertEqual(one["path"], one["name"])
+
+    def test_every_output_is_the_shared_optional_declaration(self):
+        for one in self.held["outputs"]:
+            self.assertIs(one["required"], False)
+
+    def test_the_constraints_are_exact(self):
+        for one in self.held["outputs"]:
+            limits = one["constraints"]
+            self.assertEqual(sorted(limits),
+                             sorted(role_contract.CONSTRAINT_MEMBERS))
+            self.assertEqual(limits["max_bytes"], 1048576)
+            self.assertEqual(limits["max_entries"], 100)
+            self.assertEqual(limits["link_policy"], "forbid")
+            self.assertIsNone(limits["validator_digest"])
+        self.assertEqual(
+            self.held["outputs"][0]["constraints"]["allowed_media_types"],
+            ["application/octet-stream", "text/plain"])
+        for one in self.held["outputs"][1:]:
+            self.assertEqual(one["constraints"]["allowed_media_types"],
+                             ["application/octet-stream"])
+
+    def test_the_two_roles_implementation_then_review(self):
+        self.assertEqual([one["role"] for one in self.held["roles"]],
+                         ["implementation", "review"])
+
+    def test_the_implementation_role(self):
+        one = self.held["roles"][0]
+        self.assertEqual(one["consumes"], [])
+        self.assertEqual(one["produces"], ["proposal"])
+        self.assertEqual(one["required_for_success"], ["proposal"])
+        self.assertEqual(one["consumer"], "git-proposal/1")
+
+    def test_the_review_role(self):
+        one = self.held["roles"][1]
+        self.assertEqual(one["consumes"],
+                         [{"role": "implementation", "output": "proposal",
+                           "delivery": "frozen-checkpoint"}])
+        self.assertEqual(one["produces"], ["findings", "logs"])
+        self.assertEqual(one["required_for_success"], ["findings", "logs"])
+        self.assertEqual(one["consumer"], "checkpoint-review/1")
+
+    def test_the_shared_optional_bits_do_not_decide_success(self):
+        """The proposal's central distinction, asserted as a relationship
+        rather than as prose: every `required` is false, and each role still
+        owes two or one named results. A reader who concluded from the false
+        bits that nothing is owed would be contradicted here."""
+        self.assertTrue(all(one["required"] is False
+                            for one in self.held["outputs"]))
+        owed = {one["role"]: set(one["required_for_success"])
+                for one in self.held["roles"]}
+        self.assertEqual(owed, {"implementation": {"proposal"},
+                                "review": {"findings", "logs"}})
+        # And what each role must answer ABSENT is the complement, which is
+        # the proposal's table: implementation owes no findings or logs.
+        declared = {one["name"] for one in self.held["outputs"]}
+        self.assertEqual(declared - owed["implementation"],
+                         {"findings", "logs"})
+        self.assertEqual(declared - owed["review"], {"proposal"})
+
+    def test_the_literals_are_their_owners(self):
+        """REQUIRED REUSE, driven. Each shared word comes from the module that
+        owns it, so a rename there cannot leave this descriptor describing
+        something nothing answers to."""
+        from baton_v12.source_profiles.checkout import GIT_LINE_PROFILE
+        from baton_v12.verification_context import LEGACY_TASK_SCHEMA
+        from baton_v12.worker_manager.schema import OUTPUT_TYPES
+        from baton_v12.worker_manager.sealing import DECLARED_OUTPUT_MEMBERS
+        from baton_v12.integration.driver import CLAIM_NAMESPACE
+        self.assertEqual(self.held["source_profile"], GIT_LINE_PROFILE)
+        self.assertEqual(self.held["task_schema"], LEGACY_TASK_SCHEMA)
+        self.assertEqual(self.held["outputs"][0]["type"], OUTPUT_TYPES[0])
+        self.assertEqual(self.held["outputs"][1]["type"], OUTPUT_TYPES[1])
+        self.assertEqual(sorted(self.held["outputs"][0]),
+                         sorted(DECLARED_OUTPUT_MEMBERS))
+        self.assertEqual(self.held["roles"][1]["produces"],
+                         [review_driver.FINDINGS_OUTPUT,
+                          review_driver.LOGS_OUTPUT])
+        self.assertEqual(CLAIM_NAMESPACE,
+                         f"baton.{self.held['roles'][0]['consumer']}")
+        self.assertEqual(review_driver.REVIEW_CLAIM_NAMESPACE,
+                         f"baton.{self.held['roles'][1]['consumer']}")
+
