+class EveryRefusalInTheApprovedMatrix(unittest.TestCase):
+    """THE FROZEN INVALID VECTORS, each one a row of the proposal's matrix.
+
+    Every case starts from the approved document and changes ONE thing, so a
+    refusal here is attributable to that change and nothing else.
+    """
+
+    def refusing(self, **changed):
+        held = role_contract.baseline_document()
+        held.update(changed)
+        with self.assertRaises(ContractRefusal) as caught:
+            role_contract.check_role_contract(held)
+        return str(caught.exception)
+
+    def refusing_document(self, held):
+        with self.assertRaises(ContractRefusal) as caught:
+            role_contract.check_role_contract(held)
+        return str(caught.exception)
+
+    def altered(self, where, member, value):
+        held = role_contract.baseline_document()
+        held[where[0]][where[1]][member] = value
+        return held
+
+    # -- version and unknown members ----------------------------------------
+
+    def test_an_unsupported_descriptor_version_refuses(self):
+        said = self.refusing(schema="baton.v12.development-role-contract/2")
+        self.assertIn("another revision is not one to read the recognised "
+                      "parts out of", said)
+
+    def test_an_unknown_member_refuses(self):
+        held = role_contract.baseline_document()
+        held["capability"] = {}
+        self.assertIn("unexpected capability", self.refusing_document(held))
+
+    def test_a_missing_member_refuses(self):
+        held = role_contract.baseline_document()
+        del held["roles"]
+        self.assertIn("missing roles", self.refusing_document(held))
+
+    def test_another_template_refuses(self):
+        said = self.refusing(
+            template="baton.v12.job-template.implementation-review/1")
+        self.assertIn("implementation-review/2", said)
+
+    def test_a_task_three_workload_refuses_with_its_reason(self):
+        """The row the tree makes reachable: a context-enabled `/3` task
+        exists, and this descriptor refuses to qualify it rather than
+        reinterpreting it."""
+        from baton_v12.verification_context import TASK_SCHEMA
+        said = self.refusing(task_schema=TASK_SCHEMA)
+        self.assertIn("continues its own explicit path", said)
+        self.assertIn("baton.dogfood-task/2", said)
+
+    def test_another_source_profile_refuses(self):
+        self.assertIn("git-line", self.refusing(source_profile="hg-line"))
+
+    # -- the outputs ---------------------------------------------------------
+
+    def test_a_wrong_output_type_refuses(self):
+        self.assertIn(
+            "git-change-proposal",
+            self.refusing_document(
+                self.altered(("outputs", 0), "type", "record-output")))
+
+    def test_a_path_other_than_the_name_refuses(self):
+        self.assertIn(
+            "path", self.refusing_document(
+                self.altered(("outputs", 1), "path", "results/findings")))
+
+    def test_a_required_output_refuses(self):
+        said = self.refusing_document(
+            self.altered(("outputs", 0), "required", True))
+        self.assertIn("required_for_success", said)
+
+    def test_a_required_bit_that_is_an_integer_refuses(self):
+        """`0` is not `false`. `own` keeps booleans and integers apart in the
+        value space and the frozen fragment requires a boolean, so a
+        declaration carrying `0` is refused rather than read as absence."""
+        self.assertIsInstance(
+            self.refusing_document(
+                self.altered(("outputs", 0), "required", 0)), str)
+
+    def test_a_lower_limit_refuses_as_loudly_as_a_higher_one(self):
+        """"changing limits needs a version, not guessed compatibility" —
+        BOTH directions, because a validator that accepted the smaller number
+        would be deciding that tighter is safer on an owner's behalf."""
+        for value in (1024, 1048575, 1048577, 2097152):
+            with self.subTest(max_bytes=value):
+                held = role_contract.baseline_document()
+                held["outputs"][0]["constraints"]["max_bytes"] = value
+                self.assertIn("the integer 1048576",
+                              self.refusing_document(held))
+
+    def test_a_boolean_where_a_limit_belongs_refuses(self):
+        """REFUSED BY THE FROZEN SCHEMA, which runs first, and this asserts
+        the refusal that actually happens rather than the one I expected.
+        `outputConstraints` types `max_entries` as an integer, so the shared
+        contract catches a boolean before this revision's equality does — the
+        exact-value check below it is a second line, not the only one."""
+        held = role_contract.baseline_document()
+        held["outputs"][2]["constraints"]["max_entries"] = True
+        said = self.refusing_document(held)
+        self.assertIn("does not satisfy the frozen schema", said)
+        self.assertIn("max_entries", said)
+
+    def test_a_float_limit_refuses(self):
+        held = role_contract.baseline_document()
+        held["outputs"][0]["constraints"]["max_bytes"] = 1048576.0
+        self.assertIsInstance(self.refusing_document(held), str)
+
+    def test_a_wider_media_set_refuses(self):
+        held = role_contract.baseline_document()
+        held["outputs"][1]["constraints"]["allowed_media_types"] = [
+            "application/octet-stream", "text/plain"]
+        self.assertIn("allowed_media_types", self.refusing_document(held))
+
+    def test_a_reordered_media_set_refuses(self):
+        """Order is prescribed, so a reordering is a different document with a
+        different digest rather than the same contract spelled differently."""
+        held = role_contract.baseline_document()
+        held["outputs"][0]["constraints"]["allowed_media_types"] = [
+            "text/plain", "application/octet-stream"]
+        self.assertIn("in that order", self.refusing_document(held))
+
+    def test_a_duplicated_media_type_refuses(self):
+        held = role_contract.baseline_document()
+        held["outputs"][1]["constraints"]["allowed_media_types"] = [
+            "application/octet-stream", "application/octet-stream"]
+        self.assertIn("allowed_media_types", self.refusing_document(held))
+
+    def test_a_permissive_link_policy_refuses(self):
+        """Also the frozen schema's, which pins `link_policy` as a const —
+        so the shared contract and this revision agree, and the refusal names
+        the frozen one because it is reached first."""
+        held = role_contract.baseline_document()
+        held["outputs"][0]["constraints"]["link_policy"] = "allow"
+        said = self.refusing_document(held)
+        self.assertIn("link_policy", said)
+        self.assertIn("const", said)
+
+    def test_a_custom_validator_digest_refuses(self):
+        held = role_contract.baseline_document()
+        held["outputs"][0]["constraints"]["validator_digest"] = (
+            "sha256:" + "0" * 64)
+        said = self.refusing_document(held)
+        self.assertIn("no operator-supplied validator", said)
+
+    def test_an_extra_constraint_member_refuses(self):
+        """The frozen `outputConstraints` is `additionalProperties: false`, so
+        an invented limit is refused by the shared contract — which is a
+        better place for it than this module's own closed set."""
+        held = role_contract.baseline_document()
+        held["outputs"][0]["constraints"]["min_bytes"] = 1
+        self.assertIn("additionalProperties", self.refusing_document(held))
+
+    def test_this_revisions_closed_set_is_reached_when_the_frozen_one_passes(
+            self):
+        """So the second line is shown to be live rather than dead code: the
+        descriptor's own member check is what refuses an output object whose
+        shape the frozen fragment never sees."""
+        held = role_contract.baseline_document()
+        del held["outputs"][0]["constraints"]
+        self.assertIn("missing constraints", self.refusing_document(held))
+
+    def test_a_fourth_output_refuses(self):
+        held = role_contract.baseline_document()
+        held["outputs"].append(copy.deepcopy(held["outputs"][2]))
+        self.assertIn("exactly 3 outputs", self.refusing_document(held))
+
+    def test_a_missing_output_refuses(self):
+        held = role_contract.baseline_document()
+        del held["outputs"][1]
+        self.assertIn("exactly 3 outputs", self.refusing_document(held))
+
+    def test_reordered_outputs_refuse(self):
+        held = role_contract.baseline_document()
+        held["outputs"] = [held["outputs"][1], held["outputs"][0],
+                           held["outputs"][2]]
+        self.assertIn("name", self.refusing_document(held))
+
+    def test_a_context_receipt_output_refuses(self):
+        """Named in the matrix: "context-receipt output... require another
+        explicitly selected descriptor/template revision"."""
+        held = role_contract.baseline_document()
+        held["outputs"].append(
+            {"name": "provider-context-receipt", "type": "directory-result",
+             "path": "provider-context-receipt", "required": False,
+             "constraints": {"max_bytes": 16384, "max_entries": 1,
+                             "allowed_media_types":
+                                 ["application/octet-stream"],
+                             "link_policy": "forbid",
+                             "validator_digest": None}})
+        self.assertIn("exactly 3 outputs", self.refusing_document(held))
+
+    # -- the roles -----------------------------------------------------------
+
+    def test_a_third_role_refuses(self):
+        held = role_contract.baseline_document()
+        held["roles"].append(copy.deepcopy(held["roles"][0]))
+        self.assertIn("exactly 2 roles", self.refusing_document(held))
+
+    def test_reordered_roles_refuse(self):
+        held = role_contract.baseline_document()
+        held["roles"] = list(reversed(held["roles"]))
+        self.assertIn("role", self.refusing_document(held))
+
+    def test_a_review_that_consumes_nothing_refuses(self):
+        """The matrix row that matters most: an independent review that is
+        eligible and has no candidate to read cannot do its work."""
+        held = role_contract.baseline_document()
+        held["roles"][1]["consumes"] = []
+        self.assertIn("consumes exactly 1", self.refusing_document(held))
+
+    def test_an_implementation_that_consumes_something_refuses(self):
+        held = role_contract.baseline_document()
+        held["roles"][0]["consumes"] = copy.deepcopy(
+            held["roles"][1]["consumes"])
+        self.assertIn("consumes exactly 0", self.refusing_document(held))
+
+    def test_a_delivery_that_is_not_a_frozen_checkpoint_refuses(self):
+        """"consumption of a proposal means an exact immutable checkpoint...
+        not copying a producer's metadata into a reviewer verdict"."""
+        held = role_contract.baseline_document()
+        held["roles"][1]["consumes"][0]["delivery"] = "copy"
+        self.assertIn("frozen-checkpoint", self.refusing_document(held))
+
+    def test_consuming_another_output_refuses(self):
+        held = role_contract.baseline_document()
+        held["roles"][1]["consumes"][0]["output"] = "logs"
+        self.assertIn("output", self.refusing_document(held))
+
+    def test_an_extra_consume_member_refuses(self):
+        held = role_contract.baseline_document()
+        held["roles"][1]["consumes"][0]["optional"] = True
+        self.assertIn("unexpected optional", self.refusing_document(held))
+
+    def test_missing_findings_for_review_refuses(self):
+        """The matrix row, by name: "Missing findings/logs, proposal required
+        for review, findings required for implementation"."""
+        held = role_contract.baseline_document()
+        held["roles"][1]["produces"] = ["logs"]
+        self.assertIn("produces", self.refusing_document(held))
+
+    def test_findings_required_of_implementation_refuses(self):
+        held = role_contract.baseline_document()
+        held["roles"][0]["required_for_success"] = ["proposal", "findings"]
+        self.assertIn("required_for_success", self.refusing_document(held))
+
+    def test_an_emptied_required_for_success_refuses(self):
+        """The waiver the proposal forbids: a role that owes nothing because
+        every shared `required` bit is false."""
+        held = role_contract.baseline_document()
+        held["roles"][1]["required_for_success"] = []
+        self.assertIn("required_for_success", self.refusing_document(held))
+
+    def test_a_dynamic_consumer_name_refuses(self):
+        """"Consumers are closed built-in development-profile IDs, never
+        dynamic dispatch names"."""
