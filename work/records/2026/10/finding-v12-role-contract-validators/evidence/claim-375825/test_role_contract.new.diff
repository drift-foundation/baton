+            with self.subTest(consumer=named):
+                held = role_contract.baseline_document()
+                held["roles"][1]["consumer"] = named
+                self.assertIn("consumer", self.refusing_document(held))
+
+    # -- the document itself -------------------------------------------------
+
+    def test_a_non_document_refuses(self):
+        for named in (None, [], "a contract", 7, True):
+            with self.subTest(value=named):
+                with self.assertRaises(ContractRefusal):
+                    role_contract.check_role_contract(named)
+
+    def test_a_non_builtin_member_refuses(self):
+        class Carrier:
+            pass
+        held = role_contract.baseline_document()
+        held["roles"] = Carrier()
+        with self.assertRaises(ContractRefusal):
+            role_contract.check_role_contract(held)
