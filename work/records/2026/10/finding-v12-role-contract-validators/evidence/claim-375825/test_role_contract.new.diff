+class TheBoundedReaderHoldsTheEncodedBounds(unittest.TestCase):
+    """Reading a descriptor from bytes: the ceiling, the encoding and the one
+    fault a careless reader cannot see."""
+
+    def test_duplicate_keys_refuse_before_canonicalization(self):
+        """THE SUBTLE ONE. `json.loads` keeps the LAST of two equal keys
+        silently, so a document carrying a member twice has two readings — the
+        one a reader sees and the one a digest is taken over. Two parties
+        could agree on a digest and disagree on the contract."""
+        payload = json.dumps(role_contract.baseline_document())
+        doubled = payload.replace(
+            '"source_profile": "git-line"',
+            '"source_profile": "hg-line", "source_profile": "git-line"', 1)
+        # Proof that the fault is INVISIBLE to an ordinary reader: plain
+        # `json.loads` accepts it and answers the valid-looking document.
+        self.assertEqual(json.loads(doubled)["source_profile"], "git-line")
+        with self.assertRaises(ContractRefusal) as caught:
+            role_contract.role_contract_of_bytes(doubled.encode("utf-8"))
+        self.assertIn("twice", str(caught.exception))
