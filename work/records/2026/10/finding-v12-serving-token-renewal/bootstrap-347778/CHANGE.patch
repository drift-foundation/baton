+    def acquire(self):
+        permission, eligible = self.selection()
+        governance = workspaces.prepared_workspace_governance(self.store, ATTEMPT, permission=permission, permission_eligible=eligible)
+        row = self.row()
+        operation = attempts._start_operation_id(row)
