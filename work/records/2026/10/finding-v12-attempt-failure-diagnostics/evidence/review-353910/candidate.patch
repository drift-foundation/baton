+    if committed is None:
+        raise ContractRefusal(
+            "integrity", "schema",
+            f"attempt {name_value(attempt_id)} names operation "
+            f"{name_value(operation_id)}, which this manager committed with "
+            f"no recorded answer for a {what} record")
