+class Clock:
+    def __init__(self):
+        self.seconds = 0
+        self.origin = datetime.fromisoformat(NOW.replace('Z', '+00:00'))
+
+    def utc(self):
+        return (self.origin + timedelta(seconds=self.seconds)).isoformat(timespec='milliseconds').replace('+00:00', 'Z')
+
+    def monotonic(self):
+        return self.seconds
+
+    def advance(self, seconds):
+        self.seconds += seconds
+
