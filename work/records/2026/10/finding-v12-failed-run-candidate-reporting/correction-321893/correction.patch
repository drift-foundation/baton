+                        acceptance=ACCEPTANCE_NO_CANDIDATE,
+                        verification=VERIFICATION_NOT_RUN,
+                        why="the turn froze no result at all")
+            found.append(held)
+            continue
+        held["disposition"] = frozen.get("disposition")
