+def _candidates(control, implementation, packet, shortfalls):
+    """EVERY turn's retained candidate, decided INDEPENDENTLY of its disposition.
+
+    W321528. THE DEFECT THIS CLOSES. `_proposals` above answers "what did this
+    run PUBLISH", and it is right to skip a turn that did not complete: a turn
+    that ended `unable` published no proposal by contract. But the selected live
+    run of this very Work timed out at 900s with a real three-file candidate
+    committed on its private line, and the report said it retained nothing at
+    all -- because the only question anybody asked was the publishing one. An
+    operator reading that would have deleted a workspace holding the work.
+
+    So this asks the OTHER question, for every attempt, whatever it ended as:
+    is there a retained candidate, and does its custody hold up?
+
+    THE FOUR ANSWERS ARE NOT DEGREES OF ONE, which is what the constants say
+    and what this function is careful to preserve:
+
+      `absent` is a turn that retained nothing. An ANSWER, and the ordinary
+      shape of a failure.
+
+      `unreadable` is a read that DID NOT ANSWER. Never evidence of absence --
+      conflating the two is how "I could not look" becomes "there is nothing
+      there", and this Work exists because that already happened once.
+
+      `refused` is evidence that EXISTS and did not survive a custody check. A
+      much louder fact than absence, and deliberately not silently dropped:
+      something is on disk and this program will not vouch for it.
+
+      `valid` is the only one that may be counted as a candidate, and only
+      after all three checks below agree.
+
+    WHAT `valid` REQUIRES, and none of it is taken on the worker's word:
+
+      THE SEALED RESULT BELONGS TO THIS ATTEMPT'S ASSIGNMENT. The manager
+      established that when it recorded the result -- `record_frozen_result`
+      validates the sealed manifest against the attempt's own fixed assignment
+      -- and this re-reads the row by attempt id, so a result that reached the
+      store at all is this attempt's. The assignment is read back as well, so
+      an attempt whose assignment cannot be read is `unreadable` rather than
+      assumed sound.
+
+      THE SEALED REFERENCE AND THE INDEXED ROW NAME THE SAME BYTES. The
+      manifest is the worker's sealed account; `output_artifacts` is the
+      manager's own index of what it received. Two records of one artifact that
+      disagree on digest, size, id or locator mean nobody knows which bytes the
+      candidate is, so that is `refused` and not a candidate.
+
+      THE CLAIM IS OFFERED AGAINST THIS DEPLOYMENT'S DECLARED BASE. A candidate
+      built on some other base is not a candidate for this target.
+
+    AND IT IS NOT A VERDICT. `verification` reports what the TURN's own
+    verification command did and `acceptance` what the line owner records;
+    neither is a formal verification or an acceptance of the candidate by
+    anybody. This run performs none and invents none. A `valid` candidate is
+    exactly "these bytes are retained here and their custody holds" -- nothing
+    about whether they are correct, reviewed or wanted.
+    """
+    from baton_v12.contracts import ContractRefusal
+    from baton_v12.worker_manager import (attempts as attempt_rows,
+                                          frozen_output_of, load_manifest)
+
+    try:
+        base = _declared_base(packet)
+    except (SupervisorRefusal, KeyError, OSError, TypeError, ValueError):
+        # ALREADY REPORTED BY `_proposals`; what matters here is that an
+        # unknown target makes the base check unanswerable rather than passed.
+        #
+        # AND THE READ IS BOUNDED WIDER THAN ONE REFUSAL, deliberately.
+        # `_declared_base` opens and parses the deployment's configuration, so
+        # a malformed or absent document reaches here as the driver's own
+        # exception. This collector's whole purpose is to report what survived
+        # a FAILED run; a report that itself died on an unreadable config
+        # would lose the retained candidate it exists to name.
+        base = None
+    found = []
+    for attempt in implementation:
+        held = {"attempt_id": attempt, "state": CANDIDATE_UNREADABLE,
+                "disposition": None, "locator": None, "base": None,
+                "head": None, "transport": None, "content_digest": None,
+                "bytes": None, "verification": VERIFICATION_UNREPORTED,
+                "acceptance": ACCEPTANCE_UNREADABLE, "why": None}
+        try:
+            frozen = frozen_output_of(control, attempt)
+        except (ContractRefusal, KeyError, TypeError) as why:
+            held["why"] = (f"the frozen result did not read: "
+                           f"{type(why).__name__}: {why}")
+            found.append(held)
+            shortfalls.append(
+                f"attempt {attempt} has an UNREADABLE retained candidate: "
+                f"{held['why']}. A read that did not answer is not evidence "
+                f"that nothing is retained")
+            continue
+        if frozen is None:
