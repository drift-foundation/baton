+        document = self.document()
+        zero = self.row(document, "job-zero/implementation")["activity"]
+        quiet = self.row(document, "job-quiet/implementation")["activity"]
+        bare = self.row(document, "job-bare/implementation")["activity"]
+        self.assertEqual(
