+
+    def traps(self, guards):
+        import sqlite3
+        import subprocess
+
+        for owner, method in ((JobStore, "open"), (ControlStore, "open"),
+                              (scheduler, "reserve"),
+                              (scheduler, "activate_pool"),
+                              (subprocess, "run"), (subprocess, "Popen"),
+                              (sqlite3, "connect")):
