+        before = list(self.acts.calls)
+        with ExitStack() as guards:
+            self.traps(guards)
+            held = visibility(document)
+            rows_of(document)
+        self.assertEqual(len(held["stages"]), 3)
+        self.assertEqual(self.acts.calls, before)
