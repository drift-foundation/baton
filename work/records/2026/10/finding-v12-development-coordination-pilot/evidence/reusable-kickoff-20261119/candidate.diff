+    artifact = _task_artifact(task)
+    manifest = {name: value for name, value in base["input_manifest"].items()
+                if name not in _MANIFEST_BOUND}
+    manifest["work_ref"] = {"authority_uuid": held["authority_uuid"],
+                            "work_id": work}
+    manifest["worker_image_digest"] = image_digest
+    manifest["human_contract"] = artifact
+    manifest["manifest_id"] = "input-manifest-" + worker_id
+    manifest["created_at"] = (now or datetime.now(timezone.utc).strftime(
+        "%Y-%m-%dT%H:%M:%S.000Z"))
+    manifest["manifest_digest"] = digest(manifest)
