+    target = Path(into)
+    if target.exists():
+        raise PoolRefusal(str(target) + " already exists; this verb writes a "
+                          "fresh worker document and never replaces one. "
+                          "Nothing was changed.")
+    target.parent.mkdir(parents=True, exist_ok=True)
