+# -- W321608: composing a worker document for THIS instance -------------------
+#
+# WHAT THIS IS FOR. A worker's `deployment` is the `/4` single-worker launch
+# document, and it carries an `input_manifest` digest-sealed over the Authority
+# and Work it serves, a `human_contract` naming the installed task bytes, and
+# the paths the instance derives. Nothing in the product composed one: every
+# installation to date was composed by a dossier script that copied a reviewed
+# deployment and resealed it by hand, which OBS-0a names as a product gap --
+# provisioning belongs to installation tooling, not to per-deployment scripts.
+#
+# WHAT IT DOES NOT DECIDE. The policy digests, the runtime profile, the adapter,
+# the engine and network, the credential selection, the workspace group and
+# capacity, the launch contract and the review route are DEPLOYMENT FACTS, and
+# they are taken from a reviewed worker document (`--like`) rather than invented
+# here. What is composed is only what is bound to THIS instance and THIS worker:
+# the Authority, the Work, the image, the task artifact, the identity and the
+# derived paths -- exactly the members the accepted composition substituted.
+
+VERB_COMPOSE = "compose-worker"
+# The members a reviewed document carries that are the OTHER instance's.
+_IDENTITY_BOUND = ("authority_uuid", "authority_store", "participant",
+                   "principal", "launch_role", "input_manifest",
+                   "task_document", "launch_home", "credential_home",
+                   "workspace_storage", "nominated_source")
+_MANIFEST_BOUND = ("work_ref", "worker_image_digest", "human_contract",
+                   "manifest_id", "created_at", "manifest_digest")
+_SHA256 = "sha256:"
+
+
+def _like_deployment(like):
+    """The reviewed deployment to inherit from: a worker entry or a bare one."""
+    if type(like) is not dict:
+        raise PoolRefusal("the document to compose like is one JSON object, "
+                          "not " + type(like).__name__ + ". Nothing was "
+                          "changed.")
+    deployment = like.get("deployment") if "deployment" in like else like
+    if type(deployment) is not dict:
+        raise PoolRefusal("the document to compose like names no deployment "
+                          "object. Nothing was changed.")
+    if deployment.get("schema") != single_worker.CONFIG_SCHEMA:
+        raise PoolRefusal(
+            "the document to compose like is "
+            + repr(deployment.get("schema")) + " and this verb composes "
+            + single_worker.CONFIG_SCHEMA + "; another version is not "
+            "reinterpreted. Nothing was changed.")
+    manifest = deployment.get("input_manifest")
+    if type(manifest) is not dict:
+        raise PoolRefusal("the document to compose like carries no input "
+                          "manifest to inherit the deployment's policy, "
+                          "profile, sources and outputs from. Nothing was "
+                          "changed.")
+    return deployment
+
+
+def _task_artifact(place):
+    """The installed task bytes this worker is sealed over, read once."""
+    try:
+        raw = Path(place).read_bytes()
+    except (FileNotFoundError, OSError) as failure:
+        raise PoolRefusal("the task document " + str(place) + " could not be "
+                          "read (" + type(failure).__name__ + "); a worker is "
+                          "sealed over task bytes that exist. Nothing was "
+                          "changed.")
+    if len(raw) > single_worker.MAX_TASK_BYTES:
+        raise PoolRefusal("the task document " + str(place) + " is wider "
+                          "than " + str(single_worker.MAX_TASK_BYTES)
+                          + " bytes, which the worker refuses. Nothing was "
+                          "changed.")
+    try:
+        held = json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError):
+        raise PoolRefusal("the task document " + str(place) + " is not one "
+                          "UTF-8 JSON document. Nothing was changed.")
+    if type(held) is not dict or type(held.get("task_id")) is not str \
+            or not held["task_id"]:
+        raise PoolRefusal("the task document " + str(place) + " names no "
+                          "task_id; the worker's human-contract artifact is "
+                          "named after it. Nothing was changed.")
+    from baton_v12.contracts import digest_of_bytes
+    return {"artifact_id": held["task_id"],
+            "media_type": "application/json", "bytes": len(raw),
+            "content_digest": digest_of_bytes(raw),
