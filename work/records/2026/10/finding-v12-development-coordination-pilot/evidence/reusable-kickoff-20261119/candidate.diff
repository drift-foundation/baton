+        manifest = check_manifest_structure(manifest, "inputManifest",
+                                            what="the composed input manifest")
+    except Exception as failure:                              # noqa: BLE001
+        raise PoolRefusal("the composed input manifest is not one the worker "
+                          "accepts: " + str(failure) + ". Nothing was changed.")
+    deployment = {name: value for name, value in base.items()
+                  if name not in _IDENTITY_BOUND}
+    deployment.update({
+        "image_digest": image_digest,
+        "input_manifest": manifest,
+        "task_document": str(task),
+        "launch_home": os.path.join(places["state"], "launch"),
+        "credential_home": os.path.join(places["state"], "credentials"),
+        "workspace_storage": os.path.join(places["destination"], "workers",
+                                          worker_id, "storage"),
+        "nominated_source": os.path.join(places["repository"],
+                                         "source-" + worker_id)})
+    worker = held_worker({"worker_id": worker_id, "role": role,
+                          "participant": participant,
+                          "deployment": deployment})
+    return {"worker": worker, "work_id": work,
+            "manifest_digest": manifest["manifest_digest"],
+            "human_contract": artifact,
+            "inherited_from": {"schema": base["schema"],
+                               "policy_digest": base.get("policy_digest"),
+                               "profile_digest": base.get("profile_digest"),
+                               "adapter_digest": base.get("adapter_digest")}}
+
+
+def compose(place, like, *, into, stream=sys.stdout, admit_into_pool=False,
+            **selection):
+    """Compose, write ONE new file, and only then -- if asked -- admit."""
+    held = read_configuration(place)
