+            snapshot, now=0, wall_now=EPOCH + model.STALE_SECONDS))
+        self.assertIn("!! STALE", stale)
+        self.assertIn("provider ran 15s", stale)
+        self.assertIn(self.OPEN_NOTE, stale)
+
