+        code, said = self.work_verb("list", "--label", "v12")
+        self.assertEqual(json.loads(said)["work"], [self.work])
+
+    def test_two_operands_that_are_one_key_refuse_before_any_effect(self):
+        self.installed()
+        refusal = self.stopped(self.labelled("v12", "V12"))
