+def layout_delivery(given, group):
+    """The trusted verifier-layout selection this deployment delivers, or None.
+
+    W325695. `None` IS THE EXPLICITLY LEGACY ANSWER and is what a `/4` or `/5`
+    configuration gets: nothing is composed, nothing is materialized, no mount
+    is added and the worker reads no document. A `/6` configuration naming its
+    image's marker gets the compatible pair.
+
+    THE IDENTITY IS NOT AN OPERAND. `workspaces.identity_for` mints it from the
+    deployment's own configured group -- the same capability `oci.run_vector`
+    composes into `--user` and the same one the four private roots are created
+    under -- so the document cannot name an identity the container will not run
+    as. The four digests are this configuration's own resolved identity, which
+    `OciAdapter` then refuses to disagree with.
+
+    MATERIALIZED UNDER THE MANAGER'S OWN LAUNCH HOME, which is manager-owned
+    storage rather than an assignment root: a document mounted out of `inputs`
+    would be one the input digest describes, and one out of `workspace` would
+    be one the worker may WRITE -- so the worker could rewrite the document its
+    own verifier roots are proved against.
+    """
+    marker = given.get("verifier_layout")
+    if marker is None:
+        return None
+    return source_boundary.materialize_verifier_layout(
+        given["launch_home"],
+        document=source_boundary.compose_verifier_layout(
+            marker=marker, identity=workspaces.identity_for(group),
+            image_digest=given["image_digest"],
+            profile_digest=given["profile_digest"],
+            policy_digest=given["policy_digest"],
+            adapter_digest=given["adapter_digest"]))
+
+
