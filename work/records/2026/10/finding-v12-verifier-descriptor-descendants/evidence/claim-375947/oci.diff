+def _selected_scratch(identity):
+    """The tmpfs operands a runtime holding a layout selection gets.
+
+    W325695 review 2026-10-28T17-58-14Z [2]: "Mount creation does not carry
+    the root identity or mode it promises." It did not. The worker's
+    `_proved_root` refuses a root whose mode is not 0700 or whose owner is not
+    the selection's uid AND gid -- and the composed operands carried only
+    `rw,noexec,nosuid,nodev,size`, so every one of those checks was being
+    asked of a root nothing had been told to create that way. Setting the
+    process `--user` is not a declaration of filesystem-root ownership, and
+    the image's root-owned 0755 MOUNTPOINT is not the mounted root: a fresh
+    tmpfs gets its own root inode with its own mode and owner.
+
+    SO THE FACTS THE WORKER CHECKS ARE THE FACTS THE ENGINE IS ASKED FOR,
+    `uid`, `gid` and `mode` on each of the four roots, from the SAME minted
+    identity this vector composes into `--user` and the same
+    `source_boundary.VERIFIER_MODE` the document names. The check is not
+    weakened anywhere; the creation is completed.
+
+    `/tmp` AND `/dev/shm` KEEP THEIR OWN SPELLING, with no identity options:
+    they are the ordinary shared scratch every runtime has always had, their
+    legacy mode is what tools expect of `/tmp`, and narrowing them here would
+    be a change nobody selected riding along with this one.
+    """
+    composed = []
+    private = {target for _name, target, _size
+               in source_boundary.VERIFIER_ROOTS}
+    for target, size in source_boundary.SELECTED_SCRATCH_MOUNTS:
+        held = f"{target}:rw,noexec,nosuid,nodev,size={size >> 20}m"
+        if target in private:
+            held += (f",uid={identity.uid},gid={identity.gid}"
+                     f",mode={source_boundary.VERIFIER_MODE:04o}")
+        composed.append(held)
+    return tuple(composed)
+
+
