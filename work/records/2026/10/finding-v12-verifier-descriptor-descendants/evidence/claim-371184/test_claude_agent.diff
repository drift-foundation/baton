+class TheSelectedPolicyConstants(unittest.TestCase):
+    """W325695 — the policy the cases above relax, pinned here.
+
+    `TheVerifierLayoutIsSelectedAndProved` substitutes the root-owned 0755
+    scaffolding because an unprivileged test cannot create it. That
+    substitution must not be able to hide a changed policy, so the shipped
+    constants are asserted directly.
+    """
+
+    def test_the_selected_topology_is_the_one_the_packet_names(self):
+        held = claude_agent.ClaudeAgent
+        self.assertEqual(held.LAYOUT_FILESYSTEM, "tmpfs")
+        self.assertEqual(sorted(held.LAYOUT_OPTIONS),
+                         sorted(("rw", "noexec", "nosuid", "nodev")))
+        self.assertEqual(held.LAYOUT_ANCESTOR_UID, 0)
+        self.assertEqual(held.LAYOUT_ANCESTOR_MODE, 0o755)
+        self.assertEqual(held.LAYOUT_SCHEMA, "baton.v12.verifier-layout/1")
+        self.assertEqual(held.LAYOUT_DOCUMENT,
+                         "/run/baton/verifier-layout.json")
+
+    def test_the_real_mount_table_parses_with_every_field(self):
+        """REAL mountinfo, and the fields review [R2] required kept."""
+        facts = claude_agent.ClaudeAgent._mount_facts()
+        self.assertIn("/", facts)
+        for place, one in facts.items():
+            self.assertTrue(place.startswith("/"), place)
+            for member in ("mount_id", "parent_id", "root", "filesystem"):
+                self.assertTrue(one[member], (place, member))
+            self.assertIsInstance(one["options"], set)
+            self.assertIsInstance(one["super_options"], set)
+        # The root filesystem's own options must include a mode, which is a
+        # fact about this host rather than about the parser.
+        self.assertTrue(facts["/"]["options"] & {"rw", "ro"})
+
+    def test_an_unreadable_mount_table_refuses(self):
+        with self.assertRaises(claude_agent.TaskRefusal) as caught:
+            claude_agent.ClaudeAgent._mount_facts("/nonexistent-mountinfo")
+        self.assertIn("mount table", str(caught.exception))
