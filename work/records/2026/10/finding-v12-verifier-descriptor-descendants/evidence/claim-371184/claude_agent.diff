+    def _layout_environment(self, environment, selection):
+        """The verifier environment the SELECTED layout supplies.
+
+        The roots are the selection's own fixed canonical paths, not the
+        scratch paths the legacy form uses -- which is the other half of
+        review [R2]: the mutable scratch environment must not be the input to
+        the new path. Descendants and nested canonical checks get ordinary
+        stable pathnames, which is the whole correction.
+        """
+        facts = self._mount_facts()
+        pinned = {"PATH": environment["PATH"]}
+        held = []
+        try:
+            for name in ("HOME", *(one for one, _l in self.EPHEMERA_ROOTS)):
+                place = selection["roots"][name]
+                held.append((name, self._proved_root(name, place, facts,
+                                                     selection)))
+                pinned[name] = place
+        except BaseException:
+            for _name, descriptor in held:
+                os.close(descriptor)
+            raise
+        return pinned, tuple(held)
