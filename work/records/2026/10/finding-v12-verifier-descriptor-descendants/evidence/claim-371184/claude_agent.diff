+    def _layout_preflight(self):
+        """Agree on the layout BEFORE the provider runs, or refuse.
+
+        TASK.md: "Worker and manager must agree on immutable layout identity
+        before provider launch", "Old image+new layout refuses before
+        provider; new image+missing/old layout refuses before provider." A
+        check that only ran at verification time would let a provider turn
+        spend a model invocation against a deployment that could never
+        verify.
+
+        It proves and then RELEASES. The descriptors the verifier is handed
+        are opened again at verification time, after the provider has had
+        write access, because a proof taken before the provider is not a
+        proof about the object the verifier gets.
+        """
+        selection = self._selected_layout()
+        if selection is None:
+            return None
+        _pinned, held = self._layout_environment(
+            {"PATH": os.environ.get("PATH", "")}, selection)
+        for _name, descriptor in held:
+            os.close(descriptor)
+        return selection
