+    def _proved_root(self, name, place, facts, selection):
+        """One selected root, proved against the selection. Returns its fd.
+
+        EVERY SELECTED FACT, and a refusal names which one failed: the
+        canonical selected pathname, the mount's existence as a mount, its
+        filesystem type, its exact options, immutable ancestors, mode 0700,
+        the trusted uid/gid the selection states -- never the ambient
+        process identity -- and the opened object's identity against the
+        named one.
+
+        THE DESCRIPTOR IS STILL OPENED AND STILL KEPT. The mount is what
+        makes the ordinary pathname safe; the descriptor remains the evidence
+        that the object did not move while it was being proved, and
+        `_revalidated_directories` re-asks it after the provider has run.
+        """
+        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+        try:
+            descriptor = os.open(place, flags)
+        except OSError as failed:
+            raise TaskRefusal(
+                f"the selected verifier root {name} at {place} cannot be "
+                f"opened as a directory ({type(failed).__name__}); a link, a "
+                f"missing name or an absent mount is a selected layout this "
+                f"image does not provide, and it refuses before the provider "
+                f"runs") from failed
+        try:
+            carried = facts.get(place)
+            if carried is None:
+                raise TaskRefusal(
+                    f"the selected verifier root {name} at {place} is not a "
+                    f"mount point in this runtime's own mount table; the "
+                    f"selected topology is a private mount per root, and an "
+                    f"ordinary directory can be renamed by a process sharing "
+                    f"this uid")
+            if carried["filesystem"] != selection["filesystem"]:
+                raise TaskRefusal(
+                    f"the selected verifier root {name} at {place} is a "
+                    f"{carried['filesystem']} mount and the selection names "
+                    f"{selection['filesystem']}")
+            required = set(selection["options"])
+            present = carried["options"] | carried["super_options"]
+            absent = sorted(required - present)
+            if absent:
+                raise TaskRefusal(
+                    f"the selected verifier root {name} at {place} is "
+                    f"mounted without {', '.join(absent)}; the selection "
+                    f"names {sorted(required)}")
+            self._proved_ancestors(place, facts)
+            state = os.fstat(descriptor)
+            named = os.lstat(place)
+            if not stat.S_ISDIR(state.st_mode):
