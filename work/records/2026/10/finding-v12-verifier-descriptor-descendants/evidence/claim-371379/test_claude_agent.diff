+    def test_a_root_replaced_by_an_identical_mount_refuses(self):
+        """MOUNT IDENTITY, BOUND ACROSS THE TWO CHECKS.
+
+        Review [R2]: "Mount identity fields are parsed but not bound across
+        checks; retain/prove exact mount/object lifetime required by the
+        accepted mechanism." A root unmounted and a FRESH tmpfs mounted at
+        the same path with the same type and the same options satisfies every
+        per-field check; what it is not is the object the proof was taken
+        over, and only the retained mount identity can say so.
+        """
+        selection = self.selection()
+        held, _environment, pinned, directories = self.composed(selection)
+        facts = self.facts_for(selection)
+        for place in facts:
+            facts[place]["mount_id"] = "9999"
+        with mock.patch.object(claude_agent.ClaudeAgent, "LAYOUT_DOCUMENT",
+                               os.path.join(self.home,
+                                            "verifier-layout.json")):
+            with contextlib.ExitStack() as stack:
+                for one in self.under(selection, facts):
+                    stack.enter_context(one)
+                with self.assertRaises(claude_agent.TaskRefusal) as caught:
+                    held._revalidated_directories(pinned, directories)
+        said = str(caught.exception)
+        self.assertIn("is a different mount than the one that was proved",
+                      said)
