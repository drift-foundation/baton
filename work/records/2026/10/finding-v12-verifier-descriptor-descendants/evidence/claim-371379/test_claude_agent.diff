+    def test_a_read_only_mount_over_a_writable_superblock_refuses(self):
+        """THE REVIEW'S OWN COUNTEREXAMPLE TO THE UNION, driven.
+
+        Review 2026-10-28T03-25-24Z [R2]: "_proved_root and revalidation
+        combine per-mount and superblock option sets. That union can report
+        rw from the filesystem while the mount is ro." Here the mount is `ro`
+        and the superblock is `rw`, so the union the first cut computed
+        contained `rw` and passed. The layered check refuses, and the mount
+        layer is what the kernel actually applies.
+        """
+        selection = self.selection()
+        facts = self.facts_for(
+            selection, options={"ro", "noexec", "nosuid", "nodev"},
+            super_options={"rw", "size=4096k"})
+        said = self.refusing(selection, facts)
+        self.assertIn("not effectively writable", said)
+        self.assertIn("'ro'", said)
+
+    def test_a_read_only_superblock_under_a_writable_mount_refuses(self):
+        """The other direction, which the kernel also decides.
+
+        A read-only superblock makes every mount of it read-only no matter
+        what the per-mount options say, so `rw` in field 6 is not enough.
+        """
+        selection = self.selection()
+        facts = self.facts_for(
+            selection, options={"rw", "noexec", "nosuid", "nodev"},
+            super_options={"ro", "size=4096k"})
+        self.assertIn("not effectively writable",
+                      self.refusing(selection, facts))
