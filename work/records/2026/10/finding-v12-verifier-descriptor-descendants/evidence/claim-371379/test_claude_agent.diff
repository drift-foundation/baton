+    def test_per_mount_flags_are_not_satisfied_by_the_superblock(self):
+        """`noexec` on the superblock does not make THIS mount noexec.
+
+        A bind of the same superblock can lack the flag entirely, so the
+        per-mount layer is the only one that answers for this mount -- and
+        `noexec` is what keeps a writable verifier root from being a place to
+        run code.
+        """
+        selection = self.selection()
+        facts = self.facts_for(
+            selection, options={"rw"},
+            super_options={"rw", "noexec", "nosuid", "nodev"})
+        said = self.refusing(selection, facts)
+        self.assertIn("nodev, noexec, nosuid", said)
+        self.assertIn("a superblock's own copy does not supply", said)
