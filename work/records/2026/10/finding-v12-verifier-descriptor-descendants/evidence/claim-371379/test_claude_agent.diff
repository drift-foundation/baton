+    def test_the_ancestors_are_actually_reproved_after_the_provider(self):
+        """The claim and the enforced lifecycle now MATCH.
+
+        Review [R2]: "Revalidation comments claim ancestor reproof but current
+        revalidation does not call _proved_ancestors. Ensure actual enforced
+        lifecycle matches claims." The previous cut's comment said they were
+        re-asked and the code never called it. This case fails if the call is
+        removed again: the ancestor proof is replaced with one that refuses,
+        and revalidation must reach it.
+        """
+        selection = self.selection()
+        held, _environment, pinned, directories = self.composed(selection)
+        reached = []
+
+        def refuse(self, place, facts):
+            reached.append(place)
+            raise claude_agent.TaskRefusal(
+                f"a writable ancestor appeared above {place}")
+
+        with mock.patch.object(claude_agent.ClaudeAgent, "LAYOUT_DOCUMENT",
+                               os.path.join(self.home,
+                                            "verifier-layout.json")):
+            with contextlib.ExitStack() as stack:
+                for one in self.under(selection, ancestors=False):
+                    stack.enter_context(one)
+                stack.enter_context(mock.patch.object(
+                    claude_agent.ClaudeAgent, "_proved_ancestors", refuse))
+                with self.assertRaises(claude_agent.TaskRefusal) as caught:
+                    held._revalidated_directories(pinned, directories)
+        self.assertTrue(reached, "revalidation never re-asked the ancestors")
+        self.assertIn("a writable ancestor appeared above",
+                      str(caught.exception))
