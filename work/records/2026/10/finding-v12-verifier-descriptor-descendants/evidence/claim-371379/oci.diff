+def _layout_mount(delivered):
+    """The one read-only bind a verifier-layout delivery authorizes.
+
+    A TYPED DELIVERY AND NEVER A PAIR, which is where this deliberately
+    differs from `_launch_mount`: the launch document's pair comes off a
+    `LaunchDelivery` the adapter already holds, and this one is composed from
+    the delivery itself because `run_vector` has a PROOF to make about the
+    document -- that its uid/gid is the identity being composed into `--user`
+    -- and a pair of paths carries no document to prove anything about.
+    """
+    if type(delivered) is not source_boundary.LayoutDelivery:
+        _refuse(f"a verifier-layout delivery is one this manager "
+                f"materialized; this is {name_value(delivered)}")
+    pair = delivered.mount()
+    source = canonical_source(pair[0], "a verifier-layout document source")
+    target = boundaries.text(pair[1], "a verifier-layout document target")
+    if target != source_boundary.LAYOUT_TARGET:
+        _denied(f"a verifier-layout delivery lands on {name_value(target)}; "
+                f"the worker reads its trusted layout selection at "
+                f"{name_value(source_boundary.LAYOUT_TARGET)}, which is a "
+                f"constant of this contract rather than an operand")
+    if not os.path.isfile(source):
+        _refuse(f"a verifier-layout delivery names {name_value(source)}, "
+                f"which is not a regular file; the trusted layout selection "
+                f"is one document at one path -- a directory bound over it is "
+                f"a path no document can be read from, and a link is a source "
+                f"this manager would be resolving on the worker's behalf",
+                code="path")
+    return source, target
+
