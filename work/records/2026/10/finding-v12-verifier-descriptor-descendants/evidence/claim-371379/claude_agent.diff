+            with open(place, "rb") as reading:
+                raw = reading.read(self.MAX_LAYOUT_BYTES + 1)
+        except OSError as failed:
+            raise TaskRefusal(
+                f"{what} at {place} cannot be read "
+                f"({type(failed).__name__}); {because}") from failed
+        if len(raw) > self.MAX_LAYOUT_BYTES:
+            raise TaskRefusal(
+                f"{what} at {place} is larger than "
+                f"{self.MAX_LAYOUT_BYTES} bytes; a document this manager "
+                f"would not write is not one to read the recognised parts "
+                f"out of")
+        try:
+            held = json.loads(raw.decode("utf-8"))
+        except (UnicodeDecodeError, ValueError, RecursionError) as failed:
+            raise TaskRefusal(
+                f"{what} at {place} is not a readable document; "
+                f"{because}") from failed
+        if type(held) is not dict:
+            raise TaskRefusal(f"{what} at {place} is not a document")
+        return held
