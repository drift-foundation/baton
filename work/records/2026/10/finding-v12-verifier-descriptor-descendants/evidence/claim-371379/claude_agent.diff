+    @classmethod
+    def _mount_facts(cls, place=None):
+        """Every mount this process holds, with the fields the proof needs.
+
+        Review [R2]: the first cut kept only the mount point, so it proved
+        presence rather than the selected topology -- the reviewer's own probe
+        passed `ext4,rw` records at mutable scratch roots straight through it.
+        `mountinfo` carries the filesystem type, the per-mount options and the
+        superblock options, and all three are part of what was selected, so
+        all three are kept.
+
+        `os.path.ismount` is still not used, for the reason it never was: it
+        compares `st_dev` with the parent, which a bind mount inside one
+        filesystem does not change.
+        """
+        held = {}
+        try:
+            with open(place or cls.MOUNTINFO, "r", encoding="utf-8") as table:
+                raw = table.read()
+        except OSError as failed:
+            raise TaskRefusal(
+                f"this runtime cannot read {place or cls.MOUNTINFO} "
+                f"({type(failed).__name__}); the selected verifier topology "
+                f"is a question only the mount table answers, and this "
+                f"adapter will not assume it") from failed
+        for line in raw.splitlines():
+            fields = line.split(" ")
+            if len(fields) < 10 or "-" not in fields:
+                continue
+            separator = fields.index("-")
+            if separator + 2 >= len(fields):
+                continue
+            point = fields[4]
+            for sequence, character in (("\\040", " "), ("\\011", "\t"),
+                                        ("\\012", "\n"), ("\\134", "\\")):
+                point = point.replace(sequence, character)
+            held[point] = {
+                "mount_id": fields[0], "parent_id": fields[1],
+                "device": fields[2], "root": fields[3], "point": point,
+                "options": set(fields[5].split(",")),
+                "filesystem": fields[separator + 1],
+                "super_options": set(fields[separator + 3].split(","))
+                if separator + 3 < len(fields) else set()}
+        return held
+
+    MOUNTINFO = "/proc/self/mountinfo"
+
+    def _proved_ancestors(self, place, facts):
+        """Every ancestor of a selected root is immutable image scaffolding.
+
+        TASK.md selects "ordinary root-owned 0755 image directories in
+        read-only rootfs, outside all writable mounts; no mutable ancestor",
+        and review [R2] is right that the first cut proved none of it. A
+        writable ancestor is a directory a process sharing this uid can
+        rename, which would put the selected root back inside the race the
+        whole mechanism exists to leave.
+        """
+        name = os.path.dirname(place)
+        while True:
+            try:
+                state = os.lstat(name)
+            except OSError as failed:
+                raise TaskRefusal(
+                    f"the selected verifier root {place} has an ancestor "
+                    f"{name} this runtime cannot read "
+                    f"({type(failed).__name__})") from failed
+            if not stat.S_ISDIR(state.st_mode):
+                raise TaskRefusal(
+                    f"the selected verifier root {place} has an ancestor "
+                    f"{name} that is not an ordinary directory")
+            if state.st_uid != self.LAYOUT_ANCESTOR_UID:
+                raise TaskRefusal(
+                    f"the selected verifier root {place} has an ancestor "
+                    f"{name} owned by uid {state.st_uid}; the selected "
+                    f"scaffolding is image material owned by "
+                    f"{self.LAYOUT_ANCESTOR_UID}")
+            if stat.S_IMODE(state.st_mode) != self.LAYOUT_ANCESTOR_MODE:
+                raise TaskRefusal(
+                    f"the selected verifier root {place} has an ancestor "
+                    f"{name} with mode "
+                    f"{stat.S_IMODE(state.st_mode):04o}, not "
+                    f"{self.LAYOUT_ANCESTOR_MODE:04o}")
+            carried = facts.get(name)
+            if carried is not None and "ro" not in carried["options"]:
+                raise TaskRefusal(
+                    f"the selected verifier root {place} has an ancestor "
+                    f"{name} that is a WRITABLE mount "
+                    f"({carried['filesystem']}); a selected root inside a "
+                    f"writable mount has a mutable ancestor and is not "
+                    f"protected by being a mount itself")
+            if name == "/":
+                break
+            name = os.path.dirname(name)
+
+    @classmethod
+    def _proved_options(cls, name, place, carried, selection, moment="is"):
+        """The EFFECTIVE mount semantics, each asked at the layer that decides.
+
+        Review [R2]: "_proved_root and revalidation combine per-mount and
+        superblock option sets. That union can report rw from the filesystem
+        while the mount is ro. Check effective mount semantics at the proper
+        layer." It is right, and the two layers are not interchangeable:
+
+          - `noexec`, `nosuid` and `nodev` are PER-MOUNT. The kernel applies
+            them to this mount, a bind of the same superblock elsewhere can
+            lack them entirely, and the superblock's own copy says nothing
+            about this one. So they are required in field 6 and a superblock
+            copy does NOT satisfy them -- which is the exact substitution the
+            union allowed, and it is the one that matters: `noexec` is what
+            keeps a writable verifier root from being a place to run code.
+          - WRITABILITY IS THE CONJUNCTION of both layers, because the kernel
+            treats it that way: a read-only superblock makes every mount of
+            it read-only no matter what the mount options say, and a read-only
+            mount is read-only over a writable superblock. So `rw` must hold
+            at BOTH layers and `ro` at EITHER refuses.
+        """
+        required = set(selection["options"])
+        mount = carried["options"]
+        sealed = carried["super_options"]
+        absent = sorted(one for one in cls.LAYOUT_MOUNT_OPTIONS
+                        if one in required and one not in mount)
+        if absent:
+            raise TaskRefusal(
+                f"the selected verifier root {name} at {place} {moment} "
+                f"mounted without {', '.join(absent)}; the selection names "
+                f"{sorted(required)}, and these are per-mount options that a "
+                f"superblock's own copy does not supply to this mount")
+        if "rw" in required:
+            if "ro" in mount or "ro" in sealed or "rw" not in mount:
+                raise TaskRefusal(
+                    f"the selected verifier root {name} at {place} {moment} "
+                    f"not effectively writable: its mount options are "
+                    f"{sorted(mount)} and its superblock options are "
+                    f"{sorted(sealed)}. A read-only superblock makes every "
+                    f"mount of it read-only, so this is asked at both layers "
+                    f"rather than as a union that one of them can satisfy "
+                    f"for the other")
+        # Anything else the selection names is required at the per-mount
+        # layer too, rather than silently unchecked.
+        others = sorted(required - set(cls.LAYOUT_MOUNT_OPTIONS) - {"rw"}
+                        - mount)
+        if others:
+            raise TaskRefusal(
+                f"the selected verifier root {name} at {place} {moment} "
+                f"mounted without {', '.join(others)}")
+
+    def _proved_root(self, name, place, facts, selection):
+        """One selected root, proved against the selection. Returns its fd.
+
+        EVERY SELECTED FACT, and a refusal names which one failed: the
+        canonical selected pathname, the mount's existence as a mount, its
+        filesystem type, its exact options, immutable ancestors, mode 0700,
+        the trusted uid/gid the selection states -- never the ambient
+        process identity -- and the opened object's identity against the
+        named one.
+
+        THE DESCRIPTOR IS STILL OPENED AND STILL KEPT. The mount is what
+        makes the ordinary pathname safe; the descriptor remains the evidence
+        that the object did not move while it was being proved, and
+        `_revalidated_directories` re-asks it after the provider has run.
+        """
+        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+        try:
+            descriptor = os.open(place, flags)
+        except OSError as failed:
+            raise TaskRefusal(
+                f"the selected verifier root {name} at {place} cannot be "
+                f"opened as a directory ({type(failed).__name__}); a link, a "
+                f"missing name or an absent mount is a selected layout this "
+                f"image does not provide, and it refuses before the provider "
+                f"runs") from failed
+        try:
+            carried = facts.get(place)
+            if carried is None:
+                raise TaskRefusal(
+                    f"the selected verifier root {name} at {place} is not a "
+                    f"mount point in this runtime's own mount table; the "
+                    f"selected topology is a private mount per root, and an "
+                    f"ordinary directory can be renamed by a process sharing "
+                    f"this uid")
+            if carried["filesystem"] != selection["filesystem"]:
+                raise TaskRefusal(
+                    f"the selected verifier root {name} at {place} is a "
+                    f"{carried['filesystem']} mount and the selection names "
+                    f"{selection['filesystem']}")
+            self._proved_options(name, place, carried, selection)
+            self._proved_ancestors(place, facts)
+            state = os.fstat(descriptor)
+            named = os.lstat(place)
+            if not stat.S_ISDIR(state.st_mode):
+                raise TaskRefusal(
+                    f"the selected verifier root {name} at {place} is not a "
+                    f"directory")
+            if stat.S_IMODE(state.st_mode) != 0o700:
+                raise TaskRefusal(
