+    def _bounded_document(self, place, what, because):
+        """One bounded, no-follow read of one small trusted document.
+
+        BOTH SIDES OF THE AGREEMENT GO THROUGH HERE, so the delivered
+        selection and the image's own marker cannot be read under two
+        different disciplines -- which is how one of them would quietly keep
+        an unbounded read after the other was fixed.
