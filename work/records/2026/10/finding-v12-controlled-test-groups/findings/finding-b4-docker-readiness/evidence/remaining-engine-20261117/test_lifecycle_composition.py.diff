+def selected_reference_image(engine):
+    """Reuse only an explicitly selected immutable reference-worker image."""
+    selected = os.environ.get("BATON_V12_LIFECYCLE_IMAGE")
+    if selected is None:
+        return None
+    assert selected.startswith("sha256:") and len(selected) == 71, selected
+    assert all(c in "0123456789abcdef" for c in selected[7:]), selected
+    found = subprocess.run([engine, "image", "inspect", selected], capture_output=True, timeout=120)
+    assert found.returncode == 0, found.stderr.decode("utf-8", "replace")
+    info = json.loads(found.stdout)[0]
+    assert info["Id"] == selected and not info["Config"].get("Volumes"), info["Id"]
+    return selected
+
+
+def assert_owned_containers_absent(case, engine, names):
+    """Ask the daemon about exactly the names registered by this class run."""
+    found = subprocess.run([engine, "ps", "--all", "--format", "{{.Names}}"], capture_output=True, timeout=120)
+    case.assertEqual(found.returncode, 0, found.stderr.decode("utf-8", "replace"))
+    case.assertEqual(set(found.stdout.decode("utf-8").split()) & set(names), set())
+
