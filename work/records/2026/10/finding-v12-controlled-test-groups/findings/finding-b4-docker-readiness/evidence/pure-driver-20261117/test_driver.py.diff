+    def execution_roots(self):
+        """Record the real writer trees before cleanup and compare after it."""
+        from hashlib import sha256
+        from pathlib import Path
+        result = {}
+        for name in ("inputs", "workspace"):
+            root = Path(self.adapter.roots[name])
+            self.case.assertTrue(root.is_dir(), str(root))
+            for place in [root, *sorted(root.rglob("*"))]:
+                info = place.lstat()
+                content = os.readlink(place) if place.is_symlink() else sha256(place.read_bytes()).hexdigest() if place.is_file() else None
+                result[(name, str(place.relative_to(root)))] = (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid, content)
+        return result
 
