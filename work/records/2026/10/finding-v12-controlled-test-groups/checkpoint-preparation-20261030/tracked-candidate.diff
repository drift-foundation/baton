diff --git a/v12/python/justfile b/v12/python/justfile
index 27317b7a..68e0e1c9 100644
--- a/v12/python/justfile
+++ b/v12/python/justfile
@@ -191,3 +191,91 @@ parallel-gate JOBS='': version
     # is what records that the installed-layout replay ran too, since `build`
     # reports its own tail and `set -e` means nothing reaches here otherwise.
     echo "[parallel-gate] version, parallel source, serial source and the locked installed layout all ran"
+
+# -- W384870: the supported test entries ------------------------------------
+#
+# THREE ENTRIES, ONE RUNNER. `test-all` is the full supported run and the only
+# one whose clean result is acceptance evidence; `test-group` runs one logical
+# group of `tools/parallel_test.py`'s exact partition; `test-one` runs named
+# unittest ids. All three use the PREPARED interpreter (`just setup`), never
+# the ambient one, so the validator that ran is the one the lock pins.
+#
+# Accounting is exact in `test-all` and `test-group`: the runner collects every
+# id the selected registries declare, executes each exactly once, and reports
+# `passed + optional skipped = collected` with zero failures, errors, duplicates
+# or unaccounted ids. A skip outside the runner's OPTIONAL_SKIPS registry is a
+# required proof that did not run, and fails.
+
+# Run exactly one logical test group with exact test-identity accounting.
+test-group GROUP JOBS='':
+    #!/usr/bin/env bash
+    set -euo pipefail
+    cd "$(dirname "{{justfile()}}")"
+    PREPARED="$(python3 -m tools.environment interpreter)"
+    ARGS=(--group "{{GROUP}}" --account --keep-going)
+    case "{{GROUP}}" in
+        tools-packaged) export BATON_V12_STACK_PACKAGING_REQUIRED=1 ;;
+        supervised) ARGS+=(--with-supervised) ;;
+    esac
+    if [[ -n "{{JOBS}}" ]]; then ARGS+=(--jobs "{{JOBS}}"); fi
+    exec "$PREPARED" tools/parallel_test.py "${ARGS[@]}"
+
+# Run named unittest ids (package.module[.Class[.method]]) on the prepared interpreter.
+test-one +IDS:
+    #!/usr/bin/env bash
+    set -euo pipefail
+    cd "$(dirname "{{justfile()}}")"
+    PREPARED="$(python3 -m tools.environment interpreter)"
+    PYTHONPATH=src exec "$PREPARED" -m unittest -v {{IDS}}
+
+# THE full supported run, with a retained log. LOG is an absolute path outside
+# /tmp; the JSON ledger lands beside it as LOG-with-.summary.json and the
+# supervised run directories beside it too. The log header records the exact
+# source identity (HEAD, dirty-path count and digest), interpreter, validator,
+# daemon, uid, CPU count, user-namespace capability and the selected image.
+# A fresh bundle is built first unless BATON_V12_STACK_DISTRO names one, and
+# the packaged cases are REQUIRED. The supervised deadline gate needs
+# BATON_W32577_IMAGE_DIGEST, the reviewed preloaded reference-worker image.
+test-all LOG JOBS='':
+    #!/usr/bin/env bash
+    set -euo pipefail
+    cd "$(dirname "{{justfile()}}")"
+    LOG="{{LOG}}"
+    case "$LOG" in
+        /tmp/*) echo "error: LOG under /tmp is not retained; name a path on real storage" >&2; exit 1 ;;
+        /*) ;;
+        *) echo "error: LOG must be an absolute path" >&2; exit 1 ;;
+    esac
+    : "${BATON_W32577_IMAGE_DIGEST:?set BATON_W32577_IMAGE_DIGEST to the reviewed preloaded reference-worker image digest (sha256:...)}"
+    mkdir -p "$(dirname "$LOG")"
+    PREPARED="$(python3 -m tools.environment interpreter)"
+    export BATON_V12_STACK_PACKAGING_REQUIRED=1
+    {
+        echo "[test-all] started $(date -u +%FT%TZ)"
+        "$PREPARED" -m tools.source_identity --repo "$(git rev-parse --show-toplevel)" v12 > "${LOG%.log}.source.json"
+        echo "[test-all] source HEAD $("$PREPARED" -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["head"])' "${LOG%.log}.source.json") changed-files $("$PREPARED" -c 'import json,sys; print(json.load(open(sys.argv[1]))["changed_count"])' "${LOG%.log}.source.json") content-digest $("$PREPARED" -c 'import json,sys; print(json.load(open(sys.argv[1]))["content_digest"])' "${LOG%.log}.source.json") scope v12 (HEAD + sha256 of every modified/untracked file under v12; gitignored and out-of-scope paths excluded; per-file list in the .source.json beside this log)"
+        echo "[test-all] python $("$PREPARED" -c 'import sys; print(sys.version.split()[0])') jsonschema $("$PREPARED" -c 'import importlib.metadata as m; print(m.version("jsonschema"))') docker $(docker version 2>/dev/null | awk '/Server:/{s=1} s && /Version:/{print $2; exit}') uid $(id -u) cpus $(nproc) userns $(unshare -rm true 2>/dev/null && echo yes || echo no) tmpfs-tmp $(findmnt -no FSTYPE /tmp 2>/dev/null || echo unknown)"
+        echo "[test-all] image $BATON_W32577_IMAGE_DIGEST distro ${BATON_V12_STACK_DISTRO:-(fresh build)}"
+    } | tee "$LOG"
+    if [[ -z "${BATON_V12_STACK_DISTRO:-}" ]]; then
+        echo "[test-all] building a fresh bundle" | tee -a "$LOG"
+        "{{just_executable()}}" --justfile "$(dirname "{{justfile()}}")/../justfile" build 2>&1 | tail -n 5 | tee -a "$LOG"
+    fi
+    ARGS=(--phase all --with-supervised --account --keep-going --summary "${LOG%.log}.summary.json" --retain "$(dirname "$LOG")")
+    if [[ -n "{{JOBS}}" ]]; then ARGS+=(--jobs "{{JOBS}}"); fi
+    set +e
+    "$PREPARED" tools/parallel_test.py "${ARGS[@]}" 2>&1 | tee -a "$LOG"
+    CODE=${PIPESTATUS[0]}
+    # DRIFT IS VISIBLE: the identity is taken again after the run; if the tested
+    # bytes changed under the run, the evidence names it and the run fails.
+    "$PREPARED" -m tools.source_identity --repo "$(git rev-parse --show-toplevel)" v12 > "${LOG%.log}.source-after.json"
+    BEFORE=$("$PREPARED" -c 'import json,sys; print(json.load(open(sys.argv[1]))["content_digest"])' "${LOG%.log}.source.json")
+    AFTER=$("$PREPARED" -c 'import json,sys; print(json.load(open(sys.argv[1]))["content_digest"])' "${LOG%.log}.source-after.json")
+    if [[ "$BEFORE" != "$AFTER" ]]; then
+        echo "[test-all] SOURCE DRIFT during the run: content-digest $BEFORE -> $AFTER; compare the two .source*.json files; this run does not identify one candidate" | tee -a "$LOG"
+        CODE=1
+    else
+        echo "[test-all] source unchanged during the run (content-digest $AFTER)" | tee -a "$LOG"
+    fi
+    echo "[test-all] finished $(date -u +%FT%TZ) exit $CODE" | tee -a "$LOG"
+    exit "$CODE"
