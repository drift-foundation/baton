+             verification_context.MATERIALIZATION,
+             verification_context.TRANSPORT_DETAIL),
+            (["git", "--git-dir", metadata, "--work-tree", destination,
+              "checkout", "--quiet", "--detach", head],
+             verification_context.MATERIALIZATION,
+             verification_context.TRANSPORT_DETAIL)):
