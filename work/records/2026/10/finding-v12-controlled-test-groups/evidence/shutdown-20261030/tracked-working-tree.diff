+            held = sealed[one["name"]]
+            place = os.path.join(root, one["destination"])
+            os.makedirs(os.path.dirname(place), exist_ok=True)
+            try:
+                shutil.copyfile(os.path.join(seal_root, held["place"]), place)
+            except OSError:
