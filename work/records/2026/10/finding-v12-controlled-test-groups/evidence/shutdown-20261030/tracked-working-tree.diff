+        self.assertEqual(
+            baton_worker.session_of(baton_worker.container_of(document)),
+            self.SESSION)
+        # AND THE RULE IS NARROW: only an outer document DECLARING this
+        # wrapper with an object payload is unwrapped. Nothing else is
