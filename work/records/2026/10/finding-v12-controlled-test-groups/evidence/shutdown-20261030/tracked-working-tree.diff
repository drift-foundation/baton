+                _check_prerequisite_chain(handles)
+            _check_prerequisite_chain(handles)
+            for _who, _name, place in prerequisite_places(document):
+                if not os.access('/proc/self/fd/' + str(handles[place]), os.R_OK | os.W_OK | os.X_OK):
