+def _view_digest(root, relative):
+    """One view path's digest spelling, or `None` when it is not there."""
+    import hashlib
+
+    try:
+        with open(os.path.join(root, relative), "rb") as reading:
+            return "sha256:" + hashlib.sha256(reading.read()).hexdigest()
+    except OSError:
+        return None
+
