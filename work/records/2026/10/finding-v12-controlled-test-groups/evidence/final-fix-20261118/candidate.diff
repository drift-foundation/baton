+                   "--mount", f"type=bind,source={outputs},target=/output,readonly=false",
+                   self.image, "-c", "rm -rf /output/* /output/.[!.]* 2>/dev/null; true",
+                   timeout=120)
+        disk_roots.remove_owned_root(home)
