+def _contained_read(root, reference):
+    """Open ONE contained regular file under `root`, or say why not.
+
+    Returns `(state, digest, bytes)`; the digest is `None` unless the state is
+    `present`.
+
+    WHY THIS IS NOT `os.path.join` PLUS `isfile`. That is what this command did,
+    and `isfile` and `open` both FOLLOW SYMLINKS: a reference the authority
+    accepts as relative -- `escape`, say -- symlinked to a file outside the root
+    was read and reported as intact evidence under that root. The review
+    reproduced it through the public command, exit 0 twice.
+
+    THE WALK REFUSES A SYMLINK AT EVERY DEPTH, not just the last component. An
+    intermediate `a -> /tmp` makes `a/b` out of root just as surely as a final
+    link does, and a check that only `lstat`s the leaf would miss it.
+
+    AND THE RACE IS CLOSED BY READING THE DESCRIPTOR IT CHECKED. Between an
+    `lstat` and an `open`, a path can be replaced -- so the final component is
+    opened with `O_NOFOLLOW` and `O_RDONLY`, the OPEN DESCRIPTOR is `fstat`ed to
+    confirm it is a regular file, and the bytes are digested from that same
+    descriptor. Nothing is re-resolved by name after the decision.
+
+    `realpath` is used only to establish the root itself, which is the one path
+    a caller is entitled to have resolved for them.
+    """
+    try:
+        whole_root = os.path.realpath(root)
+    except OSError:
+        return EVIDENCE_UNREADABLE, None, None
+    if not os.path.isdir(whole_root):
+        return EVIDENCE_UNREADABLE, None, None
+    held = whole_root
+    segments = [one for one in reference.split("/") if one]
+    for index, segment in enumerate(segments):
+        held = os.path.join(held, segment)
+        try:
+            about = os.lstat(held)
+        except FileNotFoundError:
+            return EVIDENCE_ABSENT, None, None
+        except OSError:
+            return EVIDENCE_UNREADABLE, None, None
+        if stat.S_ISLNK(about.st_mode):
+            # NAMED AS AN ESCAPE WHETHER OR NOT IT HAPPENS TO POINT INSIDE.
+            # A link's target can be replaced after this answer, so a contained
+            # resolution cannot depend on where one pointed at check time.
+            return EVIDENCE_ESCAPES, None, None
+        last = index == len(segments) - 1
+        if not last and not stat.S_ISDIR(about.st_mode):
+            return EVIDENCE_NOT_REGULAR, None, None
+    try:
+        descriptor = os.open(held, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
+    except FileNotFoundError:
+        return EVIDENCE_ABSENT, None, None
+    except OSError:
+        return EVIDENCE_UNREADABLE, None, None
+    try:
+        about = os.fstat(descriptor)
+        if not stat.S_ISREG(about.st_mode):
+            return EVIDENCE_NOT_REGULAR, None, None
+        return EVIDENCE_PRESENT, _digest_fd(descriptor), about.st_size
+    except OSError:
+        return EVIDENCE_UNREADABLE, None, None
+    finally:
+        os.close(descriptor)
+
