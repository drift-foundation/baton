+class AdoptedHelperOriginsAreContextual(unittest.TestCase):
+    """Small independent sources name expected entries, not scanner output."""
+
+    def fragment(self, text, name="sample.py"):
+        return pathlib.Path(name), ast.parse(text)
+
+    def entries(self, sources, site):
+        returned = _returned_origins(sources)
+        source, tree = next((source, tree) for source, tree in sources if site.startswith(source.name + ":"))
+        node = dict(_functions(tree, source.name))[site]
+        origins = _origins(node, site, returned)
+        return _through_helpers({}, site, node, origins, _helpers(tree, source.name), returns=returned)
+
+    def test_positional_keyword_and_chained_adopted_reads_keep_the_read_site(self):
+        for call in ("_view(row)", "_view(row=row)", "_bridge(row=row)"):
+            with self.subTest(call=call):
+                source = self.fragment(f'''
+def _row(connection):
+    return connection.execute("SELECT * FROM interrogations").fetchone()
+def _bridge(*, row):
+    return _view(row=row)
+def _view(row):
+    return row["operation_id"], row.get("settled_at")
+def public(connection):
+    row = _row(connection)
+    return {call}
+''')
+                self.assertEqual(self.entries([source], "sample.py:public"), {
+                    ("adopted", "sample.py:_row", "interrogations.operation_id"),
+                    ("adopted", "sample.py:_row", "interrogations.settled_at")})
+
