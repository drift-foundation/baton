+def _local_bindings(node):
+    """Names that prevent a function from borrowing a module's callable.
+
+    Parameters and assignments bind locally even before an assignment executes.
+    A nested function/class body and a comprehension's targets have their own
+    scope. Imports are resolved separately, only when no competing binding exists.
+    """
+    names = set(_parameters(node)) - {"self", "cls"}
+
+    class Bindings(ast.NodeVisitor):
+        def visit_Name(self, piece):
+            if isinstance(piece.ctx, (ast.Store, ast.Del)):
+                names.add(piece.id)
+
+        def visit_FunctionDef(self, piece):
+            names.add(piece.name)
+
+        visit_AsyncFunctionDef = visit_FunctionDef
+        visit_ClassDef = visit_FunctionDef
+
+        def visit_Lambda(self, piece):
+            pass
+
+        def visit_ListComp(self, piece):
+            self.visit(piece.generators[0].iter)
+
+        visit_SetComp = visit_ListComp
+        visit_DictComp = visit_ListComp
+        visit_GeneratorExp = visit_ListComp
+
+        def visit_ExceptHandler(self, piece):
+            if piece.name is not None:
+                names.add(piece.name)
+            self.generic_visit(piece)
+
+    visitor = Bindings()
+    for statement in node.body:
+        visitor.visit(statement)
+    return names
 
 
