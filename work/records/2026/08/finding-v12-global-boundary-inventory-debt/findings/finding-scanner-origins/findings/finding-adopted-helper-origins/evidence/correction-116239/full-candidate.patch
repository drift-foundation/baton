+def _helper_site(called, site, imports=None):
+    """Resolve local functions and self methods without borrowing a namesake."""
+    if site is None:
+        return None
+    module, lexical = site.split(":", 1)
+    imports = imports or {}
+
+    def imported(name):
+        return imports.get(("import", site, name), imports.get(("import", f"{module}:*", name)))
+
+    if isinstance(called, ast.Name):
+        if imports.get(("shadow", site, called.id)):
+            return None
+        return imported(called.id) or f"{module}:{called.id}"
+    if isinstance(called, ast.Attribute) and isinstance(called.value, ast.Name):
+        if imports.get(("shadow", site, called.value.id)):
+            return None
+        if called.value.id in ("self", "cls") and "." in lexical:
+            return f"{module}:{lexical.rsplit('.', 1)[0]}.{called.attr}"
+        target = imported(called.value.id)
+        if target is not None and target.endswith(":"):
+            return target + called.attr
+        # A qualified call requires a real import, never a guessed module or
+        # another object's same-named method.
+    return None
+
+
+def _argument_bindings(call, positional, keywords):
+    """Actual expressions for named parameters, including keyword-only ones."""
+    positional = tuple(positional)
+    if isinstance(call.func, ast.Attribute) and positional[:1] in (("self",), ("cls",)):
+        positional = positional[1:]
+    bound = dict(zip(positional, call.args))
+    allowed = set(positional) | set(keywords)
+    for one in call.keywords:
+        if one.arg in allowed:
+            bound[one.arg] = one.value
+    return bound
+
+
+def _origin_values(origin):
+    """An immutable may-origin set; common singleton values remain strings."""
+    return origin if isinstance(origin, frozenset) else frozenset(() if origin is None else (origin,))
+
+
+def _join_origins(origins):
+    values = frozenset(value for origin in origins for value in _origin_values(origin))
+    return next(iter(values)) if len(values) == 1 else values or None
+
+
+def _extend_origin(origin, suffix):
+    return _join_origins(value + suffix for value in _origin_values(origin))
+
+
+def _scope_nodes(node):
+    """Walk this body's syntax, without entering another lexical body."""
+    pending = list(reversed(node.body))
+    while pending:
+        piece = pending.pop()
+        yield piece
+        if not isinstance(piece, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda)):
+            pending.extend(reversed(list(ast.iter_child_nodes(piece))))
