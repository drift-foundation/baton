+            names.add(piece.name)
+
+        visit_AsyncFunctionDef = visit_FunctionDef
+        visit_ClassDef = visit_FunctionDef
+
+        def visit_Lambda(self, piece):
+            pass
+
+        def visit_ListComp(self, piece):
