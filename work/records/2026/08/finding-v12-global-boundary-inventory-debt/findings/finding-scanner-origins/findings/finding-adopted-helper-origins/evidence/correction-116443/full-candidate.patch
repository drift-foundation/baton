+    if isinstance(called, ast.Name):
+        if imports.get(("shadow", site, called.id)):
+            return None
+        return imported(called.id) or f"{module}:{called.id}"
+    if isinstance(called, ast.Attribute) and isinstance(called.value, ast.Name):
+        if imports.get(("shadow", site, called.value.id)):
+            return None
+        if called.value.id in ("self", "cls") and "." in lexical:
+            return f"{module}:{lexical.rsplit('.', 1)[0]}.{called.attr}"
+        target = imported(called.value.id)
+        if target is not None and target.endswith(":"):
+            return target + called.attr
+        # A qualified call requires a real import, never a guessed module or
+        # another object's same-named method.
+    return None
