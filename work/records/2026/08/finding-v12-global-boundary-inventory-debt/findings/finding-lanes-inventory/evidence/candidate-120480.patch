+class LanesHaveCompleteReceivingCoverage(BoundaryCase):
+    def test_lane_entries_have_exactly_one_owner_and_no_unaccounted_calls(self):
+        entries = receiving_entries()
+        own = EveryReceivingEntryHasOneOwner()
+        lane_entries = {e for e in entries if e[1].startswith("lanes.py:")}
+        self.assertGreater(len(lane_entries), 20)
+        for entry in sorted(lane_entries):
+            with self.subTest(entry=entry):
+                self.assertIsNotNone(own.owner_of(entry)[0])
+                self.assertEqual(sum((bool(layer_labels(entry)), entry in DELEGATED, entry in STATED_OWNERS,
+                                      entry[0] == "caller" and entry[2] in CONSTRUCTED_BY)), 1)
+        records = boundary_occurrences()
+        claimed = _boundary_claims(records, entries, DELEGATED)
+        _, residual = _account_boundary_calls(records, claimed, NOT_AN_ENTRY)
+        self.assertEqual(sorted({(r.site, r.kind, r.label) for r in residual if r.site.startswith("lanes.py:")}), [])
+        expected = {(f"lanes.py:{site}", kind, label) for site, kind, label in (
+            ("_occupy_lane", "identity", "a runtime attempt id"),
+            ("_release_lane", "identity", "a runtime attempt id"),
+            ("_occupy_lane", "text", "a lane occupancy reason"),
+            ("_release_lane", "text", "a lane release reason"))}
+        self.assertEqual({e for e in NOT_AN_ENTRY if e[0].startswith("lanes.py:")}, expected)
+        self.assertTrue(expected <= {(r.site, r.kind, r.label) for r in records})
+
+    def test_lane_probe_catalog_matches_every_actual_owner(self):
+        case = EveryProbeProvesItArrived()
+        try:
+            case.setUp()
+            wanted = {pair for pair in case.expected() if pair[0][1].startswith("lanes.py:")}
+            declared = {pair for pair in case.all_probes() if pair[0][1].startswith("lanes.py:")}
+            self.assertEqual(sorted(wanted - declared), [])
+            self.assertEqual(sorted(declared - wanted), [])
+            self.assertEqual(len(declared), 24)
+            self.assertEqual(sum(pair[0][0] == "adopted" for pair in declared), 17)
+            self.assertEqual(sum(pair[0][0] == "caller" for pair in declared), 7)
+        finally:
+            case.doCleanups()
+
+    def test_all_lane_probes_reach_their_named_boundary(self):
+        case = EveryProbeProvesItArrived()
+        try:
+            case.setUp()
+            keys = sorted(case.lane_probes())
+        finally:
+            case.doCleanups()
+        for key in keys:
+            with self.subTest(entry=key):
+                try:
+                    case.setUp()
+                    full, probe = case.lane_probes()[key]
+                    self.assertIn(key[1], full)
+                    case.refusing(full, probe)
+                finally:
+                    case.doCleanups()
