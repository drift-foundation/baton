+    def test_private_lane_checks_refuse_before_sql(self):
+        class NoSql:
+            def execute(self, *args):
+                raise AssertionError("private check reached SQL")
+        reference = {"authority_uuid": UUID, "work_id": WORK, "principal": PRINCIPAL, "effective_scope": SCOPE}
+        for name, reason_key, reason_label in (
+                ("_occupy_lane", "reason", "a lane occupancy reason"),
+                ("_release_lane", "why", "a lane release reason")):
+            for bad_id in (True, False):
+                with self.subTest(writer=name, bad_id=bad_id):
+                    operands = {"attempt_id": SURROGATE if bad_id else "attempt-1",
+                                "reference": reference, reason_key: "local reason" if bad_id else SURROGATE}
+                    args = (NoSql(), NOW) if name == "_occupy_lane" else (NoSql(),)
+                    self.refusing("a runtime attempt id" if bad_id else reason_label,
+                                  lambda: getattr(lanes, name)(*args, **operands))
