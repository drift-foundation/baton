+    def test_private_lane_writer_provenance(self):
+        functions = {site: node for source, tree in _sources() for site, node in _functions(tree, source.name)}
+        calls = {(site, call.func.attr): call for site, node in functions.items() for call in ast.walk(node)
+                 if isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute) and call.func.attr in ("_occupy_lane", "_release_lane")}
+        self.assertEqual(set(calls), {("attempts.py:request_runtime_start", "_occupy_lane"),
+                                     ("intake.py:_settle", "_release_lane"),
+                                     ("intake.py:_settle_recordless_cleanup", "_release_lane")})
+        self.assertEqual(sum(1 for node in functions.values() for call in ast.walk(node)
+                             if isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute) and call.func.attr in ("_occupy_lane", "_release_lane")), 3)
+        for (site, writer), call in calls.items():
+            self.assertEqual(ast.unparse(next(k.value for k in call.keywords if k.arg == "attempt_id")), "attempt_id")
+            node = functions[site]
+            if writer == "_occupy_lane":
+                earlier = [s.value for s in node.body if isinstance(s, ast.Assign) and isinstance(s.value, ast.Call)
+                           and isinstance(s.value.func, ast.Name) and s.value.func.id == "_require_attempt"]
+                self.assertEqual([ast.unparse(c) for c in earlier], ["_require_attempt(store, attempt_id)"])
+                self.assertLess(earlier[0].lineno, call.lineno)
+                composed = [statement.value for statement in node.body if isinstance(statement, ast.Assign)
+                            and any(isinstance(target, ast.Name) and target.id == "operation_id" for target in statement.targets)]
+                self.assertEqual([ast.unparse(value) for value in composed], ["_start_operation_id(attempt)"])
+                reason = next(k.value for k in call.keywords if k.arg == "reason")
+                self.assertEqual(ast.dump(reason), ast.dump(ast.parse('f"execution requested under {operation_id}"', mode="eval").body))
+            else:
+                earlier = [s.value for s in node.body if isinstance(s, ast.Expr) and isinstance(s.value, ast.Call)
+                           and isinstance(s.value.func, ast.Name) and s.value.func.id == "observe" and s.lineno < call.lineno]
+                self.assertTrue(earlier)
+                self.assertTrue(all(any(k.arg == "attempt_id" and ast.unparse(k.value) == "attempt_id" for k in c.keywords) for c in earlier))
+                why = next(k.value for k in call.keywords if k.arg == "why")
+                expected = 'f"cleanup settled {ending}"' if site == "intake.py:_settle" else "why"
+                self.assertEqual(ast.dump(why), ast.dump(ast.parse(expected, mode="eval").body))
+        endings = [statement.value for statement in functions["intake.py:_settle"].body if isinstance(statement, ast.Assign)
+                   and any(isinstance(target, ast.Name) and target.id == "ending" for target in statement.targets)]
+        self.assertEqual(len(endings), 1)
+        self.assertIsInstance(endings[0], ast.IfExp)
+        self.assertEqual((endings[0].body.value, endings[0].orelse.value), ("retained", "complete"))
+        # Pin the forwarding chain to the real validator, not just a lookup name.
+        for site, target in (("attempts.py:_require_attempt", "_attempt_row"),
+                             ("attempts.py:_decide", "_require_attempt"),
+                             ("attempts.py:observe", "_decide")):
+            found = [c for c in ast.walk(functions[site]) if isinstance(c, ast.Call) and isinstance(c.func, ast.Name) and c.func.id == target]
+            self.assertEqual(len(found), 1)
+            self.assertEqual(ast.unparse(found[0].args[1]), "attempt_id")
+        self.assertIn(("identity", "a runtime attempt id", "caller:attempt_id"), owning_validators()["attempts.py:_attempt_row"])
+        recordless = [(site, c) for site, node in functions.items() for c in ast.walk(node)
+                      if isinstance(c, ast.Call) and isinstance(c.func, ast.Name) and c.func.id == "_settle_recordless_cleanup"]
+        self.assertEqual(len(recordless), 3)
+        self.assertEqual({site: next(k.value.value for k in c.keywords if k.arg == "why") for site, c in recordless},
+                         {"intake.py:authorize_failed_start_cleanup": "failed-start cleanup settled retained",
+                          "intake.py:authorize_refused_session_cleanup": "refused-session cleanup settled retained",
+                          "intake.py:abandon_attempt": "abandonment cleanup settled retained"})
+
+    def test_public_start_and_cleanup_supply_owned_lane_values(self):
+        from .test_runtime_lane import LaneCase
+        fixture = LaneCase()
+        self.addCleanup(fixture.doCleanups)
+        fixture.setUp()
+        events = []
+        identity, occupy, release = boundaries.identity, lanes._occupy_lane, lanes._release_lane
+
+        def owning(value, label, *args, **kwargs):
+            result = identity(value, label, *args, **kwargs)
+            if label == "a runtime attempt id":
+                events.append(("owned", value))
+            return result
+
+        def writing(action, implementation):
+            def run(*args, **kwargs):
+                prior = [e for e in events if e[1] == kwargs["attempt_id"]]
+                self.assertTrue(prior)
+                self.assertEqual(prior[-1][0], "owned")
+                events.append((action, kwargs["attempt_id"]))
+                self.assertEqual(kwargs["reference"], fixture.reference(kwargs["attempt_id"]))
+                if action == "occupy":
+                    self.assertRegex(kwargs["reason"], r"\Aexecution requested under runtime.start:[0-9a-f]{64}\Z")
+                else:
+                    self.assertEqual(kwargs["why"], "cleanup settled complete")
+                return implementation(*args, **kwargs)
+            return run
+
+        with patch.object(boundaries, "identity", owning), patch.object(lanes, "_occupy_lane", writing("occupy", occupy)), patch.object(lanes, "_release_lane", writing("release", release)):
+            fixture.retained_ready("discard-after-intake")
+            self.assertEqual(len(fixture.lanes()), 1)
+            settled = fixture.cleanup_settled()
+            self.assertEqual(settled["cleanup"], "complete")
+            self.assertEqual(fixture.lanes(), [])
+        self.assertEqual([e[0] for e in events if e[0] != "owned"], ["occupy", "release"])
