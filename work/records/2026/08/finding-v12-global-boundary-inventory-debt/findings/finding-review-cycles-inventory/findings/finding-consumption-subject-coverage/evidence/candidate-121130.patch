+class ConsumptionEntriesReachTheirOwners(unittest.TestCase):
+    SITE = "review_cycles.py:consumption_subject"
+    SELECT = "SELECT writer_id FROM line_writers WHERE runtime_attempt_id = 'writer-attempt-1' AND assignment_generation = 1 AND state = 'active'"
+
+    def setUp(self):
+        self.case = EveryProbeProvesItArrived()
+        self.case.setUp()
+        self.addCleanup(self.case.doCleanups)
+
+    def test_envelope_member_and_callers_have_distinct_exact_owners(self):
+        entries = receiving_entries()
+        owner = EveryReceivingEntryHasOneOwner()
+        envelope = ("adopted", self.SITE, "line_writers")
+        member = ("adopted", self.SITE, "line_writers.writer_id")
+        self.assertIn(envelope, entries)
+        self.assertEqual(owner.owner_of(envelope), ("stated", STATED_OWNERS[envelope]))
+        self.assertEqual(WITNESSES[envelope], "test_consumption_requires_one_live_writer_before_delegating")
+        self.assertTrue(callable(getattr(StatedRules, WITNESSES[envelope])))
+        self.assertNotIn(envelope, DELEGATED)
+        self.assertIn(member, entries)
+        self.assertEqual(DELEGATED[member], ("review_cycles.py:writer_of", "caller:writer_id"))
+        self.assertEqual(owner.owner_of(member), ("delegated", ["a line writer identity"]))
+        self.assertNotIn(member, STATED_OWNERS)
+        for subject, label in (("attempt_id", "a runtime attempt identity"), ("generation", "an assignment generation")):
+            entry = ("caller", self.SITE, subject)
+            self.assertIn(entry, entries)
+            self.assertEqual(owner.owner_of(entry), ("layer", [label]))
+        self.assertNotIn(envelope, NO_PROBE)
+        self.assertNotIn(member, NO_PROBE)
+
