+class TheWriterKeyProbeReachesAdoption(unittest.TestCase):
+    def setUp(self):
+        self.case = EveryProbeProvesItArrived()
+        self.case.setUp()
+        self.addCleanup(self.case.doCleanups)
+
+    def stimulus(self):
+        return self.case.spoiling_review_row("writer_of", "line_writers", "writer_id")
+
+    def test_a_valid_writer_reaches_the_real_reader(self):
+        self.case.review_cycle_world()
+        original = self.case.store._connection.row_factory
+        self.assertEqual(review_cycles.writer_of(self.case.store, "writer-probe")["writer_id"], "writer-probe")
+        self.assertIs(self.case.store._connection.row_factory, original)
+
+    def test_malformed_returned_identity_preserves_the_key_and_restores_the_factory(self):
+        connection = self.case.store._connection
+        original = connection.row_factory
+        with self.assertRaises(ContractRefusal) as caught:
+            self.stimulus()()
+        self.assertEqual((caught.exception.category, caught.exception.code), ("integrity", "schema"))
+        self.assertIn("a persisted line writer's writer_id", caught.exception.message)
+        self.assertIs(connection.row_factory, original)
+        self.assertEqual(review_cycles.writer_of(self.case.store, "writer-probe")["writer_id"], "writer-probe")
+        self.assertIsNone(connection.execute("SELECT writer_id FROM line_writers WHERE writer_id = ''").fetchone())
+
+    def test_valid_returned_identity_restores_the_factory_after_success(self):
+        connection = self.case.store._connection
+        original = connection.row_factory
+        self.case.SPOILED = dict(self.case.SPOILED, identity="writer-probe")
+        self.stimulus()()
+        self.assertIs(connection.row_factory, original)
+        self.assertEqual(review_cycles.writer_of(self.case.store, "writer-probe")["writer_id"], "writer-probe")
+
+    def test_missing_row_keeps_precondition_refusal_and_restores_the_factory(self):
+        original_world = self.case.review_cycle_world
+
+        def missing_world():
+            original_world()
+            self.case.corrupt("DELETE FROM line_writers WHERE writer_id = ?", "writer-probe")
+
+        self.case.review_cycle_world = missing_world
+        connection = self.case.store._connection
+        original = connection.row_factory
+        with self.assertRaises(ContractRefusal) as caught:
+            self.stimulus()()
+        self.assertEqual((caught.exception.category, caught.exception.code), ("refused", "precondition"))
+        self.assertIn("no line writer", caught.exception.message)
+        self.assertIs(connection.row_factory, original)
+        self.assertIsNone(connection.execute("SELECT writer_id FROM line_writers WHERE writer_id = ?", ("writer-probe",)).fetchone())
+
+    def test_the_existing_probe_guard_accepts_only_the_adoption_refusal(self):
+        self.case.refusing("a persisted line writer", self.stimulus())
+
+    def test_the_catalog_keeps_the_exact_writer_pair_and_reaches_adoption(self):
+        entry = ("adopted", "review_cycles.py:writer_of", "line_writers.writer_id")
+        label = "a persisted line writer"
+        full, probe = self.case.all_probes()[(entry, label)]
+        self.assertEqual(full, label)
+        self.case.refusing(full, probe)
+
+    def test_the_existing_probe_guard_rejects_a_missing_row_refusal(self):
+        with self.assertRaisesRegex(AssertionError, "refused, but not at"):
+            self.case.refusing("a persisted line writer", lambda: review_cycles.writer_of(self.case.store, "absent-writer"))
+
