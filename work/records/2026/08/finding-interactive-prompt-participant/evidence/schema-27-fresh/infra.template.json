{
  "version": 1,
  "startTimeoutSeconds": 15,
  "stopTimeoutSeconds": 10,
  "contexts": [
    {
      "name": "prompt",
      "participant": "baton.prompt",
      "after": [
        "codex-app-server"
      ],
      "command": [
        "{{repository}}/tools/codex-event-bridge/bin/codex-event-bridge",
        "--start-thread",
        "--endpoint",
        "ws://127.0.0.1:4500",
        "--cwd",
        "{{workspace}}",
        "--baton",
        "{{release}}/bin/baton",
        "--baton-config",
        "{{home}}/baton.json",
        "--participant",
        "baton.prompt",
        "--role",
        "prompt"
      ],
      "requires": [
        "{{release}}/bin/baton",
        "{{home}}/baton.json"
      ],
      "timeoutSeconds": 180
    },
    {
      "name": "reviewer",
      "participant": "baton.codex",
      "after": [
        "codex-app-server"
      ],
      "command": [
        "{{repository}}/tools/codex-event-bridge/bin/codex-event-bridge",
        "--start-thread",
        "--endpoint",
        "ws://127.0.0.1:4500",
        "--cwd",
        "{{workspace}}",
        "--baton",
        "{{release}}/bin/baton",
        "--baton-config",
        "{{home}}/baton.json",
        "--participant",
        "baton.codex",
        "--role",
        "rview"
      ],
      "requires": [
        "{{release}}/bin/baton",
        "{{home}}/baton.json"
      ],
      "timeoutSeconds": 180
    },
    {
      "name": "tuner",
      "participant": "baton.tuner",
      "after": [
        "codex-app-server"
      ],
      "command": [
        "{{repository}}/tools/codex-event-bridge/bin/codex-event-bridge",
        "--start-thread",
        "--endpoint",
        "ws://127.0.0.1:4500",
        "--cwd",
        "{{workspace}}",
        "--baton",
        "{{release}}/bin/baton",
        "--baton-config",
        "{{home}}/baton.json",
        "--participant",
        "baton.tuner",
        "--role",
        "tuner"
      ],
      "requires": [
        "{{release}}/bin/baton",
        "{{home}}/baton.json"
      ],
      "timeoutSeconds": 180
    }
  ],
  "services": [
    {
      "name": "codex-app-server",
      "command": [
        "{{codex}}",
        "app-server",
        "--listen",
        "ws://127.0.0.1:4500"
      ],
      "readiness": {
        "type": "http",
        "url": "http://127.0.0.1:4500/readyz",
        "expectedStatus": 200
      }
    },
    {
      "name": "codex-dispatcher",
      "command": [
        "{{repository}}/tools/codex-event-bridge/bin/codex-event-bridge",
        "--config",
        "{{render.dispatcher}}"
      ],
      "after": [
        "codex-app-server"
      ],
      "requires": [
        "{{home}}/codex-event-bridge.template.json"
      ],
      "readiness": {
        "type": "unix_socket",
        "path": "{{runtime}}/codex-events.sock",
        "request": {
          "control": "status"
        },
        "expect": {
          "ready": true
        }
      },
      "renders": [
        {
          "name": "dispatcher",
          "template": "{{home}}/codex-event-bridge.template.json"
        }
      ]
    },
    {
      "name": "codex-readiness",
      "participant": "baton.codex",
      "command": [
        "{{repository}}/tools/codex-event-bridge/bin/codex-baton-bridge",
        "--baton",
        "{{release}}/bin/baton",
        "--config",
        "{{home}}/baton.json",
        "--participant",
        "baton.codex",
        "--target",
        "baton-reviewer",
        "--socket",
        "{{runtime}}/codex-events.sock"
      ],
      "after": [
        "codex-dispatcher"
      ],
      "requires": [
        "{{release}}/bin/baton",
        "{{home}}/baton.json"
      ],
      "readiness": {
        "type": "process",
        "stableMilliseconds": 1000
      }
    },
    {
      "name": "codex-tuner-readiness",
      "participant": "baton.tuner",
      "command": [
        "{{repository}}/tools/codex-event-bridge/bin/codex-baton-bridge",
        "--baton",
        "{{release}}/bin/baton",
        "--config",
        "{{home}}/baton.json",
        "--participant",
        "baton.tuner",
        "--target",
        "baton-tuner",
        "--socket",
        "{{runtime}}/codex-events.sock"
      ],
      "after": [
        "codex-dispatcher"
      ],
      "requires": [
        "{{release}}/bin/baton",
        "{{home}}/baton.json"
      ],
      "readiness": {
        "type": "process",
        "stableMilliseconds": 1000
      }
    },
    {
      "name": "claude-acp",
      "participant": "baton.claude",
      "command": [
        "{{release}}/bin/acp-baton-bridge",
        "--config",
        "{{render.claude-acp}}"
      ],
      "after": [
        "codex-readiness",
        "codex-tuner-readiness"
      ],
      "requires": [
        "{{home}}/acp-claude.template.json"
      ],
      "readiness": {
        "type": "process",
        "stableMilliseconds": 1000
      },
      "renders": [
        {
          "name": "claude-acp",
          "template": "{{home}}/acp-claude.template.json"
        }
      ]
    },
    {
      "name": "gemini-acp",
      "participant": "baton.gemini",
      "command": [
        "{{release}}/bin/acp-baton-bridge",
        "--config",
        "{{render.gemini-acp}}"
      ],
      "after": [
        "codex-readiness",
        "codex-tuner-readiness"
      ],
      "requires": [
        "{{home}}/acp-gemini.template.json"
      ],
      "readiness": {
        "type": "process",
        "stableMilliseconds": 1000
      },
      "renders": [
        {
          "name": "gemini-acp",
          "template": "{{home}}/acp-gemini.template.json"
        }
      ]
    }
  ]
}
